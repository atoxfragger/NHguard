<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NHGuard — Inscription</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    /* Palette "poste de contrôle" — voile spatial profond, accents
       radar teal/bleu, ambre réservé aux signaux d'attention. */
    --void:      #05070a;
    --panel:     #0b1119;
    --grid-line: #0f2029;
    --bg0:       #05070a;
    --bg1:       #0b1119;
    --bg2:       #101a24;
    --border:    #1c2b36;
    --text1:     #eaf2f5;
    --text2:     #93a5b2;
    --text3:     #5c7080;
    --red:       #f8776b;
    --green:     #4ade80;
    --teal:      #2dd4bf;
    --blue:      #4f8ef7;
    --amber:     #f5a623;
    --red-bg:    rgba(248,119,107,.1);
    --font-mono:    'JetBrains Mono', monospace;
    --font-ui:      'Inter', sans-serif;
    --font-display: 'Space Grotesk', sans-serif;
  }

  html, body { height: 100%; background: var(--void); color: var(--text1); font-family: var(--font-ui); }
  body { overflow-x: hidden; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .001s !important; animation-iteration-count: 1 !important; }
  }

  /* ── Scène de fond : sol en grille + horizon + particules ─ */
  .scene {
    position: fixed; inset: 0; z-index: 0; overflow: hidden;
    background: radial-gradient(ellipse 80% 55% at 50% 28%, #0c1620 0%, var(--void) 68%);
  }
  .horizon {
    position: absolute; left: 0; right: 0; top: 30%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(45,212,191,.55), transparent);
    filter: blur(.5px);
  }
  .grid-floor {
    position: absolute; left: -60%; right: -60%; bottom: -6%; height: 62%;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 46px 46px;
    transform: perspective(600px) rotateX(78deg);
    transform-origin: bottom;
    -webkit-mask-image: linear-gradient(to top, black 15%, transparent 92%);
            mask-image: linear-gradient(to top, black 15%, transparent 92%);
    opacity: .8;
  }
  .radar-sweep {
    position: absolute; left: 50%; top: 30%; width: 1400px; height: 1400px;
    margin-left: -700px; margin-top: -20px;
    background: conic-gradient(from 0deg, rgba(45,212,191,.16), transparent 20%);
    border-radius: 50%;
    mix-blend-mode: screen;
    animation: sweep 9s linear infinite;
    opacity: .5;
  }
  @keyframes sweep { to { transform: rotate(360deg); } }

  .node { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: var(--teal); opacity: .5; animation: drift 7s ease-in-out infinite; }
  .node:nth-child(1) { top: 18%; left: 12%; animation-delay: 0s; }
  .node:nth-child(2) { top: 62%; left: 82%; animation-delay: 1.4s; background: var(--blue); }
  .node:nth-child(3) { top: 40%; left: 88%; animation-delay: 2.8s; }
  .node:nth-child(4) { top: 74%; left: 8%;  animation-delay: 4.2s; background: var(--blue); }
  .node:nth-child(5) { top: 12%; left: 70%; animation-delay: 5.6s; }
  @keyframes drift { 0%,100% { transform: translateY(0); opacity: .35; } 50% { transform: translateY(-10px); opacity: .8; } }

  /* ── Scène 3D : panneau qui s'incline au curseur ─────────── */
  .stage {
    position: relative; z-index: 1; min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 40px 20px; perspective: 1100px;
  }
  .tilt {
    transform-style: preserve-3d;
    transition: transform .25s ease-out;
    width: 100%; max-width: 400px;
  }

  /* ── Badge bouclier 3D : signature de la page ────────────── */
  .shield-3d {
    width: 62px; height: 62px; margin: 0 auto 22px;
    perspective: 500px; transform: translateZ(30px);
  }
  .shield-3d-inner {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d;
    animation: shieldSpin 11s linear infinite;
  }
  .shield-face {
    position: absolute; inset: 0;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
  }
  .shield-face.front {
    background: linear-gradient(135deg, var(--teal), var(--blue));
    transform: translateZ(9px);
  }
  .shield-face.back {
    background: var(--panel); border: 1px solid rgba(45,212,191,.5);
    transform: translateZ(-9px) rotateY(180deg);
  }
  .shield-ring {
    position: absolute; inset: -12px; border: 1px solid rgba(45,212,191,.28);
    border-radius: 50%; transform: rotateX(72deg);
    animation: ringSpin 6s linear infinite reverse;
  }
  @keyframes shieldSpin { to { transform: rotateY(360deg); } }
  @keyframes ringSpin { to { transform: rotateX(72deg) rotateZ(360deg); } }

  .status-caption {
    text-align: center; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 1.5px; color: var(--teal); opacity: .75;
    margin-bottom: 20px; text-transform: uppercase;
  }
  .status-caption .dot { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: var(--green); margin-right: 6px; box-shadow: 0 0 6px var(--green); }

  /* ── Carte / panneau ──────────────────────────────────────── */
  .card {
    position: relative;
    background: linear-gradient(180deg, rgba(16,26,36,.92), rgba(11,17,25,.96));
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 14px; padding: 30px 26px;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,.7), 0 0 0 1px rgba(45,212,191,.04);
    transform: translateZ(0);
  }
  /* repères d'angle façon HUD */
  .card::before, .card::after,
  .corner-br, .corner-bl {
    content: ''; position: absolute; width: 16px; height: 16px;
    border-color: rgba(45,212,191,.55); border-style: solid; border-width: 0;
    pointer-events: none;
  }
  .card::before { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
  .card::after  { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
  .corner-bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
  .corner-br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

  .head { text-align: center; margin-bottom: 22px; }
  .title {
    display: inline-block;
    font-family: var(--font-display); font-size: 22px; font-weight: 700;
    letter-spacing: .5px;
    background: linear-gradient(135deg, var(--teal), var(--blue));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .row { display: flex; gap: 10px; }
  .row .field { flex: 1; }

  .field { margin-bottom: 14px; }
  .field label {
    display: block; font-size: 10.5px; color: var(--text2); font-family: var(--font-mono);
    margin-bottom: 5px; text-transform: uppercase; letter-spacing: .6px;
  }
  .field input {
    width: 100%; background: var(--bg2); border: 1px solid var(--border);
    color: var(--text1); font-family: var(--font-ui); font-size: 13px;
    padding: 9px 11px; border-radius: 7px; outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .field input:focus { border-color: var(--teal); box-shadow: 0 0 0 3px rgba(45,212,191,.12); }
  .field input.invalid { border-color: var(--red); }

  .pw-wrap { position: relative; }
  .pw-wrap input { padding-right: 38px; }
  .pw-toggle {
    position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
    width: 28px; height: 28px; border: none; background: none; cursor: pointer;
    font-size: 14px; opacity: .55; transition: opacity .15s;
    display: flex; align-items: center; justify-content: center;
  }
  .pw-toggle:hover { opacity: .95; }

  .field-error { font-size: 11px; color: var(--red); margin-top: 5px; display: none; }
  .field-error.show { display: block; }

  .pw-rules { margin: -4px 0 14px; display: flex; flex-direction: column; gap: 4px; }
  .pw-rule {
    font-size: 11px; color: var(--text3); display: flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); transition: color .15s;
  }
  .pw-rule .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--text3); flex-shrink: 0; transition: background .15s, box-shadow .15s; }
  .pw-rule.ok { color: var(--green); }
  .pw-rule.ok .dot { background: var(--green); box-shadow: 0 0 5px var(--green); }

  .global-error {
    background: var(--red-bg); color: var(--red); font-size: 12px;
    padding: 8px 10px; border-radius: 6px; margin-bottom: 14px; display: none;
  }
  .global-error.show { display: block; }

  .submit-btn {
    width: 100%; padding: 11px; border-radius: 7px; border: none;
    background: linear-gradient(135deg, var(--teal), var(--blue));
    color: #04141a; font-weight: 700; font-size: 13px; font-family: var(--font-ui);
    cursor: pointer; transition: filter .15s, transform .1s; margin-top: 4px;
  }
  .submit-btn:hover { filter: brightness(1.08); }
  .submit-btn:active { transform: translateY(1px); }
  .submit-btn:disabled { opacity: .45; cursor: not-allowed; filter: none; }

  .footer-link { text-align: center; margin-top: 18px; font-size: 12px; color: var(--text3); }
  .footer-link a { color: var(--teal); text-decoration: none; }
  .footer-link a:hover { text-decoration: underline; }

  .divider { display: flex; align-items: center; gap: 10px; margin: 16px 0; font-size: 11px; color: var(--text3); font-family: var(--font-mono); }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  #google-btn-container { display: flex; justify-content: center; }
</style>
</head>
<body>

<div class="scene" aria-hidden="true">
  <div class="horizon"></div>
  <div class="grid-floor"></div>
  <div class="radar-sweep"></div>
  <div class="node"></div><div class="node"></div><div class="node"></div><div class="node"></div><div class="node"></div>
</div>

<div class="stage">
  <div class="tilt" id="tilt">

    <div class="shield-3d">
      <div class="shield-3d-inner">
        <div class="shield-face front"></div>
        <div class="shield-face back"></div>
        <div class="shield-ring"></div>
      </div>
    </div>

    <div class="card">
      <div class="corner-bl"></div><div class="corner-br"></div>
      <div class="head">
        <div class="title">NHGuard</div>
      </div>

      <div class="global-error" id="global-error"></div>

      <form id="register-form" autocomplete="off" novalidate>
        <div class="field">
          <label for="org-name">Nom de l'entreprise / organisation</label>
          <input id="org-name" type="text" autocomplete="organization" required>
          <div class="field-error" id="err-org-name">Champ requis</div>
        </div>

        <div class="row">
          <div class="field">
            <label for="first-name">Prénom</label>
            <input id="first-name" type="text" autocomplete="given-name" required>
            <div class="field-error" id="err-first-name">Champ requis</div>
          </div>
          <div class="field">
            <label for="last-name">Nom</label>
            <input id="last-name" type="text" autocomplete="family-name" required>
            <div class="field-error" id="err-last-name">Champ requis</div>
          </div>
        </div>

        <div class="field">
          <label for="email">Adresse e-mail</label>
          <input id="email" type="email" autocomplete="email" required>
          <div class="field-error" id="err-email">Adresse e-mail invalide</div>
        </div>

        <div class="field">
          <label for="password">Mot de passe</label>
          <div class="pw-wrap">
            <input id="password" type="password" autocomplete="new-password" required>
            <button type="button" class="pw-toggle" onclick="togglePw('password', this)" aria-label="Afficher le mot de passe">👁</button>
          </div>
        </div>

        <div class="field">
          <label for="password-confirm">Confirmer le mot de passe</label>
          <div class="pw-wrap">
            <input id="password-confirm" type="password" autocomplete="new-password" required>
            <button type="button" class="pw-toggle" onclick="togglePw('password-confirm', this)" aria-label="Afficher le mot de passe">👁</button>
          </div>
          <div class="field-error" id="err-password-confirm">Les mots de passe ne correspondent pas</div>
        </div>

        <div class="pw-rules">
          <div class="pw-rule" id="rule-length"><span class="dot"></span>8 caractères minimum</div>
          <div class="pw-rule" id="rule-upper"><span class="dot"></span>1 majuscule minimum</div>
        </div>

        <button type="submit" class="submit-btn" id="submit-btn">Créer le compte</button>
      </form>

      <div class="divider">ou</div>
      <div id="google-btn-container"></div>

      <div class="footer-link">Déjà inscrit ? <a href="edr_console.html">Se connecter</a></div>
    </div>
  </div>
</div>

<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
// Même origine que la page servie : fonctionne automatiquement en
// local, sur le réseau, ou via un tunnel public, sans rien modifier.
const API = window.location.origin;

// ⚠️ Remplacez par le Client ID OAuth créé dans Google Cloud Console.
const GOOGLE_CLIENT_ID = '652339744386-d8cjl24ahm1638i88sjd744kp66ni4db.apps.googleusercontent.com';

// ── Inclinaison 3D du panneau au mouvement de la souris ──────
(function () {
  const tilt = document.getElementById('tilt');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasHover = window.matchMedia('(hover: hover)').matches;
  if (reduceMotion || !hasHover) return;

  document.addEventListener('mousemove', (e) => {
    const relX = (e.clientX / window.innerWidth - 0.5) * 2;
    const relY = (e.clientY / window.innerHeight - 0.5) * 2;
    tilt.style.transform = `rotateY(${relX * 4}deg) rotateX(${-relY * 4}deg)`;
  });
  document.addEventListener('mouseleave', () => { tilt.style.transform = 'rotateY(0) rotateX(0)'; });
})();

window.addEventListener('load', () => {
  if (!window.google || GOOGLE_CLIENT_ID.startsWith('VOTRE_CLIENT_ID')) return;
  google.accounts.id.initialize({
    client_id: GOOGLE_CLIENT_ID,
    callback: async (response) => {
      const orgName = document.getElementById('org-name').value.trim();
      if (!orgName) {
        setFieldError('org-name', true);
        showGlobalError("Renseignez le nom de votre entreprise avant de continuer avec Google.");
        return;
      }
      try {
        const res = await fetch(`${API}/api/auth/google`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ credential: response.credential, organization: orgName })
        });
        const data = await res.json();
        if (res.ok) {
          if (data.agent_api_key) {
            showAgentKey(data.agent_api_key, orgName);
          } else {
            window.location.href = 'edr_console.html';
          }
        } else {
          showGlobalError(data.error || 'Connexion Google refusée');
        }
      } catch {
        showGlobalError('Serveur inaccessible — lance edr_server.py');
      }
    }
  });
  google.accounts.id.renderButton(
    document.getElementById('google-btn-container'),
    { theme: 'filled_black', size: 'large', shape: 'pill', width: 300, text: 'signup_with' }
  );
});

const form         = document.getElementById('register-form');
const pwInput      = document.getElementById('password');
const pwConfirm    = document.getElementById('password-confirm');
const ruleLen      = document.getElementById('rule-length');
const ruleUpper    = document.getElementById('rule-upper');
const globalErr    = document.getElementById('global-error');

// ── Afficher / masquer le mot de passe ───────────────────
function togglePw(inputId, btn) {
  const input = document.getElementById(inputId);
  const showing = input.type === 'text';
  input.type = showing ? 'password' : 'text';
  btn.textContent = showing ? '👁' : '🙈';
}

// ── Validation en temps réel du mot de passe ─────────────
pwInput.addEventListener('input', () => {
  const v = pwInput.value;
  ruleLen.classList.toggle('ok', v.length >= 8);
  ruleUpper.classList.toggle('ok', /[A-Z]/.test(v));
  if (pwConfirm.value) setFieldError('password-confirm', pwConfirm.value !== v);
});
pwConfirm.addEventListener('input', () => {
  setFieldError('password-confirm', pwConfirm.value.length > 0 && pwConfirm.value !== pwInput.value);
});

function setFieldError(id, show) {
  const input = document.getElementById(id);
  const err   = document.getElementById(`err-${id}`);
  input.classList.toggle('invalid', show);
  if (err) err.classList.toggle('show', show);
}

function showGlobalError(msg) {
  globalErr.textContent = msg;
  globalErr.classList.add('show');
}
function hideGlobalError() {
  globalErr.classList.remove('show');
}

// ── Soumission ────────────────────────────────────────────
form.addEventListener('submit', async (e) => {
  e.preventDefault();
  hideGlobalError();

  const orgName   = document.getElementById('org-name').value.trim();
  const firstName = document.getElementById('first-name').value.trim();
  const lastName  = document.getElementById('last-name').value.trim();
  const email     = document.getElementById('email').value.trim();
  const password  = pwInput.value;
  const confirm   = pwConfirm.value;

  let valid = true;

  setFieldError('org-name', orgName.length === 0);
  if (orgName.length === 0) valid = false;

  setFieldError('first-name', firstName.length === 0);
  if (firstName.length === 0) valid = false;

  setFieldError('last-name', lastName.length === 0);
  if (lastName.length === 0) valid = false;

  const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  setFieldError('email', !emailOk);
  if (!emailOk) valid = false;

  const passwordOk = password.length >= 8 && /[A-Z]/.test(password);
  if (!passwordOk) valid = false;

  const confirmOk = password === confirm && confirm.length > 0;
  setFieldError('password-confirm', !confirmOk);
  if (!confirmOk) valid = false;

  if (!valid) {
    if (!passwordOk) showGlobalError('Le mot de passe doit contenir au moins 8 caractères et 1 majuscule.');
    else if (!confirmOk) showGlobalError('Les deux mots de passe ne correspondent pas.');
    return;
  }

  const btn = document.getElementById('submit-btn');
  btn.disabled = true;
  btn.textContent = 'Création…';

  try {
    const res = await fetch(`${API}/api/register`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        organization: orgName,
        first_name: firstName,
        last_name: lastName,
        email,
        password
      })
    });
    const data = await res.json();

    if (res.ok) {
      showAgentKey(data.agent_api_key, data.organization);
    } else {
      showGlobalError(data.error || 'Erreur lors de la création du compte');
    }
  } catch (err) {
    showGlobalError('Serveur inaccessible — lance edr_server.py');
  }

  btn.disabled = false;
  btn.textContent = 'Créer le compte';
});

// Affiche une seule fois la clé API à utiliser pour configurer les agents
// de cette organisation, avant de rediriger vers la connexion.
function showAgentKey(key, orgName) {
  document.querySelector('.card').innerHTML = `
    <div class="corner-bl"></div><div class="corner-br"></div>
    <div class="head">
      <div class="title">Compte créé</div>
      <div class="sub">"${orgName}" · Clé API agent</div>
    </div>
    <div class="field">
      <label>Clé agent de votre organisation</label>
      <input type="text" value="${key}" readonly style="font-family:var(--font-mono);font-size:12px" id="agent-key-field">
    </div>
    <div style="font-size:11px;color:var(--text3);line-height:1.6;margin-bottom:16px">
      Copiez cette clé dans <code style="color:var(--text2)">AGENT_API_KEY</code> de <code style="color:var(--text2)">edr_agent.py</code>
      sur chaque machine à surveiller. Elle ne sera plus jamais affichée en clair après cet écran
      (vous pourrez la régénérer depuis le dashboard si besoin, mais pas la revoir telle quelle).
    </div>
    <button class="submit-btn" onclick="navigator.clipboard.writeText('${key}')" style="margin-bottom:8px">Copier la clé</button>
    <button class="submit-btn" style="background:transparent;border:1px solid var(--border);color:var(--text1)" onclick="window.location.href='edr_console.html'">J'ai copié la clé, continuer</button>
  `;
}
</script>
</body>
</html>
