# Copiez ce fichier en ".env" (jamais commité, voir .gitignore) et
# renseignez vos vraies valeurs — ou définissez ces variables au niveau
# du système/service en production (le .env n'est qu'un confort local).
#
# Voir edr_server.py pour comment obtenir un "mot de passe d'application"
# Gmail : https://myaccount.google.com/apppasswords

NHGUARD_SMTP_HOST=smtp.gmail.com
NHGUARD_SMTP_PORT=587
NHGUARD_SMTP_USER=votre-adresse@gmail.com
NHGUARD_SMTP_PASSWORD=votre-mot-de-passe-application
NHGUARD_SMTP_FROM_NAME=NHGuard
