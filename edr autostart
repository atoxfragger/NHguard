@echo off
REM ──────────────────────────────────────────────────────────
REM install_autostart.bat — fait démarrer edr_agent.py
REM automatiquement à chaque connexion Windows, sans fenêtre
REM de terminal visible (via pythonw.exe).
REM
REM À lancer UNE SEULE FOIS, depuis le dossier contenant
REM edr_agent.py. Double-cliquez dessus.
REM ──────────────────────────────────────────────────────────

setlocal

echo Recherche de pythonw.exe...
for /f "delims=" %%i in ('where pythonw') do set PYTHONW=%%i

if "%PYTHONW%"=="" (
    echo.
    echo ERREUR : pythonw.exe introuvable. Verifiez que Python est installe
    echo et accessible dans le PATH ^(python --version doit fonctionner^).
    pause
    exit /b 1
)

set SCRIPT_DIR=%~dp0
set SCRIPT_PATH=%SCRIPT_DIR%edr_agent.py

if not exist "%SCRIPT_PATH%" (
    echo.
    echo ERREUR : edr_agent.py introuvable dans %SCRIPT_DIR%
    echo Placez ce fichier .bat dans le meme dossier que edr_agent.py.
    pause
    exit /b 1
)

echo Python trouve : %PYTHONW%
echo Script agent  : %SCRIPT_PATH%
echo.
echo Creation de la tache planifiee "EDRAgent"...

schtasks /create /tn "EDRAgent" /tr "\"%PYTHONW%\" \"%SCRIPT_PATH%\"" /sc onlogon /rl highest /f

if %errorlevel% neq 0 (
    echo.
    echo ERREUR lors de la creation de la tache. Essayez de lancer ce
    echo fichier .bat en tant qu'administrateur ^(clic droit -^> Executer
    echo en tant qu'administrateur^).
    pause
    exit /b 1
)

echo.
echo ──────────────────────────────────────────────
echo Termine ! L'agent EDR demarrera desormais
echo automatiquement a chaque connexion Windows.
echo.
echo Vous pouvez le lancer des maintenant sans attendre
echo la prochaine connexion :
schtasks /run /tn "EDRAgent"
echo.
echo Pour verifier qu'il tourne : ouvrez le Gestionnaire des
echo taches -^> onglet Details -^> cherchez "pythonw.exe"
echo.
echo Pour desinstaller le demarrage automatique plus tard,
echo utilisez uninstall_autostart.bat
echo ──────────────────────────────────────────────
pause
