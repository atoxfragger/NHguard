SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM_NAME = "NHGuard"


def send_verification_email(to_email: str, code: str):
    msg = MIMEText(
        f"Votre code de vérification NHGuard est : {code}\n\n"
        f"Il expire dans 5 minutes. Si vous n'êtes pas à l'origine de cette "
        f"demande de connexion, ignorez cet e-mail."
    )
    msg["Subject"] = f"{code} — Code de vérification NHGuard"
    msg["From"] = f"{SMTP_FROM_NAME} <{SMTP_USER}>"
    msg["To"] = to_email

    with smtplib.SMTP(SMTP_HOST, SMTP_PORT) as server:
        server.starttls()
        server.login(SMTP_USER, SMTP_PASSWORD)
        server.sendmail(SMTP_USER, [to_email], msg.as_string())


PENDING_2FA = {}   # temp_token -> {"email": ..., "org_id": ..., "code": ..., "expires": ...}
SESSIONS = {}       # session_token -> {"email": ..., "org_id": ..., "expires": ...}

TEMP_TOKEN_TTL    = 5 * 60
SESSION_TOKEN_TTL = 8 * 60 * 60


def _cleanup_expired():
    now = time.time()
    for store in (PENDING_2FA, SESSIONS):
        for token in [t for t, v in store.items() if v["expires"] < now]:
            del store[token]


def _extract_token():
    auth = request.headers.get("Authorization", "")
    return auth.split("Bearer ")[-1] if auth.startswith("Bearer ") else None


def _start_2fa(email, org_id):
    """Génère un code à 6 chiffres, l'envoie par email, et renvoie le temp_token."""
    code = f"{random.randint(0, 999999):06d}"
    temp_token = secrets.token_urlsafe(32)
    PENDING_2FA[temp_token] = {
        "email": email, "org_id": org_id, "code": code,
        "expires": time.time() + TEMP_TOKEN_TTL,
    }
    try:
        send_verification_email(email, code)
    except Exception as e:
        print(f"[!] Échec d'envoi de l'email à {email} : {e}")
    return temp_token


def require_auth(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        _cleanup_expired()
        token = _extract_token()
        session = SESSIONS.get(token)
        if not session or session["expires"] < time.time():
            return jsonify({"error": "Non authentifié"}), 401
        request.org_id = session["org_id"]
        request.user_email = session["email"]
        return f(*args, **kwargs)
    return wrapper


def require_agent_key(f):
    @wraps(f)
    def wrapper(*args, **kwargs):
        key = request.headers.get("X-Agent-Key")
        org = db_users.get_organization_by_agent_key(key) if key else None
        if not org:
            return jsonify({"error": "Clé agent invalide"}), 401
        request.org_id = org["id"]
        return f(*args, **kwargs)
    return wrapper


