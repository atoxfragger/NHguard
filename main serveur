@app.route("/api/login", methods=["POST"])
def login():
    _cleanup_expired()
    data = request.get_json(force=True) or {}
    email    = data.get("username", "").strip().lower()
    password = data.get("password", "")

    user = db_users.get_user_by_email(email)
    dummy_hash = generate_password_hash("dummy")
    stored_hash = user["password_hash"] if (user and user["password_hash"]) else dummy_hash
    valid = check_password_hash(stored_hash, password)

    if not user or not user["password_hash"] or not valid:
        return jsonify({"error": "Identifiants invalides"}), 401

    temp_token = _start_2fa(email, user["org_id"])
    return jsonify({"requires_2fa": True, "temp_token": temp_token})


@app.route("/api/verify-2fa", methods=["POST"])
def verify_2fa():
    _cleanup_expired()
    data = request.get_json(force=True) or {}
    temp_token = data.get("temp_token", "")
    code = data.get("code", "").strip()

    pending = PENDING_2FA.get(temp_token)
    if not pending:
        return jsonify({"error": "Session expirée, recommence la connexion"}), 401

    if code != pending["code"]:
        return jsonify({"error": "Code invalide"}), 401

    del PENDING_2FA[temp_token]
    session_token = secrets.token_urlsafe(32)
    SESSIONS[session_token] = {
        "email": pending["email"], "org_id": pending["org_id"],
        "expires": time.time() + SESSION_TOKEN_TTL,
    }
    return jsonify({"session_token": session_token})


@app.route("/api/resend-2fa", methods=["POST"])
def resend_2fa():
    """Permet de renvoyer un nouveau code si l'email n'est pas arrivé."""
    _cleanup_expired()
    data = request.get_json(force=True) or {}
    old_temp_token = data.get("temp_token", "")
    pending = PENDING_2FA.get(old_temp_token)
    if not pending:
        return jsonify({"error": "Session expirée, recommence la connexion"}), 401
    del PENDING_2FA[old_temp_token]
    new_temp_token = _start_2fa(pending["email"], pending["org_id"])
    return jsonify({"temp_token": new_temp_token})


