@app.route("/api/iocs", methods=["GET"])
@require_auth
def list_iocs():
    return jsonify(db_data.get_iocs(request.org_id))


@app.route("/api/iocs", methods=["POST"])
@require_auth
def add_ioc():
    data = request.get_json(force=True) or {}
    ioc_type = data.get("type")
    value = data.get("value", "").strip()
    if ioc_type not in ("hash", "ip", "cmdline_pattern") or not value:
        return jsonify({"error": "type (hash/ip/cmdline_pattern) et value requis"}), 400
    ioc_id = db_data.create_ioc(
        request.org_id, ioc_type, value,
        severity=data.get("severity", "high"), description=data.get("description", ""),
    )
    return jsonify({"success": True, "id": ioc_id}), 201


@app.route("/api/iocs/<ioc_id>", methods=["DELETE"])
@require_auth
def remove_ioc(ioc_id):
    db_data.delete_ioc(request.org_id, ioc_id)
    return jsonify({"success": True})


