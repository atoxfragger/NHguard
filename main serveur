@app.route("/api/agents/process-events", methods=["POST"])
@require_agent_key
def agent_process_events():
    """Un agent envoie la chaîne de processus (parent → enfant → fichier/réseau)
    entourant une détection, pour reconstituer la Process Timeline dans le dashboard."""
    data = request.get_json(force=True) or {}
    alert_id = data.get("alert_id")
    events = data.get("events", [])
    if not alert_id or not events:
        return jsonify({"error": "alert_id et events requis"}), 400

    for ev in events:
        db_data.create_process_event(
            org_id=request.org_id,
            agent_id=data.get("agent_id", ""),
            alert_id=alert_id,
            event_type=ev.get("event_type", "process"),
            pid=ev.get("pid"),
            parent_pid=ev.get("parent_pid"),
            process_name=ev.get("process_name"),
            parent_name=ev.get("parent_name"),
            detail=ev.get("detail"),
        )

    _run_behavior_correlation(request.org_id, data.get("agent_id", ""))

    return jsonify({"success": True, "count": len(events)}), 201


