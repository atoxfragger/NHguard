@app.route("/api/agents/commands/<command_id>/result", methods=["POST"])
@require_agent_key
def agent_command_result(command_id):
    """L'agent rapporte le résultat d'une commande exécutée."""
    data = request.get_json(force=True) or {}
    status = data.get("status", "failed")
    if status not in ("done", "failed"):
        return jsonify({"error": "status doit être done/failed"}), 400

    command = db_data.get_command(request.org_id, command_id)
    db_data.complete_command(request.org_id, command_id, status, data.get("result", ""))

    # Répercute isolate/unisolate sur le statut affiché de l'agent
    if command and status == "done":
        if command["action"] == "isolate":
            db_data.set_agent_isolated(request.org_id, command["agent_id"], True)
        elif command["action"] == "unisolate":
            db_data.set_agent_isolated(request.org_id, command["agent_id"], False)

    return jsonify({"success": True})


