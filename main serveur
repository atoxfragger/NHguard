def _run_behavior_correlation(org_id, agent_id):
    """Point d'entrée UNIQUE de la corrélation comportementale — voir
    behaviour_engine.py : Raw Events -> Temporal Correlator -> Behaviour
    Chains -> Risk Engine. Avant, agent_alert() et agent_process_events()
    appelaient chacun leur propre moteur de corrélation indépendamment
    (behaviour_engine sur l'historique d'alertes, temporal_correlator sur
    les process_events), produisant deux catégories d'alerte séparées
    ("comportemental" / "chaine_temporelle") qui ne se recoupaient jamais.
    Les deux routes appellent maintenant CETTE fonction : les chaînes
    temporelles sont une ENTRÉE du Behaviour Engine, pas un moteur
    concurrent — une seule alerte de synthèse en résulte, jamais deux."""
    if not agent_id or db_data.has_recent_alert_of_category(
        org_id, agent_id, "comportemental", behaviour_engine.CORRELATION_COOLDOWN_MINUTES
    ):
        return

    recent_alerts = db_data.get_recent_alerts_for_agent(
        org_id, agent_id, behaviour_engine.CORRELATION_WINDOW_MINUTES
    )
    recent_events = db_data.get_recent_process_events_for_agent(
        org_id, agent_id, temporal_correlator.MAX_WINDOW_MINUTES
    )
    temporal_chains = temporal_correlator.correlate(recent_events)

    verdict = behaviour_engine.evaluate(recent_alerts, temporal_chains=temporal_chains)
    if verdict:
        db_data.create_alert(
            org_id=org_id,
            title=verdict["title"], description=verdict["description"],
            severity=verdict["severity"], category="comportemental",
            agent_id=agent_id, score=verdict["score"],
            score_breakdown=None, score_details=verdict["details"],
            confidence=verdict["confidence"], is_correlation=True,
        )


@app.route("/api/agents/alert", methods=["POST"])
@require_agent_key
def agent_alert():
    data = request.get_json(force=True) or {}
    required = ["title", "severity", "agent_id"]
    if not all(data.get(k) for k in required):
        return jsonify({"error": "Champs requis manquants : title, severity, agent_id"}), 400
    if data["severity"] not in ("critical", "high", "medium", "low"):
        return jsonify({"error": "severity doit être critical/high/medium/low"}), 400

    signals = data.get("signals")
    if signals:
        # Source de vérité : le Risk Engine calcule score, sévérité,
        # confiance et threat/impact à partir des signaux factuels envoyés
        # par l'agent — la "severity" suggérée par l'agent (ci-dessus)
        # n'est qu'un repli si jamais aucun signal n'est fourni (ancien
        # agent, appel de test, etc.).
        risk = risk_engine.compute_risk(signals)
        score, breakdown, severity, details = risk["score"], risk["breakdown"], risk["severity"], risk["details"]
        confidence, threat_score, impact_score = risk["confidence"], risk["threat_score"], risk["impact_score"]
    else:
        score, breakdown, severity, details = None, None, data["severity"], None
        confidence, threat_score, impact_score = None, None, None

    alert_id = db_data.create_alert(
        org_id=request.org_id,
        title=data["title"], description=data.get("description", ""),
        severity=severity, category=data.get("category", "autre"),
        agent_id=data["agent_id"], score=score, score_breakdown=breakdown,
        score_details=details, confidence=confidence,
        threat_score=threat_score, impact_score=impact_score,
    )

    _run_behavior_correlation(request.org_id, data["agent_id"])

    return jsonify({"success": True, "id": alert_id, "score": score, "severity": severity}), 201


