@app.route("/api/register", methods=["POST"])
def register():
    data = request.get_json(force=True) or {}
    org_name   = data.get("organization", "").strip()
    first_name = data.get("first_name", "").strip()
    last_name  = data.get("last_name", "").strip()
    email      = data.get("email", "").strip().lower()
    password   = data.get("password", "")

    if not org_name:
        return jsonify({"error": "Nom d'entreprise / organisation requis"}), 400
    if not first_name or not last_name:
        return jsonify({"error": "Nom et prénom requis"}), 400
    if "@" not in email or "." not in email.split("@")[-1]:
        return jsonify({"error": "Adresse e-mail invalide"}), 400
    if len(password) < 8 or not any(c.isupper() for c in password):
        return jsonify({"error": "Le mot de passe doit contenir au moins 8 caractères et 1 majuscule"}), 400
    if db_users.user_exists(email):
        return jsonify({"error": "Un compte existe déjà avec cette adresse"}), 409

    org = db_users.create_organization(org_name)
    db_users.create_user(
        org_id=org["id"], email=email, first_name=first_name, last_name=last_name,
        password_hash=generate_password_hash(password),
        role="admin", google_account=False,
    )
    return jsonify({
        "success": True, "email": email, "organization": org_name,
        "agent_api_key": org["agent_api_key"],
    }), 201


@app.route("/api/auth/google", methods=["POST"])
def auth_google():
    _cleanup_expired()
    data = request.get_json(force=True) or {}
    credential = data.get("credential", "")
    org_name = data.get("organization", "").strip()

    try:
        payload = google_id_token.verify_oauth2_token(
            credential, google_requests.Request(), GOOGLE_CLIENT_ID
        )
    except ValueError:
        return jsonify({"error": "Jeton Google invalide"}), 401

    if not payload.get("email_verified", False):
        return jsonify({"error": "Adresse e-mail Google non vérifiée"}), 401

    email = payload["email"].lower()
    first_name = payload.get("given_name", "")
    last_name  = payload.get("family_name", "")

    user = db_users.get_user_by_email(email)
    new_account = user is None

    if new_account:
        if not org_name:
            return jsonify({"error": "Nom d'organisation requis pour un premier login Google"}), 400
        org = db_users.create_organization(org_name)
        user = db_users.create_user(
            org_id=org["id"], email=email, first_name=first_name, last_name=last_name,
            password_hash=None, role="admin", google_account=True,
        )

    temp_token = _start_2fa(email, user["org_id"])
    response = {"email": email, "temp_token": temp_token}
    if new_account:
        response["agent_api_key"] = db_users.get_organization(user["org_id"])["agent_api_key"]
    return jsonify(response)


