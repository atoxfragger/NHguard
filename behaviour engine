"""
behaviour_engine.py — Corrélation comportementale multi-alertes pour NHGuard.

Le Risk Engine (risk_engine.py) évalue CHAQUE alerte isolément. Le
Behaviour Engine regarde, lui, la SUITE des alertes d'UNE MÊME machine
dans une fenêtre de temps glissante, pour détecter un enchaînement qui,
alerte par alerte, peut sembler bénin ou de sévérité modérée, mais qui,
mis bout à bout, correspond à une chaîne d'attaque réelle (ex : exécution
d'un LOLBin, puis dépôt de persistance, puis connexion réseau suspecte —
trois alertes "medium" qui, ensemble, valent une alerte "critical").

Principe (inspiré de MITRE ATT&CK, simplifié à l'échelle du produit) :
  - chaque alerte est rattachée à une ou plusieurs "tactiques" à partir
    de son score_breakdown (Risk Engine, source de vérité) ou, à défaut,
    de sa catégorie métier (repli pour agents anciens / alertes de test)
  - une "chaîne d'attaque" est détectée quand une séquence de tactiques
    connue apparaît, dans l'ordre, parmi les alertes de la fenêtre
  - un "comportement multi-tactiques" est détecté quand suffisamment de
    tactiques DISTINCTES apparaissent, même sans motif connu précis
  - une "rafale" (beaucoup d'alertes en peu de temps) est un signal à
    part, indépendant des tactiques en jeu — souvent le signe d'une
    attaque automatisée/scriptée ou d'un outil bruyant

── Hiérarchie du pipeline (et non deux moteurs parallèles) ──
    Raw Events (process_events) → Temporal Correlator → Behaviour Chains → Risk Engine
temporal_correlator.py travaille sur les évènements de processus bruts
(pid/parent_pid) et prouve une continuité STRUCTURELLE (même arbre de
processus observé sur plusieurs détections). C'est une preuve plus forte
qu'une simple coïncidence temporelle entre catégories de score. Plutôt
que de laisser le Temporal Correlator publier sa propre alerte
indépendante (ancienne conception : deux moteurs de corrélation
produisant chacun leur vision du "comportement", jamais recroisées), ses
chaînes détectées sont maintenant une ENTRÉE de ce module (paramètre
`temporal_chains` de evaluate()) : le Behaviour Engine est le point de
synthèse UNIQUE qui combine corrélation d'alertes (ce module) et
corrélation d'évènements (Temporal Correlator) en un seul verdict, avant
de le transmettre au Risk Engine (réutilisation de THRESHOLDS/gating).

Ce module ne DÉCIDE PAS quand s'exécuter ni comment persister son
verdict (voir edr_server.py, seul point d'orchestration : il assemble
alertes récentes + chaînes temporelles puis appelle evaluate() ici, avant
de créer — ou non — une alerte de catégorie "comportemental"). Il reste
une fonction pure, sans effet de bord, testable indépendamment du
serveur — même logique de conception que risk_engine.py et
process_scoring.py, et volontairement dépourvu de dépendances externes.
"""

from datetime import datetime, timedelta

import risk_engine

# ──────────────────────────────────────────────────────────
# Fenêtres de temps et seuils — regroupés ici pour rester la seule source
# de vérité (modifiable sans toucher à la logique de corrélation).
# ──────────────────────────────────────────────────────────

# Au-delà de cette fenêtre, deux alertes ne sont plus considérées comme
# faisant partie du même épisode d'attaque.
CORRELATION_WINDOW_MINUTES = 30

# Nombre d'alertes dans une fenêtre courte pour parler de "rafale".
BURST_ALERT_COUNT = 5
BURST_WINDOW_MINUTES = 5

# Nombre minimum de tactiques distinctes pour signaler un comportement
# multi-tactiques, même en l'absence de motif connu précis.
MIN_TACTICS_FOR_CHAIN = 3

# Ne pas re-déclencher une alerte comportementale pour la même machine
# plus d'une fois par période, même si de nouvelles alertes brutes
# continuent d'arriver pendant l'incident (évite le bruit côté dashboard).
CORRELATION_COOLDOWN_MINUTES = 15

# En dessous de ce score final, l'épisode n'est pas jugé assez
# significatif pour justifier une alerte comportementale à part entière
# (le Risk Engine capte déjà le bruit de faible intensité alerte par
# alerte) — aligné sur le seuil "high" du Risk Engine.
MIN_SCORE_TO_ALERT = 60


# ──────────────────────────────────────────────────────────
# Association catégorie Risk Engine -> tactique MITRE ATT&CK simplifiée.
# Une alerte peut relever de plusieurs tactiques à la fois si plusieurs
# catégories de son score_breakdown sont non nulles (ex: "Parent / Enfant"
# ET "Persistance" toutes les deux déclenchées par la même détection).
# ──────────────────────────────────────────────────────────
CATEGORY_TO_TACTIC = {
    "Processus":         "Exécution",
    "Ligne de commande": "Exécution",
    "Parent / Enfant":   "Exécution",
    "Fichier":           "Défense (évasion)",
    "Réseau":            "Commande et contrôle",
    "Persistance":       "Persistance",
    "Identité":          "Élévation de privilèges",
    "IOC":               "Impact confirmé",
    "Réputation":        "Découverte",
    "Environnement":     "Ciblage d'actif critique",
}

# Repli si l'alerte n'a pas de score_breakdown (agent ancien qui n'envoie
# pas encore de signaux détaillés, ou alerte créée à la main/en test) :
# on déduit une tactique approximative à partir de la catégorie métier
# fournie directement par l'agent.
FALLBACK_CATEGORY_TO_TACTIC = {
    "process":     "Exécution",
    "network":     "Commande et contrôle",
    "persistence": "Persistance",
    "file":        "Défense (évasion)",
    "quarantine":  "Impact confirmé",
}

# Label affiché (risk_engine.CATEGORY_LABELS) -> clé interne, pour
# retrouver la certitude intrinsèque de chaque famille de signal dans
# risk_engine.CONFIDENCE_WEIGHTS (indexé par clé interne, pas par label).
_LABEL_TO_CATEGORY = {label: cat for cat, label in risk_engine.CATEGORY_LABELS.items()}

# Enchaînements de tactiques connus comme des schémas d'attaque classiques.
# Chaque motif est une liste ORDONNÉE de tactiques : il matche si elles
# apparaissent toutes dans la fenêtre, DANS CET ORDRE — mais pas forcément
# consécutivement, ni exclusivement (d'autres alertes/tactiques peuvent
# s'intercaler sans empêcher la détection).
KNOWN_ATTACK_PATTERNS = [
    (["Exécution", "Persistance", "Commande et contrôle"],
     "Intrusion classique : exécution → persistance → commande et contrôle"),
    (["Exécution", "Élévation de privilèges", "Persistance"],
     "Prise de contrôle : exécution → élévation de privilèges → persistance"),
    (["Découverte", "Commande et contrôle", "Impact confirmé"],
     "Reconnaissance suivie d'une exfiltration ou d'un impact confirmé"),
]

BURST_POINTS = 25
DISTINCT_TACTICS_POINTS = 30
KNOWN_PATTERN_POINTS = 45

# Une chaîne confirmée par le Temporal Correlator (temporal_chains,
# paramètre de evaluate()) est la preuve la plus forte du pipeline : une
# continuité STRUCTURELLE (même pid/lignée de processus) sur au moins deux
# détections distinctes, pas une simple coïncidence de catégories dans le
# temps. Mise à l'échelle de 0-100 par sa propre confiance : à confiance
# quasi certaine, une SEULE chaîne temporelle doit pouvoir, à elle seule,
# franchir MIN_SCORE_TO_ALERT — avant la fusion des deux moteurs, le
# Temporal Correlator publiait déjà sa propre alerte sur cette seule base
# (confiance → sévérité, sans plancher de points) ; ce module ne doit pas
# être moins sensible que l'ancien moteur autonome qu'il remplace, tout en
# pouvant maintenant aussi se renforcer avec les autres preuves (rafale,
# tactiques distinctes, motif connu) plutôt que de rester isolé.
TEMPORAL_CHAIN_POINTS_SCALE = 100


def _tactics_for_alert(alert):
    """Retourne l'ensemble des tactiques concernées par une alerte."""
    tactics = set()
    breakdown = alert.get("score_breakdown") or {}
    for cat, pts in breakdown.items():
        if pts and pts > 0 and cat in CATEGORY_TO_TACTIC:
            tactics.add(CATEGORY_TO_TACTIC[cat])
    if not tactics:
        cat = (alert.get("category") or "").lower()
        if cat in FALLBACK_CATEGORY_TO_TACTIC:
            tactics.add(FALLBACK_CATEGORY_TO_TACTIC[cat])
    return tactics


def _parse_ts(ts):
    try:
        return datetime.fromisoformat(ts)
    except (TypeError, ValueError):
        return None


def _pattern_present(pattern, ordered_tactics):
    """True si `pattern` apparaît comme sous-séquence — pas forcément
    contiguë — de `ordered_tactics`. Ex: [A, B, C] matche dans
    [A, X, B, Y, C] mais pas dans [A, C, B].

    Astuce : parcourir un itérateur avec `in` consomme les éléments
    jusqu'à (et y compris) la valeur trouvée, donc chaque `step in it`
    reprend exactement là où le précédent s'est arrêté."""
    it = iter(ordered_tactics)
    return all(step in it for step in pattern)


def _confidence(windowed, temporal_chains=None):
    """Confiance de la chaîne : même formule que risk_engine.compute_risk()
    (moyenne des certitudes intrinsèques, pondérée par les points de
    chaque famille de signal) — réutilisée telle quelle, étendue sur
    TOUTES les alertes corrélées PLUS les chaînes temporelles éventuelles,
    pour une seule notion de confiance cohérente dans tout NHGuard. Une
    chaîne construite sur des signaux "Réputation" (le plus incertain de
    la table, cf. risk_engine.py) hérite naturellement d'une confiance
    basse, sans règle spéciale à écrire ici — c'est la Gestion UNKNOWN qui
    se propage depuis le Risk Engine jusqu'au Behaviour Engine.

    Chaque chaîne du Temporal Correlator (voir TEMPORAL_CHAIN_POINTS_SCALE)
    entre dans la MÊME moyenne pondérée, avec sa propre confiance comme
    "certitude" et ses points comme poids — exactement le même traitement
    qu'une famille de signal Risk Engine, ce qui matérialise la hiérarchie
    du pipeline (les deux sources de preuve convergent vers UN seul calcul).

    Une alerte sans score_breakdown exploitable (agent ancien, test)
    contribue avec un poids nominal à confiance basse plutôt que d'être
    ignorée — mieux vaut sous-estimer la confiance que la surestimer."""
    weighted_sum, total_weight = 0.0, 0.0
    for a in windowed:
        breakdown = a.get("score_breakdown") or {}
        contributed = False
        for label, pts in breakdown.items():
            if not pts or pts <= 0:
                continue
            cat = _LABEL_TO_CATEGORY.get(label)
            conf = risk_engine.CONFIDENCE_WEIGHTS.get(cat, risk_engine.DEFAULT_CONFIDENCE)
            weighted_sum += pts * conf
            total_weight += pts
            contributed = True
        if not contributed:
            weighted_sum += risk_engine.BASELINE_CONFIDENCE_NO_SIGNAL
            total_weight += 1

    for chain in (temporal_chains or []):
        pts = round(chain["confidence"] * TEMPORAL_CHAIN_POINTS_SCALE)
        if pts <= 0:
            continue
        weighted_sum += pts * chain["confidence"]
        total_weight += pts

    if total_weight == 0:
        return risk_engine.BASELINE_CONFIDENCE_NO_SIGNAL
    return round(max(0.0, min(1.0, weighted_sum / total_weight)), 2)


def _severity_for_score(score):
    """Réutilise les mêmes seuils que le Risk Engine (risk_engine.THRESHOLDS)
    plutôt que d'en redéfinir de nouveaux ici — une seule échelle 0-100
    pour tout NHGuard, cohérente entre alertes unitaires et comportementales."""
    for threshold, label in risk_engine.THRESHOLDS:
        if score >= threshold:
            return label
    return "low"


def evaluate(alerts, temporal_chains=None, now=None):
    """alerts : alertes d'UNE SEULE machine (déjà filtrées par agent_id
    côté appelant, voir db_data.get_recent_alerts_for_agent), dans
    n'importe quel ordre — ce module se charge de les trier et de ne
    garder que celles tombant dans la fenêtre de corrélation.

    temporal_chains : chaînes détectées par temporal_correlator.correlate()
    pour la MÊME machine (optionnel) — voir l'en-tête du module : c'est la
    preuve la plus forte du pipeline (continuité de pid/lignée de
    processus sur au moins deux détections distinctes), intégrée ici au
    même titre qu'une famille de signal Risk Engine plutôt que publiée
    comme une alerte séparée par un moteur concurrent.

    now : horodatage de référence (datetime), pour des tests déterministes.
    Par défaut : l'instant présent.

    Retourne None si rien d'assez significatif à signaler (cas normal,
    largement majoritaire), sinon un dict :
        {
          "severity": "critical" | "high",
          "score": int (0-100),
          "confidence": float (0-1),
          "title": str,
          "description": str,
          "details": [{"rule": str, "points": int}, ...],
          "source_alert_ids": [str, ...],
        }
    prêt à être passé à db_data.create_alert(category="comportemental", ...).
    """
    temporal_chains = temporal_chains or []
    if not alerts and not temporal_chains:
        return None

    now = now or datetime.utcnow()
    window_start = now - timedelta(minutes=CORRELATION_WINDOW_MINUTES)

    windowed = [a for a in alerts if (_parse_ts(a.get("timestamp")) or window_start) >= window_start]
    # Repli : normalement une seule alerte ne prouve jamais, à elle seule,
    # un "comportement" — SAUF si le Temporal Correlator apporte déjà sa
    # propre preuve structurelle indépendante (au moins deux détections
    # distinctes reliées par pid, garanti par sa propre conception).
    if len(windowed) < 2 and not temporal_chains:
        return None

    windowed.sort(key=lambda a: a.get("timestamp") or "")
    source_ids = [a["id"] for a in windowed if a.get("id")]
    agent_label = next(
        (a.get("agent_id") for a in reversed(alerts) if a.get("agent_id")), "?"
    )

    details = []
    temporal_chain_used = False

    # 0. Chaînes du Temporal Correlator — voir l'en-tête du module. Chaque
    #    chaîne devient sa propre ligne de preuve, mise à l'échelle par sa
    #    confiance propre plutôt qu'à points fixes.
    for chain in temporal_chains:
        pts = round(chain["confidence"] * TEMPORAL_CHAIN_POINTS_SCALE)
        if pts <= 0:
            continue
        details.append({
            "rule": f"Corrélation temporelle : {chain['pattern_name']} "
                    f"({chain['scope_level']}, confiance {chain['confidence']*100:.0f}%)",
            "points": pts,
        })
        source_ids.extend(a_id for a_id in chain.get("source_alert_ids", []) if a_id not in source_ids)
        temporal_chain_used = True

    # 1. Rafale : beaucoup d'alertes dans une fenêtre courte, quelles que
    #    soient les tactiques en jeu — souvent un outil automatisé/scripté.
    burst_window_start = now - timedelta(minutes=BURST_WINDOW_MINUTES)
    burst_count = sum(
        1 for a in windowed
        if (_parse_ts(a.get("timestamp")) or window_start) >= burst_window_start
    )
    burst = burst_count >= BURST_ALERT_COUNT
    if burst:
        details.append({
            "rule": f"{burst_count} alertes en moins de {BURST_WINDOW_MINUTES} min (rafale)",
            "points": BURST_POINTS,
        })

    # 2. Tactiques distinctes couvertes dans la fenêtre (ordre préservé,
    #    nécessaire pour la détection de motifs à l'étape 3).
    ordered_tactics = []
    for a in windowed:
        for t in sorted(_tactics_for_alert(a)):
            ordered_tactics.append(t)
    distinct_tactics = sorted(set(ordered_tactics))
    if len(distinct_tactics) >= MIN_TACTICS_FOR_CHAIN:
        details.append({
            "rule": f"{len(distinct_tactics)} tactiques distinctes observées : {', '.join(distinct_tactics)}",
            "points": DISTINCT_TACTICS_POINTS,
        })

    # 3. Motifs d'attaque connus (sous-séquences ordonnées de tactiques).
    chain_matches = []
    for pattern, label in KNOWN_ATTACK_PATTERNS:
        if _pattern_present(pattern, ordered_tactics):
            chain_matches.append(label)
            details.append({"rule": label, "points": KNOWN_PATTERN_POINTS})

    if not details:
        return None  # rien d'assez significatif pour justifier une alerte comportementale

    score = max(0, min(100, sum(d["points"] for d in details)))
    severity = _severity_for_score(score)
    confidence = _confidence(windowed, temporal_chains)

    # Même garde-fou que risk_engine.compute_risk() : une chaîne à
    # confiance insuffisante ne peut pas s'afficher au-dessus du plafond,
    # même si son score chiffré atteindrait "critical".
    if confidence < risk_engine.CONFIDENCE_GATE_THRESHOLD:
        if risk_engine.SEVERITY_ORDER.index(severity) > risk_engine.SEVERITY_ORDER.index(risk_engine.CONFIDENCE_GATE_MAX_SEVERITY):
            severity = risk_engine.CONFIDENCE_GATE_MAX_SEVERITY

    if severity not in ("high", "critical") or score < MIN_SCORE_TO_ALERT:
        return None  # le bruit de faible intensité reste géré alerte par alerte par le Risk Engine

    # Le titre reflète la preuve la plus forte disponible — une chaîne
    # temporelle (continuité de pid) prime sur une simple coïncidence de
    # catégories, qui prime elle-même sur une rafale sans motif précis.
    if temporal_chain_used:
        title = f"Chaîne comportementale confirmée (corrélation temporelle) sur {agent_label}"
    elif chain_matches:
        title = f"Chaîne d'attaque détectée sur {agent_label}"
    elif len(distinct_tactics) >= MIN_TACTICS_FOR_CHAIN:
        title = f"Comportement multi-tactiques suspect sur {agent_label}"
    else:
        title = f"Rafale d'alertes suspecte sur {agent_label}"

    description = (
        f"{len(windowed)} alertes corrélées sur les {CORRELATION_WINDOW_MINUTES} dernières minutes"
        + (f" ({', '.join(distinct_tactics)})" if distinct_tactics else "")
        + (f" + {len(temporal_chains)} chaîne(s) temporelle(s) confirmée(s)" if temporal_chains else "")
        + "."
    )

    return {
        "severity": severity,
        "score": score,
        "confidence": confidence,
        "title": title,
        "description": description,
        "details": details,
        "source_alert_ids": source_ids,
    }
