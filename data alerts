# Évènements de télémétrie continue (voir event_schema.py / event_queue.py
# côté agent) — flux brut indépendant des alertes, contrairement à
# process_events ci-dessus qui ne naît qu'au moment d'une détection.
# ──────────────────────────────────────────────────────────
def create_raw_events(org_id, events):
    """Insère un LOT d'évènements déjà validés (voir event_schema.validate_event,
    appelé par l'appelant AVANT ceci — cette fonction ne revalide pas).
    L'agent_id est lu depuis l'enveloppe de CHAQUE évènement (host.id) —
    un lot ne vient jamais que d'une seule machine en pratique, mais rien
    n'oblige cette fonction à le supposer. `INSERT OR IGNORE` : un
    event_id déjà vu (ex: l'agent renvoie un lot après une confirmation
    serveur perdue en route) est silencieusement ignoré plutôt que
    dupliqué — c'est précisément le rôle de l'event_id unique (document
    source, section 12 : déduplication)."""
    now = datetime.utcnow().isoformat(timespec="seconds")
    with get_connection() as conn:
        for ev in events:
            actor = ev.get("actor") or {}
            data = ev.get("data") or {}
            conn.execute("""
                INSERT OR IGNORE INTO events
                    (event_id, org_id, agent_id, seq, event_type, priority, pid, ppid,
                     actor_user, hash, data, timestamp, received_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (ev["event_id"], org_id, ev["host"]["id"], ev.get("seq"),
                  ev["event"]["type"], ev["event"].get("priority"),
                  actor.get("pid"), actor.get("ppid"), actor.get("user"),
                  data.get("hash"), json.dumps(data), ev["timestamp"], now))


def get_process_intelligence(org_id, file_hash):
    """Rareté / prévalence / historique d'un binaire (par SHA-256) au sein
    d'une organisation — calculé à la volée depuis la table `events`
    (process_start uniquement, seul type qui porte un hash) plutôt que
    maintenu à part dans une table de synthèse : plus simple, aucun
    risque de désynchronisation, et à l'échelle de ce produit (SQLite,
    requête indexée sur idx_events_org_hash) le coût est négligeable.

    Retourne None si file_hash est vide (rien à chercher). Sinon :
      {
        "seen_count": int,        -- nb de démarrages observés (tous hôtes)
        "distinct_hosts": int,    -- nb de machines DISTINCTES l'ayant exécuté
        "total_hosts": int,       -- nb total de machines de l'organisation
        "prevalence": float,      -- distinct_hosts / total_hosts (0-1)
        "first_seen": str|None,   -- horodatage de la première observation
        "last_seen": str|None,
        "is_new": bool,           -- jamais vu avant CETTE observation (seen_count <= 1)
        "is_rare": bool,          -- vu sur une seule machine alors qu'il y en a plusieurs
      }
    """
    if not file_hash:
        return None
    with get_connection() as conn:
        row = conn.execute("""
            SELECT COUNT(*) AS seen_count, COUNT(DISTINCT agent_id) AS distinct_hosts,
                   MIN(timestamp) AS first_seen, MAX(timestamp) AS last_seen
            FROM events WHERE org_id = ? AND event_type = 'process_start' AND hash = ?
        """, (org_id, file_hash)).fetchone()
        total_hosts = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ?", (org_id,)
        ).fetchone()["c"]

        seen_count = row["seen_count"] or 0
        distinct_hosts = row["distinct_hosts"] or 0
        return {
            "seen_count": seen_count,
            "distinct_hosts": distinct_hosts,
            "total_hosts": total_hosts,
            "prevalence": round(distinct_hosts / total_hosts, 3) if total_hosts else 0.0,
            "first_seen": row["first_seen"],
            "last_seen": row["last_seen"],
            "is_new": seen_count <= 1,
            "is_rare": total_hosts >= 3 and distinct_hosts == 1,
        }


def get_recent_raw_events_for_agent(org_id, agent_id, since_minutes, event_types=None):
    """Évènements de télémétrie continue d'UNE machine sur les
    `since_minutes` dernières minutes — entrée du Temporal Correlator pour
    la corrélation sur flux continu (voir temporal_correlator.correlate_raw_events).
    event_types : liste optionnelle pour ne récupérer que certains types
    (évite de charger tout le bruit informationnel non pertinent pour la
    corrélation, ex: heartbeats)."""
    since = (datetime.utcnow() - timedelta(minutes=since_minutes)).isoformat(timespec="seconds")
    with get_connection() as conn:
        if event_types:
            placeholders = ",".join("?" * len(event_types))
            rows = conn.execute(
                f"SELECT * FROM events WHERE org_id = ? AND agent_id = ? AND timestamp >= ? "
                f"AND event_type IN ({placeholders}) ORDER BY timestamp, seq",
                (org_id, agent_id, since, *event_types),
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT * FROM events WHERE org_id = ? AND agent_id = ? AND timestamp >= ? "
                "ORDER BY timestamp, seq",
                (org_id, agent_id, since),
            ).fetchall()
        out = []
        for r in rows:
            e = dict(r)
            try:
                e["data"] = json.loads(e["data"]) if e.get("data") else {}
            except (TypeError, json.JSONDecodeError):
                e["data"] = {}
            out.append(e)
        return out


