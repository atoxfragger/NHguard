def get_stats(org_id):
    with get_connection() as conn:
        total = conn.execute("SELECT COUNT(*) c FROM alerts WHERE org_id = ?", (org_id,)).fetchone()["c"]
        non_ack = conn.execute(
            "SELECT COUNT(*) c FROM alerts WHERE org_id = ? AND acknowledged = 0", (org_id,)
        ).fetchone()["c"]

        # is_correlation = 0 seulement : une chaîne détectée par le Behaviour
        # Engine ou le Temporal Correlator décrit un incident DÉJÀ compté par
        # les alertes brutes qui la composent — la compter aussi ici
        # doublerait artificiellement le volume d'incidents affiché (voir
        # create_alert() et le point "anti-double-counting" du produit).
        by_sev = {"critical": 0, "high": 0, "medium": 0, "low": 0}
        for row in conn.execute(
            "SELECT severity, COUNT(*) c FROM alerts WHERE org_id = ? AND acknowledged = 0 "
            "AND is_correlation = 0 GROUP BY severity",
            (org_id,),
        ):
            if row["severity"] in by_sev:
                by_sev[row["severity"]] = row["c"]

        # Alertes de corrélation non acquittées, comptées À PART : ce sont
        # des INSIGHTS ("ces alertes forment une chaîne"), pas de nouveaux
        # incidents à additionner aux compteurs de sévérité ci-dessus.
        correlation_insights = conn.execute(
            "SELECT COUNT(*) c FROM alerts WHERE org_id = ? AND acknowledged = 0 AND is_correlation = 1",
            (org_id,),
        ).fetchone()["c"]

        by_cat = {}
        for row in conn.execute(
            "SELECT category, COUNT(*) c FROM alerts WHERE org_id = ? GROUP BY category", (org_id,)
        ):
            by_cat[row["category"] or "autre"] = row["c"]

        since_24h = (datetime.utcnow() - timedelta(hours=24)).isoformat(timespec="seconds")
        last_24h = conn.execute(
            "SELECT COUNT(*) c FROM alerts WHERE org_id = ? AND timestamp >= ?", (org_id, since_24h)
        ).fetchone()["c"]

        agents_total = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ?", (org_id,)
        ).fetchone()["c"]
        agents_actifs = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ? AND status = 'active'", (org_id,)
        ).fetchone()["c"]
        agents_reels = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ? AND is_demo = 0", (org_id,)
        ).fetchone()["c"]
        a_des_donnees_demo = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ? AND is_demo = 1", (org_id,)
        ).fetchone()["c"] > 0

        return {
            "total": total, "non_acquittees": non_ack,
            "critical": by_sev["critical"], "high": by_sev["high"],
            "medium": by_sev["medium"], "low": by_sev["low"],
            "correlation_insights": correlation_insights,
            "par_categorie": by_cat, "last_24h": last_24h,
            "agents_total": agents_total, "agents_actifs": agents_actifs,
            "agents_reels": agents_reels, "a_des_donnees_demo": a_des_donnees_demo,
        }


