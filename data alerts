"""
Base de données des alertes et agents EDR — multi-tenant.

Fichier SQLite indépendant de la base des comptes (edr_users.db) : edr_data.db.
Chaque ligne (agent, alerte) est taguée par org_id : toutes les fonctions
de lecture exigent un org_id et ne renvoient JAMAIS de données d'une
autre organisation. C'est cette discipline qui garantit l'isolation
entre clients du SaaS.
"""

import sqlite3
import json
import random
import uuid
from contextlib import contextmanager
from datetime import datetime, timedelta

import risk_engine
import process_scoring

DB_PATH = "edr_data.db"


@contextmanager
def get_connection():
    conn = sqlite3.connect(DB_PATH, timeout=10)
    conn.row_factory = sqlite3.Row
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def init_db():
    with get_connection() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS agents (
                agent_id       TEXT NOT NULL,
                org_id         INTEGER NOT NULL,
                status         TEXT NOT NULL,
                cpu_percent    REAL DEFAULT 0,
                ram_percent    REAL DEFAULT 0,
                disk_percent   REAL DEFAULT 0,
                os             TEXT,
                last_seen      TEXT,
                process_count  INTEGER DEFAULT 0,
                cpu_model      TEXT,
                ram_total_gb   REAL DEFAULT 0,
                local_ip       TEXT,
                public_ip      TEXT,
                geo_city       TEXT,
                geo_region     TEXT,
                geo_country    TEXT,
                logged_in_user TEXT,
                processes      TEXT,   -- JSON: liste des processus en cours (snapshot)
                is_demo        INTEGER NOT NULL DEFAULT 0,
                isolated       INTEGER NOT NULL DEFAULT 0,
                queue_size     INTEGER DEFAULT 0,   -- taille de la file locale de l'agent (event_queue.py)
                agent_uptime   INTEGER DEFAULT 0,   -- secondes depuis le démarrage de l'agent
                collector_health TEXT,              -- JSON: {"process": "healthy"|"stalled", ...}
                PRIMARY KEY (agent_id, org_id)
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS events (
                event_id       TEXT NOT NULL,
                org_id         INTEGER NOT NULL,
                agent_id       TEXT NOT NULL,
                seq            INTEGER,
                event_type     TEXT NOT NULL,
                priority       TEXT,
                pid            INTEGER,
                ppid           INTEGER,
                actor_user     TEXT,
                hash           TEXT,            -- SHA-256 (process_start uniquement) — voir get_process_intelligence
                data           TEXT NOT NULL,   -- JSON: le champ "data" de l'évènement (voir event_schema.py)
                timestamp      TEXT NOT NULL,
                received_at    TEXT NOT NULL,
                PRIMARY KEY (event_id, org_id)
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS alerts (
                id             TEXT PRIMARY KEY,
                org_id         INTEGER NOT NULL,
                title          TEXT NOT NULL,
                description    TEXT,
                severity       TEXT NOT NULL,
                score          INTEGER NOT NULL DEFAULT 0,
                score_breakdown TEXT,   -- JSON: détail du calcul par famille (Risk Engine)
                score_details  TEXT,    -- JSON: règles individuelles (scoring de lignée de processus)
                category       TEXT,
                agent_id       TEXT,
                timestamp      TEXT NOT NULL,
                acknowledged   INTEGER NOT NULL DEFAULT 0,
                is_demo        INTEGER NOT NULL DEFAULT 0,
                confidence     REAL,             -- certitude 0-1 (Risk Engine / Behaviour Engine)
                threat_score   INTEGER,          -- preuve de malveillance seule, avant impact (Risk Engine)
                impact_score   INTEGER,          -- gravité si confirmé, seule (Risk Engine)
                is_correlation INTEGER NOT NULL DEFAULT 0  -- alerte dérivée (Behaviour/Temporal Engine), pas une détection brute
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS quarantine (
                id             TEXT PRIMARY KEY,
                org_id         INTEGER NOT NULL,
                agent_id       TEXT NOT NULL,
                file_path      TEXT NOT NULL,
                file_name      TEXT,
                reason         TEXT,
                action         TEXT NOT NULL,   -- 'process_terminated' / 'detected_only'
                severity       TEXT NOT NULL,
                timestamp      TEXT NOT NULL,
                restored       INTEGER NOT NULL DEFAULT 0,
                is_demo        INTEGER NOT NULL DEFAULT 0
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS process_events (
                id             TEXT PRIMARY KEY,
                org_id         INTEGER NOT NULL,
                agent_id       TEXT NOT NULL,
                alert_id       TEXT,             -- rattache l'évènement à une alerte (arbre)
                event_type     TEXT NOT NULL,    -- process / file / network / registry
                pid            INTEGER,
                parent_pid     INTEGER,
                process_name   TEXT,
                parent_name    TEXT,
                detail         TEXT,             -- chemin de fichier, IP:port, etc.
                timestamp      TEXT NOT NULL
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS commands (
                id             TEXT PRIMARY KEY,
                org_id         INTEGER NOT NULL,
                agent_id       TEXT NOT NULL,
                action         TEXT NOT NULL,    -- isolate / unisolate / kill_process / quarantine_file / restore_file
                params         TEXT,             -- JSON, ex: {"pid": 1234} ou {"path": "C:\\...", "quarantine_path": "..."}
                status         TEXT NOT NULL DEFAULT 'pending',  -- pending / done / failed
                result         TEXT,
                created_at     TEXT NOT NULL,
                executed_at    TEXT
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS iocs (
                id             TEXT PRIMARY KEY,
                org_id         INTEGER NOT NULL,
                type           TEXT NOT NULL,    -- hash / ip / cmdline_pattern
                value          TEXT NOT NULL,
                severity       TEXT NOT NULL DEFAULT 'high',
                description    TEXT,
                is_demo        INTEGER NOT NULL DEFAULT 0,
                created_at     TEXT NOT NULL
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_procevents_alert ON process_events(org_id, alert_id)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_commands_agent_status ON commands(org_id, agent_id, status)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_iocs_org ON iocs(org_id)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_quarantine_org_ts ON quarantine(org_id, timestamp DESC)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_alerts_org_ts ON alerts(org_id, timestamp DESC)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_alerts_org_sev ON alerts(org_id, severity)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_agents_org ON agents(org_id)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_events_org_agent_ts ON events(org_id, agent_id, timestamp)")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_events_org_type ON events(org_id, event_type)")

        # AVANT l'index sur hash : sur une base existant déjà avant l'ajout
        # de cette colonne, CREATE TABLE IF NOT EXISTS ne l'aurait pas créée
        # (table déjà existante = no-op) — l'index planterait sinon.
        events_cols = {row["name"] for row in conn.execute("PRAGMA table_info(events)")}
        if "hash" not in events_cols:
            conn.execute("ALTER TABLE events ADD COLUMN hash TEXT")
        conn.execute("CREATE INDEX IF NOT EXISTS idx_events_org_hash ON events(org_id, hash)")

        # Migration douce : si edr_data.db existait déjà avant l'ajout de ces
        # colonnes, on les ajoute sans effacer les données existantes.
        existing_cols = {row["name"] for row in conn.execute("PRAGMA table_info(agents)")}
        for col, coltype in [
            ("cpu_model", "TEXT"), ("ram_total_gb", "REAL DEFAULT 0"),
            ("local_ip", "TEXT"), ("logged_in_user", "TEXT"), ("processes", "TEXT"),
            ("is_demo", "INTEGER NOT NULL DEFAULT 0"), ("isolated", "INTEGER NOT NULL DEFAULT 0"),
            ("public_ip", "TEXT"), ("geo_city", "TEXT"), ("geo_region", "TEXT"), ("geo_country", "TEXT"),
            ("queue_size", "INTEGER DEFAULT 0"), ("agent_uptime", "INTEGER DEFAULT 0"),
            ("collector_health", "TEXT"),
        ]:
            if col not in existing_cols:
                conn.execute(f"ALTER TABLE agents ADD COLUMN {col} {coltype}")

        for table in ("alerts", "quarantine"):
            cols = {row["name"] for row in conn.execute(f"PRAGMA table_info({table})")}
            if "is_demo" not in cols:
                conn.execute(f"ALTER TABLE {table} ADD COLUMN is_demo INTEGER NOT NULL DEFAULT 0")

        quarantine_cols = {row["name"] for row in conn.execute("PRAGMA table_info(quarantine)")}
        if "quarantine_path" not in quarantine_cols:
            conn.execute("ALTER TABLE quarantine ADD COLUMN quarantine_path TEXT")
        if "file_moved" not in quarantine_cols:
            conn.execute("ALTER TABLE quarantine ADD COLUMN file_moved INTEGER NOT NULL DEFAULT 0")

        alert_cols = {row["name"] for row in conn.execute("PRAGMA table_info(alerts)")}
        if "score" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN score INTEGER NOT NULL DEFAULT 0")
            # Rétro-calcule un score pour les alertes déjà existantes
            for sev, sc in [("critical", 90), ("high", 70), ("medium", 45), ("low", 15)]:
                conn.execute("UPDATE alerts SET score = ? WHERE severity = ? AND score = 0", (sc, sev))
        if "score_breakdown" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN score_breakdown TEXT")
        if "score_details" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN score_details TEXT")
        if "confidence" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN confidence REAL")
        if "threat_score" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN threat_score INTEGER")
        if "impact_score" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN impact_score INTEGER")
        if "is_correlation" not in alert_cols:
            conn.execute("ALTER TABLE alerts ADD COLUMN is_correlation INTEGER NOT NULL DEFAULT 0")
            # Rétro-marque les alertes déjà créées par les moteurs de corrélation,
            # pour que les stats existantes ne les comptent pas rétroactivement
            # comme des détections brutes (voir get_stats).
            conn.execute(
                "UPDATE alerts SET is_correlation = 1 WHERE category IN ('comportemental', 'chaine_temporelle')"
            )


# Score de repli si le Risk Engine n'a pas pu être appliqué (ex: alerte créée
# sans signaux détaillés) — échelle alignée sur le moteur (0-100).
SEVERITY_SCORE = {"critical": 90, "high": 70, "medium": 45, "low": 15}


# ──────────────────────────────────────────────────────────
# Agents (toujours filtrés par org_id)
# ──────────────────────────────────────────────────────────
def get_agents(org_id):
    with get_connection() as conn:
        rows = conn.execute(
            "SELECT * FROM agents WHERE org_id = ? ORDER BY agent_id", (org_id,)
        ).fetchall()
        agents = []
        for r in rows:
            a = dict(r)
            try:
                a["processes"] = json.loads(a["processes"]) if a.get("processes") else []
            except (TypeError, json.JSONDecodeError):
                a["processes"] = []
            try:
                a["collector_health"] = json.loads(a["collector_health"]) if a.get("collector_health") else {}
            except (TypeError, json.JSONDecodeError):
                a["collector_health"] = {}
            agents.append(a)
        return agents


def upsert_agent(org_id, agent_id, status, cpu_percent, ram_percent, disk_percent, os_name,
                  process_count, cpu_model=None, ram_total_gb=0, local_ip=None,
                  logged_in_user=None, processes=None, is_demo=False,
                  public_ip=None, geo_city=None, geo_region=None, geo_country=None,
                  queue_size=0, agent_uptime=0, collector_health=None):
    """Le champ isolated N'EST PAS écrasé ici : le statut d'isolement est géré
    séparément par set_agent_isolated(), pour ne pas être effacé à chaque
    heartbeat normal de l'agent.

    queue_size/agent_uptime/collector_health : santé de la télémétrie
    (voir event_queue.py côté agent) — un collecteur "stalled" ou une
    file qui grossit sans se vider signale que l'agent ne remonte plus
    (ou plus assez) d'évènements, indépendamment de son statut réseau
    apparent (document source, section 19)."""
    processes_json = json.dumps(processes or [])
    collector_health_json = json.dumps(collector_health) if collector_health else None
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO agents (agent_id, org_id, status, cpu_percent, ram_percent, disk_percent, os,
                                 last_seen, process_count, cpu_model, ram_total_gb, local_ip,
                                 logged_in_user, processes, is_demo, public_ip, geo_city, geo_region, geo_country,
                                 queue_size, agent_uptime, collector_health)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(agent_id, org_id) DO UPDATE SET
                status=excluded.status, cpu_percent=excluded.cpu_percent,
                ram_percent=excluded.ram_percent, disk_percent=excluded.disk_percent,
                os=excluded.os, last_seen=excluded.last_seen, process_count=excluded.process_count,
                cpu_model=excluded.cpu_model, ram_total_gb=excluded.ram_total_gb,
                local_ip=excluded.local_ip, logged_in_user=excluded.logged_in_user,
                processes=excluded.processes, is_demo=excluded.is_demo,
                public_ip=excluded.public_ip, geo_city=excluded.geo_city,
                geo_region=excluded.geo_region, geo_country=excluded.geo_country,
                queue_size=excluded.queue_size, agent_uptime=excluded.agent_uptime,
                collector_health=excluded.collector_health
        """, (agent_id, org_id, status, cpu_percent, ram_percent, disk_percent, os_name,
              datetime.utcnow().isoformat(timespec="seconds"), process_count,
              cpu_model, ram_total_gb, local_ip, logged_in_user, processes_json,
              1 if is_demo else 0, public_ip, geo_city, geo_region, geo_country,
              queue_size, agent_uptime, collector_health_json))


def set_agent_isolated(org_id, agent_id, isolated: bool):
    with get_connection() as conn:
        conn.execute(
            "UPDATE agents SET isolated = ? WHERE org_id = ? AND agent_id = ?",
            (1 if isolated else 0, org_id, agent_id),
        )


# ──────────────────────────────────────────────────────────
# Alertes (toujours filtrées par org_id)
# ──────────────────────────────────────────────────────────
def get_alerts(org_id, severity=None, limit=50):
    with get_connection() as conn:
        if severity and severity != "all":
            rows = conn.execute(
                "SELECT * FROM alerts WHERE org_id = ? AND severity = ? ORDER BY timestamp DESC LIMIT ?",
                (org_id, severity, limit),
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT * FROM alerts WHERE org_id = ? ORDER BY timestamp DESC LIMIT ?",
                (org_id, limit),
            ).fetchall()
        alerts = []
        for r in rows:
            a = dict(r)
            try:
                a["score_breakdown"] = json.loads(a["score_breakdown"]) if a.get("score_breakdown") else {}
            except (TypeError, json.JSONDecodeError):
                a["score_breakdown"] = {}
            try:
                a["score_details"] = json.loads(a["score_details"]) if a.get("score_details") else []
            except (TypeError, json.JSONDecodeError):
                a["score_details"] = []
            alerts.append(a)
        return alerts


def create_alert(org_id, title, description, severity, category, agent_id, is_demo=False,
                  score=None, score_breakdown=None, score_details=None,
                  confidence=None, threat_score=None, impact_score=None, is_correlation=False):
    """is_correlation=True identifie une alerte PRODUITE par un moteur de
    corrélation (Behaviour Engine, Temporal Correlator) plutôt qu'une
    détection brute de l'agent — voir get_stats(), qui exclut ces alertes
    du décompte principal par sévérité pour ne pas compter deux fois le
    même incident (une fois comme détections brutes, une fois comme la
    chaîne qui les relie)."""
    alert_id = str(uuid.uuid4())
    if score is None:
        score = SEVERITY_SCORE.get(severity, 1)
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO alerts (id, org_id, title, description, severity, score, score_breakdown, score_details,
                                 category, agent_id, timestamp, acknowledged, is_demo,
                                 confidence, threat_score, impact_score, is_correlation)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?, ?, ?)
        """, (alert_id, org_id, title, description, severity, score,
              json.dumps(score_breakdown) if score_breakdown else None,
              json.dumps(score_details) if score_details else None,
              category, agent_id, datetime.utcnow().isoformat(timespec="seconds"), 1 if is_demo else 0,
              confidence, threat_score, impact_score, 1 if is_correlation else 0))
    return alert_id


def ack_alert(org_id, alert_id):
    """org_id est vérifié dans la clause WHERE : impossible d'acquitter
    l'alerte d'une autre organisation même en devinant son id."""
    with get_connection() as conn:
        conn.execute("UPDATE alerts SET acknowledged = 1 WHERE id = ? AND org_id = ?", (alert_id, org_id))


def get_recent_alerts_for_agent(org_id, agent_id, since_minutes):
    """Alertes d'UNE machine sur les `since_minutes` dernières minutes,
    triées du plus ancien au plus récent — entrée du Behaviour Engine
    (behaviour_engine.evaluate), qui a besoin de l'historique complet
    d'une machine pour corréler plusieurs alertes entre elles.

    Tri par (timestamp, rowid) et pas seulement timestamp : la colonne
    n'a qu'une précision à la seconde, donc plusieurs alertes créées la
    même seconde (typiquement pendant une rafale — justement ce que ce
    module cherche à détecter) auraient un ordre non déterministe sans
    ce départage. `rowid` est la colonne implicite de SQLite qui reflète
    l'ordre d'insertion, sans nécessiter de colonne ni migration dédiée."""
    since = (datetime.utcnow() - timedelta(minutes=since_minutes)).isoformat(timespec="seconds")
    with get_connection() as conn:
        rows = conn.execute(
            "SELECT * FROM alerts WHERE org_id = ? AND agent_id = ? AND timestamp >= ? "
            "ORDER BY timestamp, rowid",
            (org_id, agent_id, since),
        ).fetchall()
        alerts = []
        for r in rows:
            a = dict(r)
            try:
                a["score_breakdown"] = json.loads(a["score_breakdown"]) if a.get("score_breakdown") else {}
            except (TypeError, json.JSONDecodeError):
                a["score_breakdown"] = {}
            alerts.append(a)
        return alerts


def has_recent_alert_of_category(org_id, agent_id, category, cooldown_minutes):
    """True si une alerte de la catégorie donnée (ex: 'comportemental' pour
    le Behaviour Engine, 'chaine_temporelle' pour le Temporal Correlator) a
    déjà été créée pour cette machine il y a moins de `cooldown_minutes` —
    évite de spammer le dashboard d'une nouvelle alerte de corrélation à
    chaque évènement brut reçu pendant un même incident en cours."""
    since = (datetime.utcnow() - timedelta(minutes=cooldown_minutes)).isoformat(timespec="seconds")
    with get_connection() as conn:
        row = conn.execute(
            "SELECT 1 FROM alerts WHERE org_id = ? AND agent_id = ? AND category = ? "
            "AND timestamp >= ? LIMIT 1",
            (org_id, agent_id, category, since),
        ).fetchone()
        return row is not None


# ──────────────────────────────────────────────────────────
# Quarantaine (fichiers/processus bloqués)
# ──────────────────────────────────────────────────────────
def get_quarantine(org_id, limit=100):
    with get_connection() as conn:
        rows = conn.execute(
            "SELECT * FROM quarantine WHERE org_id = ? ORDER BY timestamp DESC LIMIT ?",
            (org_id, limit),
        ).fetchall()
        return [dict(r) for r in rows]


def create_quarantine_item(org_id, agent_id, file_path, reason, action, severity,
                            is_demo=False, quarantine_path=None, file_moved=False):
    item_id = str(uuid.uuid4())
    file_name = file_path.replace("\\", "/").split("/")[-1] if file_path else "inconnu"
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO quarantine
                (id, org_id, agent_id, file_path, file_name, reason, action, severity,
                 timestamp, restored, is_demo, quarantine_path, file_moved)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?)
        """, (item_id, org_id, agent_id, file_path, file_name, reason, action, severity,
              datetime.utcnow().isoformat(timespec="seconds"), 1 if is_demo else 0,
              quarantine_path, 1 if file_moved else 0))
    return item_id


def get_quarantine_item(org_id, item_id):
    with get_connection() as conn:
        row = conn.execute(
            "SELECT * FROM quarantine WHERE id = ? AND org_id = ?", (item_id, org_id)
        ).fetchone()
        return dict(row) if row else None


def restore_quarantine_item(org_id, item_id):
    """Marque un élément comme 'restauré' (ex: faux positif). Ne relance
    pas le processus ni ne déplace de fichier — c'est un statut administratif.
    Pour un vrai retour du fichier à sa place, voir restore_quarantined_file()
    côté serveur (qui dépose une commande 'restore_file' pour l'agent)."""
    with get_connection() as conn:
        conn.execute(
            "UPDATE quarantine SET restored = 1 WHERE id = ? AND org_id = ?", (item_id, org_id)
        )


def clear_demo_data(org_id):
    """Efface UNIQUEMENT les données marquées comme démo pour cette
    organisation — les vraies données d'agents ne sont jamais touchées."""
    with get_connection() as conn:
        conn.execute("DELETE FROM agents WHERE org_id = ? AND is_demo = 1", (org_id,))
        conn.execute("DELETE FROM alerts WHERE org_id = ? AND is_demo = 1", (org_id,))
        conn.execute("DELETE FROM quarantine WHERE org_id = ? AND is_demo = 1", (org_id,))
        conn.execute("DELETE FROM process_events WHERE org_id = ? AND alert_id IN "
                     "(SELECT id FROM alerts WHERE org_id = ? AND is_demo = 1)", (org_id, org_id))
        conn.execute("DELETE FROM iocs WHERE org_id = ? AND is_demo = 1", (org_id,))


# ──────────────────────────────────────────────────────────
# Commandes à distance (isolation, kill process, quarantaine/restauration
# de fichier) — file d'attente que l'agent consomme à chaque heartbeat.
# ──────────────────────────────────────────────────────────
def create_command(org_id, agent_id, action, params=None):
    """Actions volontairement limitées à des interventions précises,
    tracées et réversibles — jamais une exécution de commande arbitraire."""
    cmd_id = str(uuid.uuid4())
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO commands (id, org_id, agent_id, action, params, status, created_at)
            VALUES (?, ?, ?, ?, ?, 'pending', ?)
        """, (cmd_id, org_id, agent_id, action, json.dumps(params or {}),
              datetime.utcnow().isoformat(timespec="seconds")))
    return cmd_id


def get_pending_commands(org_id, agent_id):
    with get_connection() as conn:
        rows = conn.execute(
            "SELECT * FROM commands WHERE org_id = ? AND agent_id = ? AND status = 'pending' ORDER BY created_at",
            (org_id, agent_id),
        ).fetchall()
        out = []
        for r in rows:
            c = dict(r)
            try:
                c["params"] = json.loads(c["params"]) if c["params"] else {}
            except (TypeError, json.JSONDecodeError):
                c["params"] = {}
            out.append(c)
        return out


def get_command(org_id, command_id):
    with get_connection() as conn:
        row = conn.execute(
            "SELECT * FROM commands WHERE id = ? AND org_id = ?", (command_id, org_id)
        ).fetchone()
        return dict(row) if row else None


def complete_command(org_id, command_id, status, result=""):
    with get_connection() as conn:
        conn.execute("""
            UPDATE commands SET status = ?, result = ?, executed_at = ?
            WHERE id = ? AND org_id = ?
        """, (status, result, datetime.utcnow().isoformat(timespec="seconds"), command_id, org_id))


def get_recent_commands(org_id, agent_id=None, limit=50):
    with get_connection() as conn:
        if agent_id:
            rows = conn.execute(
                "SELECT * FROM commands WHERE org_id = ? AND agent_id = ? ORDER BY created_at DESC LIMIT ?",
                (org_id, agent_id, limit),
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT * FROM commands WHERE org_id = ? ORDER BY created_at DESC LIMIT ?",
                (org_id, limit),
            ).fetchall()
        return [dict(r) for r in rows]


# ──────────────────────────────────────────────────────────
# IoC — Indicateurs de Compromission (moteur de détection par règles)
# ──────────────────────────────────────────────────────────
def create_ioc(org_id, ioc_type, value, severity="high", description="", is_demo=False):
    ioc_id = str(uuid.uuid4())
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO iocs (id, org_id, type, value, severity, description, is_demo, created_at)
