def get_agents(org_id):
    with get_connection() as conn:
        rows = conn.execute(
            "SELECT * FROM agents WHERE org_id = ? ORDER BY agent_id", (org_id,)
        ).fetchall()
        agents = []
        for r in rows:
            a = dict(r)
            try:
                a["processes"] = json.loads(a["processes"]) if a.get("processes") else []
            except (TypeError, json.JSONDecodeError):
                a["processes"] = []
            agents.append(a)
        return agents


def upsert_agent(org_id, agent_id, status, cpu_percent, ram_percent, disk_percent, os_name,
                  process_count, cpu_model=None, ram_total_gb=0, local_ip=None,
                  logged_in_user=None, processes=None, is_demo=False,
                  public_ip=None, geo_city=None, geo_region=None, geo_country=None):
    """Le champ isolated N'EST PAS écrasé ici : le statut d'isolement est géré
    séparément par set_agent_isolated(), pour ne pas être effacé à chaque
    heartbeat normal de l'agent."""
    processes_json = json.dumps(processes or [])
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO agents (agent_id, org_id, status, cpu_percent, ram_percent, disk_percent, os,
                                 last_seen, process_count, cpu_model, ram_total_gb, local_ip,
                                 logged_in_user, processes, is_demo, public_ip, geo_city, geo_region, geo_country)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(agent_id, org_id) DO UPDATE SET
                status=excluded.status, cpu_percent=excluded.cpu_percent,
                ram_percent=excluded.ram_percent, disk_percent=excluded.disk_percent,
                os=excluded.os, last_seen=excluded.last_seen, process_count=excluded.process_count,
                cpu_model=excluded.cpu_model, ram_total_gb=excluded.ram_total_gb,
                local_ip=excluded.local_ip, logged_in_user=excluded.logged_in_user,
                processes=excluded.processes, is_demo=excluded.is_demo,
                public_ip=excluded.public_ip, geo_city=excluded.geo_city,
                geo_region=excluded.geo_region, geo_country=excluded.geo_country
        """, (agent_id, org_id, status, cpu_percent, ram_percent, disk_percent, os_name,
              datetime.utcnow().isoformat(timespec="seconds"), process_count,
              cpu_model, ram_total_gb, local_ip, logged_in_user, processes_json,
              1 if is_demo else 0, public_ip, geo_city, geo_region, geo_country))


def set_agent_isolated(org_id, agent_id, isolated: bool):
    with get_connection() as conn:
        conn.execute(
            "UPDATE agents SET isolated = ? WHERE org_id = ? AND agent_id = ?",
            (1 if isolated else 0, org_id, agent_id),
        )


