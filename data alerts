def get_alerts(org_id, severity=None, limit=50):
    with get_connection() as conn:
        if severity and severity != "all":
            rows = conn.execute(
                "SELECT * FROM alerts WHERE org_id = ? AND severity = ? ORDER BY timestamp DESC LIMIT ?",
                (org_id, severity, limit),
            ).fetchall()
        else:
            rows = conn.execute(
                "SELECT * FROM alerts WHERE org_id = ? ORDER BY timestamp DESC LIMIT ?",
                (org_id, limit),
            ).fetchall()
        alerts = []
        for r in rows:
            a = dict(r)
            try:
                a["score_breakdown"] = json.loads(a["score_breakdown"]) if a.get("score_breakdown") else {}
            except (TypeError, json.JSONDecodeError):
                a["score_breakdown"] = {}
            try:
                a["score_details"] = json.loads(a["score_details"]) if a.get("score_details") else []
            except (TypeError, json.JSONDecodeError):
                a["score_details"] = []
            alerts.append(a)
        return alerts


def create_alert(org_id, title, description, severity, category, agent_id, is_demo=False,
                  score=None, score_breakdown=None, score_details=None):
    alert_id = str(uuid.uuid4())
    if score is None:
        score = SEVERITY_SCORE.get(severity, 1)
    with get_connection() as conn:
        conn.execute("""
            INSERT INTO alerts (id, org_id, title, description, severity, score, score_breakdown, score_details, category, agent_id, timestamp, acknowledged, is_demo)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?)
        """, (alert_id, org_id, title, description, severity, score,
              json.dumps(score_breakdown) if score_breakdown else None,
              json.dumps(score_details) if score_details else None,
              category, agent_id, datetime.utcnow().isoformat(timespec="seconds"), 1 if is_demo else 0))
    return alert_id


def ack_alert(org_id, alert_id):
    """org_id est vérifié dans la clause WHERE : impossible d'acquitter
    l'alerte d'une autre organisation même en devinant son id."""
    with get_connection() as conn:
        conn.execute("UPDATE alerts SET acknowledged = 1 WHERE id = ? AND org_id = ?", (alert_id, org_id))


def get_recent_alerts_for_agent(org_id, agent_id, since_minutes):
    """Alertes d'UNE machine sur les `since_minutes` dernières minutes,
    triées du plus ancien au plus récent — entrée du Behaviour Engine
    (behaviour_engine.evaluate), qui a besoin de l'historique complet
    d'une machine pour corréler plusieurs alertes entre elles.

    Tri par (timestamp, rowid) et pas seulement timestamp : la colonne
    n'a qu'une précision à la seconde, donc plusieurs alertes créées la
    même seconde (typiquement pendant une rafale — justement ce que ce
    module cherche à détecter) auraient un ordre non déterministe sans
    ce départage. `rowid` est la colonne implicite de SQLite qui reflète
    l'ordre d'insertion, sans nécessiter de colonne ni migration dédiée."""
    since = (datetime.utcnow() - timedelta(minutes=since_minutes)).isoformat(timespec="seconds")
    with get_connection() as conn:
        rows = conn.execute(
            "SELECT * FROM alerts WHERE org_id = ? AND agent_id = ? AND timestamp >= ? "
            "ORDER BY timestamp, rowid",
            (org_id, agent_id, since),
        ).fetchall()
        alerts = []
        for r in rows:
            a = dict(r)
            try:
                a["score_breakdown"] = json.loads(a["score_breakdown"]) if a.get("score_breakdown") else {}
            except (TypeError, json.JSONDecodeError):
                a["score_breakdown"] = {}
            alerts.append(a)
        return alerts


def has_recent_behavioural_alert(org_id, agent_id, cooldown_minutes):
    """True si une alerte comportementale (category='comportemental') a déjà
    été créée pour cette machine il y a moins de `cooldown_minutes` — évite
    de spammer le dashboard d'une nouvelle alerte de corrélation à chaque
    alerte brute reçue pendant un même incident en cours."""
    since = (datetime.utcnow() - timedelta(minutes=cooldown_minutes)).isoformat(timespec="seconds")
    with get_connection() as conn:
        row = conn.execute(
            "SELECT 1 FROM alerts WHERE org_id = ? AND agent_id = ? AND category = 'comportemental' "
            "AND timestamp >= ? LIMIT 1",
            (org_id, agent_id, since),
        ).fetchone()
        return row is not None


