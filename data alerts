# ──────────────────────────────────────────────────────────
# Investigate : agrégations par catégorie, façon "query builder"
# ──────────────────────────────────────────────────────────
def get_investigate_aggregations(org_id):
    with get_connection() as conn:
        def counts(sql, params):
            return [{"label": r[0] or "—", "count": r[1]}
                    for r in conn.execute(sql, params).fetchall() if r[0] is not None]

        by_category = counts(
            "SELECT category, COUNT(*) c FROM alerts WHERE org_id = ? GROUP BY category ORDER BY c DESC",
            (org_id,),
        )
        by_severity = counts(
            "SELECT severity, COUNT(*) c FROM alerts WHERE org_id = ? GROUP BY severity ORDER BY c DESC",
            (org_id,),
        )
        by_agent = counts(
            "SELECT agent_id, COUNT(*) c FROM alerts WHERE org_id = ? GROUP BY agent_id ORDER BY c DESC LIMIT 10",
            (org_id,),
        )
        by_os = counts(
            "SELECT os, COUNT(*) c FROM agents WHERE org_id = ? GROUP BY os ORDER BY c DESC",
            (org_id,),
        )
        by_user = counts(
            "SELECT logged_in_user, COUNT(*) c FROM agents WHERE org_id = ? AND logged_in_user IS NOT NULL GROUP BY logged_in_user ORDER BY c DESC",
            (org_id,),
        )
        return {
            "categorie": by_category,
            "severite": by_severity,
            "agent": by_agent,
            "os": by_os,
            "utilisateur": by_user,
        }


def get_stats(org_id):
    with get_connection() as conn:
        total = conn.execute("SELECT COUNT(*) c FROM alerts WHERE org_id = ?", (org_id,)).fetchone()["c"]
        non_ack = conn.execute(
            "SELECT COUNT(*) c FROM alerts WHERE org_id = ? AND acknowledged = 0", (org_id,)
        ).fetchone()["c"]

        by_sev = {"critical": 0, "high": 0, "medium": 0, "low": 0}
        for row in conn.execute(
            "SELECT severity, COUNT(*) c FROM alerts WHERE org_id = ? AND acknowledged = 0 GROUP BY severity",
            (org_id,),
        ):
            if row["severity"] in by_sev:
                by_sev[row["severity"]] = row["c"]

        by_cat = {}
        for row in conn.execute(
            "SELECT category, COUNT(*) c FROM alerts WHERE org_id = ? GROUP BY category", (org_id,)
        ):
            by_cat[row["category"] or "autre"] = row["c"]

        since_24h = (datetime.utcnow() - timedelta(hours=24)).isoformat(timespec="seconds")
        last_24h = conn.execute(
            "SELECT COUNT(*) c FROM alerts WHERE org_id = ? AND timestamp >= ?", (org_id, since_24h)
        ).fetchone()["c"]

        agents_total = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ?", (org_id,)
        ).fetchone()["c"]
        agents_actifs = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ? AND status = 'active'", (org_id,)
        ).fetchone()["c"]
        agents_reels = conn.execute(
            "SELECT COUNT(*) c FROM agents WHERE org_id = ? AND is_demo = 0", (org_id,)
