async function loadAgentKey() {
  try {
    const res = await authFetch(`${API}/api/organization/agent-key`);
    const data = await res.json();
    const el = document.getElementById('agent-key-display');
    if (el) el.textContent = data.agent_api_key;
  } catch {}
}
function copyAgentKey() {
  const el = document.getElementById('agent-key-display');
  if (el) { navigator.clipboard.writeText(el.textContent); toast('Clé copiée'); }
}
async function regenerateAgentKey() {
  if (!confirm("Régénérer la clé va invalider l'ancienne : tous les agents déjà installés devront être reconfigurés. Continuer ?")) return;
  try {
    const res = await authFetch(`${API}/api/organization/agent-key/regenerate`, { method: 'POST' });
    const data = await res.json();
    document.getElementById('agent-key-display').textContent = data.agent_api_key;
    toast('Nouvelle clé générée');
  } catch { toast('Erreur', false); }
}

