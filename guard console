    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:16px">
      ${sections.map(([label, key]) => `
        <div class="panel">
          <div class="panel-head">${label}</div>
          <div style="padding:8px 16px 14px">
            ${(agg[key]||[]).length ? agg[key].map(item => `
              <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid rgba(42,52,68,.4);font-size:12px">
                <span style="color:var(--text2)">${(item.label||'').replace(/_/g,' ')}</span>
