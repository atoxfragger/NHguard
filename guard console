<div id="toast"></div>

<script>
// Même origine que la page servie : fonctionne automatiquement en
// local (127.0.0.1), sur le réseau (192.168.x.x) ou via un tunnel
// public (ngrok, Cloudflare Tunnel...), sans rien à modifier ici.
const API = window.location.origin;
let currentPage = 'dashboard';
let currentFilter = 'all';
let refreshTimer;

// ── Mode clair / sombre ───────────────────────────────────
// localStorage est approprié ici : ce fichier tourne comme une vraie page
// web sur votre propre serveur, pas dans un aperçu d'artefact Claude.ai.
function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
}
function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  const next = current === 'dark' ? 'light' : 'dark';
  applyTheme(next);
  try { localStorage.setItem('nhguard-theme', next); } catch {}
}
(function initTheme() {
  let saved = null;
  try { saved = localStorage.getItem('nhguard-theme'); } catch {}
  if (!saved) {
    saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
  applyTheme(saved);
})();

// ── Inclinaison 3D du panneau de connexion au mouvement de la souris ──
(function () {
  const tilt = document.getElementById('login-tilt');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasHover = window.matchMedia('(hover: hover)').matches;
  if (reduceMotion || !hasHover || !tilt) return;

  document.addEventListener('mousemove', (e) => {
    if (document.getElementById('login-screen').classList.contains('hidden')) return;
    const relX = (e.clientX / window.innerWidth - 0.5) * 2;
    const relY = (e.clientY / window.innerHeight - 0.5) * 2;
    tilt.style.transform = `rotateY(${relX * 4}deg) rotateX(${-relY * 4}deg)`;
  });
})();

// ══════════════════════════════════════════════════════════
//  AUTHENTIFICATION (2 facteurs)
// ══════════════════════════════════════════════════════════
// Le token de session est conservé en mémoire d'onglet (sessionStorage) :
// il est effacé à la fermeture de l'onglet et n'est jamais persistant.
let sessionToken = sessionStorage.getItem('edr_token') || null;
let tempToken     = null; // jeton temporaire entre l'étape 1 (mot de passe) et l'étape 2 (code)
let currentUser   = sessionStorage.getItem('edr_user') || null;
let currentOrg    = null;

function showLoginError(msg) {
  const el = document.getElementById('login-error');
  el.textContent = msg;
  el.classList.add('show');
}
function clearLoginError() {
  document.getElementById('login-error').classList.remove('show');
}
function goToStep(step) {
  clearLoginError();
  document.querySelectorAll('.login-step').forEach(s => s.classList.remove('active'));
  document.getElementById(`step-${step}`).classList.add('active');
  const showGoogle = step === 'credentials';
  document.getElementById('google-divider').style.display = showGoogle ? 'flex' : 'none';
  document.getElementById('google-btn-container').style.display = showGoogle ? 'flex' : 'none';
  if (step === 'otp') document.getElementById('login-otp').focus();
}
function showLogin() {
  document.getElementById('login-screen').classList.remove('hidden');
  document.getElementById('app-shell').style.display = 'none';
  goToStep('credentials');
  document.getElementById('login-user').focus();
}
function showApp() {
  document.getElementById('login-screen').classList.add('hidden');
  document.getElementById('app-shell').style.display = 'flex';
  if (currentUser) {
    document.getElementById('user-name').textContent = currentUser;
    document.getElementById('user-avatar').textContent = currentUser.slice(0,2).toUpperCase();
  }
  if (currentOrg) {
    document.querySelector('.logo-sub').textContent = currentOrg;
  }
  loadPage();
}

// Étape 1 : vérification du mot de passe → déclenche la demande de code 2FA
document.getElementById('step-credentials').addEventListener('submit', async (e) => {
  e.preventDefault();
  clearLoginError();
  const btn = document.getElementById('btn-step1');
  btn.disabled = true; btn.textContent = 'Vérification…';

  const username = document.getElementById('login-user').value.trim();
  const password = document.getElementById('login-pass').value;

  try {
    const res = await fetch(`${API}/api/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });
    const data = await res.json();

    if (res.ok && data.requires_2fa) {
      tempToken = data.temp_token;
      currentUser = username;
      goToStep('otp');
    } else if (res.ok && data.session_token) {
      // au cas où le compte n'a pas la 2FA activée (non recommandé)
      sessionToken = data.session_token;
      sessionStorage.setItem('edr_token', sessionToken);
      sessionStorage.setItem('edr_user', username);
      currentUser = username;
      showApp();
    } else {
      showLoginError(data.error || 'Identifiants invalides');
    }
  } catch (err) {
    showLoginError('Serveur inaccessible — lance edr_server.py');
  }
  btn.disabled = false; btn.textContent = 'Continuer';
});

// Étape 2 : vérification du code TOTP → ouvre la session
document.getElementById('step-otp').addEventListener('submit', async (e) => {
  e.preventDefault();
  clearLoginError();
  const btn = document.getElementById('btn-step2');
  btn.disabled = true; btn.textContent = 'Vérification…';

  const code = document.getElementById('login-otp').value.trim();

  try {
    const res = await fetch(`${API}/api/verify-2fa`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ temp_token: tempToken, code })
    });
    const data = await res.json();

    if (res.ok && data.session_token) {
      sessionToken = data.session_token;
      sessionStorage.setItem('edr_token', sessionToken);
      sessionStorage.setItem('edr_user', currentUser);
      document.getElementById('login-otp').value = '';
      showApp();
    } else {
      showLoginError(data.error || 'Code invalide');
      document.getElementById('login-otp').value = '';
    }
  } catch (err) {
    showLoginError('Serveur inaccessible — lance edr_server.py');
  }
  btn.disabled = false; btn.textContent = 'Vérifier';
});

// ══════════════════════════════════════════════════════════
//  CONNEXION AVEC GOOGLE (OAuth)
// ══════════════════════════════════════════════════════════
// Remplacez cette valeur par le Client ID OAuth créé dans
// Google Cloud Console (console.cloud.google.com > Identifiants).
// N'oubliez pas d'ajouter l'origine de votre site dans
// "Origines JavaScript autorisées".
const GOOGLE_CLIENT_ID = '652339744386-d8cjl24ahm1638i88sjd744kp66ni4db.apps.googleusercontent.com';

window.addEventListener('load', () => {
  if (!window.google || GOOGLE_CLIENT_ID.startsWith('VOTRE_CLIENT_ID')) return;
  google.accounts.id.initialize({
    client_id: GOOGLE_CLIENT_ID,
    callback: handleGoogleCredential
  });
  google.accounts.id.renderButton(
    document.getElementById('google-btn-container'),
    { theme: 'filled_black', size: 'large', shape: 'pill', width: 300, text: 'continue_with' }
  );
});

async function handleGoogleCredential(response) {
  clearLoginError();
  try {
    const res = await fetch(`${API}/api/auth/google`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ credential: response.credential })
    });
    const data = await res.json();

    if (!res.ok) {
      showLoginError(data.error || 'Connexion Google refusée');
      return;
    }

    currentUser = data.email;
    tempToken = data.temp_token;
    // Un code de vérification vient d'être envoyé par email -> étape 2
    goToStep('otp');
  } catch (err) {
    showLoginError('Serveur inaccessible — lance edr_server.py');
  }
}

async function resendCode() {
  const link = document.getElementById('resend-link');
  link.textContent = 'Envoi…';
  try {
    const res = await fetch(`${API}/api/resend-2fa`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ temp_token: tempToken })
    });
    const data = await res.json();
    if (res.ok) {
      tempToken = data.temp_token;
      toast('Nouveau code envoyé par email');
    } else {
      showLoginError(data.error || "Impossible de renvoyer le code");
    }
  } catch {
    showLoginError('Serveur inaccessible — lance edr_server.py');
  }
  link.textContent = 'Renvoyer le code';
}

function logout() {
  sessionToken = null;
  currentUser = null;
  sessionStorage.removeItem('edr_token');
  sessionStorage.removeItem('edr_user');
  clearTimeout(refreshTimer);
  document.getElementById('login-user').value = '';
  document.getElementById('login-pass').value = '';
  showLogin();
}

// Wrapper fetch authentifié : ajoute le token, gère l'expiration de session
async function authFetch(url, opts = {}) {
  opts.headers = Object.assign({}, opts.headers, {
    'Authorization': `Bearer ${sessionToken}`
  });
  const res = await fetch(url, opts);
  if (res.status === 401) {
    toast('Session expirée, reconnecte-toi', false);
    logout();
    throw new Error('unauthorized');
  }
  return res;
}

// Vérifie si un token existant est encore valide au chargement de la page
async function checkExistingSession() {
  if (!sessionToken) { showLogin(); return; }
  try {
    const res = await fetch(`${API}/api/me`, {
      headers: { 'Authorization': `Bearer ${sessionToken}` }
    });
    if (res.ok) {
      const me = await res.json();
      currentOrg = me.organization;
      showApp();
    } else { logout(); }
  } catch {
    // Serveur injoignable : on retente l'affichage de l'app, loadPage() gèrera l'erreur
    showApp();
  }
}

// ── Utilitaires ──────────────────────────────────────────
const $ = id => document.getElementById(id);
function ts(iso) {
  if (!iso) return '—';
  const d = new Date(iso + 'Z');
  return d.toLocaleTimeString('fr-FR', { hour:'2-digit', minute:'2-digit', second:'2-digit' })
       + ' ' + d.toLocaleDateString('fr-FR', { day:'2-digit', month:'2-digit' });
}
function clamp(v, min, max) { return Math.min(max, Math.max(min, v)); }
function toast(msg, ok=true) {
  const t = $('toast');
  t.textContent = msg;
  t.style.color = ok ? 'var(--green)' : 'var(--red)';
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}
function setStatus(online) {
  const dot  = $('status-dot');
  const text = $('status-text');
  dot.style.background = online ? 'var(--text1)' : 'var(--border)';
  dot.style.boxShadow  = 'none';
  text.textContent = '';
}

// ── Navigation ───────────────────────────────────────────
function setPage(p) {
  currentPage = p;
  document.querySelectorAll('.nav-item').forEach((el,i) => {
    el.classList.toggle('active', ['dashboard','alerts','agents','quarantine','investigate','history'][i] === p);
  });
  const titles = { dashboard:'Dashboard', alerts:'Alertes', agents:'Agents', quarantine:'Quarantaine', investigate:'Investigate', history:'Historique' };
  $('page-title').textContent = titles[p];
  clearTimeout(refreshTimer);
  loadPage();
}

// ── Seed démo ─────────────────────────────────────────────
async function seedDemo() {
  const btn = $('demo-btn');
  btn.textContent = 'Chargement…';
  try {
    const r = await authFetch(`${API}/api/demo/seed`, { method:'POST' });
    if (r.ok) { toast('Données de démo chargées !'); loadPage(); }
    else       { toast('Erreur lors du chargement', false); }
  } catch { toast('Serveur inaccessible — lance edr_server.py', false); }
  btn.textContent = 'Charger démo';
}

async function clearDemo() {
  const btn = $('clear-demo-btn');
  btn.textContent = 'Suppression…';
  try {
    const r = await authFetch(`${API}/api/demo/clear`, { method:'POST' });
    if (r.ok) { toast('Données de démo effacées'); loadPage(); }
    else       { toast('Erreur', false); }
  } catch { toast('Serveur inaccessible — lance edr_server.py', false); }
  btn.textContent = 'Effacer la démo';
}

// Met à jour la bannière démo (visible sur toutes les pages, pas
// seulement le Dashboard) en fonction de l'état réel des données.
async function updateDemoBanner() {
  try {
    const stats = await authFetch(`${API}/api/stats`).then(r => r.json());
    const banner = $('demo-banner');
    const clearBtn = $('clear-demo-btn');
    const text = $('demo-banner-text');
    if (!banner) return;

    if (stats.agents_reels > 0) {
      // Au moins un vrai agent -> la bannière ne sert plus à rien
      banner.style.display = 'none';
    } else {
      banner.style.display = 'flex';
      text.textContent = stats.a_des_donnees_demo
        ? "Vous visualisez des données de DÉMO, pas votre vraie machine."
        : "Aucun agent connecté ? Injecte des données de démo pour visualiser le dashboard.";
      clearBtn.style.display = stats.a_des_donnees_demo ? 'inline-block' : 'none';
    }
  } catch { /* silencieux : le reste de loadPage affichera déjà l'erreur serveur */ }
}

// ── Acquitter une alerte ─────────────────────────────────
async function ack(id) {
  try {
    await authFetch(`${API}/api/alerts/${id}/ack`, { method:'POST' });
    const row = document.querySelector(`tr[data-id="${id}"]`);
    if (row) { row.style.opacity = '.3'; row.style.transition = 'opacity .3s'; }
    setTimeout(loadPage, 400);
    toast('Alerte acquittée');
  } catch { toast('Erreur', false); }
}

// ══════════════════════════════════════════════════════════
//  PAGES
// ══════════════════════════════════════════════════════════
async function loadPage() {
  $('page-sub').textContent = `Actualisation : ${new Date().toLocaleTimeString('fr-FR')}`;
  const content = $('content');
  _agentsIndex = null; // rafraîchit le cache d'infos agents utilisé par le panneau de détails

  try {
    updateDemoBanner(); // sur toutes les pages, sans bloquer le reste
    if (currentPage === 'dashboard') await renderDashboard(content);
    if (currentPage === 'alerts')    await renderAlerts(content);
    if (currentPage === 'agents')    await renderAgents(content);
    if (currentPage === 'quarantine') await renderQuarantine(content);
    if (currentPage === 'investigate') await renderInvestigate(content);
    if (currentPage === 'history') await renderHistory(content);
    setStatus(true);
  } catch (e) {
    setStatus(false);
    if (e.message !== 'unauthorized') {
      content.innerHTML = `<div class="empty">Impossible de contacter le serveur.<br><br>Lance d'abord : <code style="color:var(--teal)">python edr_server.py</code></div>`;
    }
  }

  refreshTimer = setTimeout(loadPage, 5000); // Auto-refresh toutes les 5s
}

// ── DASHBOARD ────────────────────────────────────────────
async function renderDashboard(el) {
  const [stats, alerts, agents] = await Promise.all([
    authFetch(`${API}/api/stats`).then(r=>r.json()),
    authFetch(`${API}/api/alerts?limit=10`).then(r=>r.json()),
    authFetch(`${API}/api/agents`).then(r=>r.json()),
  ]);

  // Badges nav supprimés de l'interface

  const maxCat = Math.max(1, ...Object.values(stats.par_categorie || {}));
  const catColors = ['var(--red)','var(--orange)','var(--yellow)','var(--blue)','var(--purple)','var(--teal)','var(--green)','var(--text2)'];

  el.innerHTML = `
    <!-- KPIs -->
    <div class="kpi-grid">
      <div class="kpi red">  <div class="kpi-label">Critique</div>  <div class="kpi-val">${stats.critical||0}</div>  <div class="kpi-sub">alertes actives</div></div>
