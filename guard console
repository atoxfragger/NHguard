              <div id="detail-content-${a.id}" style="padding:14px 20px;font-size:11px"></div>
            </td>
          </tr>`).join('')}
      </tbody>
    </table>`;
}

// ── Process Timeline (arbre d'exécution, modale) ─────────
async function showProcessTimeline(alertId, alertTitle) {
  const modal = document.createElement('div');
  modal.id = 'timeline-modal';
  modal.style.cssText = 'position:fixed;inset:0;z-index:600;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;padding:20px';
  modal.innerHTML = `
    <div style="background:var(--bg1);border:1px solid var(--border);border-radius:12px;max-width:640px;width:100%;max-height:80vh;overflow-y:auto;padding:20px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px">
        <div style="font-size:14px;font-weight:600">Process Timeline</div>
        <button onclick="document.getElementById('timeline-modal').remove()" style="background:none;border:none;color:var(--text3);font-size:18px;cursor:pointer">X</button>
      </div>
      <div style="font-size:11px;color:var(--text3);margin-bottom:16px">${alertTitle}</div>
      <div id="timeline-content"><div class="empty" style="padding:24px">Chargement…</div></div>
    </div>`;
  document.body.appendChild(modal);

  try {
    const data = await authFetch(`${API}/api/alerts/${alertId}/process-tree`).then(r=>r.json());
    const tree = data.tree || [];
    const icons = { process: '', file: '', network: '', registry: '' };
    const content = document.getElementById('timeline-content');
    if (!tree.length) {
      content.innerHTML = '<div class="empty" style="padding:24px">Aucun évènement de processus enregistré pour cette alerte</div>';
      return;
    }
    // Rendu récursif de la hiérarchie (voir process_tree.py côté serveur) :
    // chaque niveau de profondeur est indenté et relié par un filet vertical,
    // pour voir d'un coup d'œil "qui a lancé qui" plutôt qu'une liste plate.
    const renderNode = (node, depth) => {
      const indent = depth * 20;
      const rows = node.events.map(e => `
        <div style="display:flex;gap:10px;padding:6px 0;margin-left:${indent}px;${depth>0?'border-left:2px solid var(--border);padding-left:14px':''}">
          <div style="font-size:15px;flex-shrink:0">${icons[e.type]||'•'}</div>
          <div style="flex:1;min-width:0">
            <div style="font-size:12px;color:var(--text1);font-family:var(--font-mono)">
              <strong>${node.name||'?'}</strong> <span style="color:var(--text3)">(PID ${node.pid})</span>
            </div>
            ${e.detail ? `<div style="font-size:11px;color:var(--text2);margin-top:2px;word-break:break-all">${e.detail}</div>` : ''}
            <div style="font-size:10px;color:var(--text3);margin-top:2px;font-family:var(--font-mono)">${e.type} · ${ts(e.timestamp)}</div>
          </div>
        </div>`).join('');
      return rows + node.children.map(c => renderNode(c, depth + 1)).join('');
    };
    content.innerHTML = tree.map((root, i) => `${i>0?'<div style="border-top:1px solid var(--border);margin:6px 0"></div>':''}${renderNode(root, 0)}`).join('');
  } catch {
    document.getElementById('timeline-content').innerHTML = '<div class="empty">Erreur de chargement</div>';
  }
}

// ── INVESTIGATE (agrégations façon query builder) ────────
