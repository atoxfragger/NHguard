  const icons = {
    isolate: '', unisolate: '', kill_process: '',
    quarantine_file: '', restore_file: '',
  };
  const labels = {
    isolate: 'Isolation réseau', unisolate: "Levée d'isolement", kill_process: 'Arrêt de processus',
    quarantine_file: 'Mise en quarantaine', restore_file: 'Restauration de fichier',
  };
  const statusBadge = {
    pending: '<span style="font-size:10px;color:var(--yellow)">⏳ En attente</span>',
    done:    '<span style="font-size:10px;color:var(--green)">Exécuté</span>',
    failed:  '<span style="font-size:10px;color:var(--red)">Échoué</span>',
  };

  el.innerHTML = `
    <div class="alerts-panel">
      ${!commands.length ? '<div class="empty">Aucune action enregistrée pour l\'instant</div>' : `
