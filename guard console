async function isolateAgent(agentId) {
  if (!confirm(`Isoler ${agentId} du réseau ? Toute communication sera bloquée sauf vers ce serveur. La commande sera exécutée au prochain heartbeat de l'agent (~15s).`)) return;
  try {
    await authFetch(`${API}/api/agents/${agentId}/isolate`, { method: 'POST' });
    toast('Commande d\'isolation envoyée');
    setTimeout(loadPage, 1000);
  } catch { toast('Erreur', false); }
}

async function unisolateAgent(agentId) {
  try {
    await authFetch(`${API}/api/agents/${agentId}/unisolate`, { method: 'POST' });
    toast('Commande de levée d\'isolement envoyée');
    setTimeout(loadPage, 1000);
  } catch { toast('Erreur', false); }
}

let _expandedAlertIds = new Set();

async function toggleAlertDetails(alertId) {
  if (_expandedAlertIds.has(alertId)) {
    _expandedAlertIds.delete(alertId);
  } else {
    _expandedAlertIds.add(alertId);
  }
  applyAlertDetailState(alertId);
  if (_expandedAlertIds.has(alertId)) await populateAlertDetailContent(alertId);
}

function applyAlertDetailState(alertId) {
  const row = document.getElementById(`detail-row-${alertId}`);
  const chev = document.getElementById(`chev-${alertId}`);
  if (!row || !chev) return;
  const expanded = _expandedAlertIds.has(alertId);
  row.style.display = expanded ? 'table-row' : 'none';
  chev.textContent = expanded ? 'v' : '>';
}

// Ré-applique l'état ouvert/fermé de chaque ligne après un re-rendu du
// tableau (ex: rafraîchissement automatique toutes les 5s) — sans ça, le
// panneau se refermait tout seul à chaque cycle.
async function restoreExpandedAlertDetails() {
  for (const alertId of _expandedAlertIds) {
    applyAlertDetailState(alertId);
    await populateAlertDetailContent(alertId);
  }
}

async function populateAlertDetailContent(alertId) {
  const content = document.getElementById(`detail-content-${alertId}`);
  if (!content) return;
  content.innerHTML = '<div style="color:var(--text3)">Chargement…</div>';

  const alert = _alertsIndex[alertId];
  const agent = alert ? await getAgentInfo(alert.agent_id) : null;
  const breakdown = alert?.score_breakdown || {};
  const scoreDetails = alert?.score_details || [];
  const hasBreakdown = Object.keys(breakdown).length > 0;
  const hasDetails = scoreDetails.length > 0;

  const rows = [
    ['Composant', 'NHGuard'],
    ['Nom de la machine', alert?.agent_id || '—'],
    ["Type d'évènement", (alert?.category || '—').replace(/_/g, ' ')],
    ['Sévérité', alert?.severity || '—'],
    ['Score', alert?.score ?? '—'],
    ['Heure de l\'évènement', ts(alert?.timestamp)],
    ['Description complète', alert?.description || '—'],
  ];
  if (agent) {
    rows.push(
      ['Utilisateur connecté', agent.logged_in_user || '—'],
      ['Adresse IP locale', agent.local_ip || '—'],
      ['Adresse IP publique', agent.public_ip || '—'],
      ['Localisation approximative', [agent.geo_city, agent.geo_region, agent.geo_country].filter(Boolean).join(', ') || '—'],
      ['Système', agent.os || '—'],
      ['Modèle CPU', agent.cpu_model || '—'],
    );
  }

  const breakdownHtml = hasBreakdown ? `
    <div style="margin-bottom:14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:12px 14px">
      <div style="font-size:11px;color:var(--text2);font-weight:600;margin-bottom:8px;text-transform:uppercase;letter-spacing:.4px">
        Pourquoi cette alerte vaut ${alert.score} ?
      </div>
      <table style="width:100%;border-collapse:collapse;font-family:var(--font-mono);font-size:12px">
        ${Object.entries(breakdown).map(([label, pts]) => `
          <tr>
            <td style="padding:2px 0;color:var(--text2)">${label}</td>
            <td style="padding:2px 0;text-align:right;color:${pts>0?'var(--red)':'var(--green)'}">${pts>0?'+':''}${pts}</td>
          </tr>`).join('')}
        <tr style="border-top:1px solid var(--border)">
          <td style="padding:4px 0;color:var(--text1);font-weight:600">Total</td>
          <td style="padding:4px 0;text-align:right;color:var(--text1);font-weight:600">${alert.score}</td>
        </tr>
      </table>
    </div>
  ` : '';

  const detailsHtml = hasDetails ? `
    <div style="margin-bottom:14px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:12px 14px">
      <div style="font-size:11px;color:var(--text2);font-weight:600;margin-bottom:8px;text-transform:uppercase;letter-spacing:.4px">
        Analyse de la lignée de processus
      </div>
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        ${scoreDetails.map(d => `
          <tr>
            <td style="padding:3px 10px 3px 0;color:var(--text2);font-family:var(--font-mono)">${d.rule}</td>
            <td style="padding:3px 0;text-align:right;color:${d.points>0?'var(--red)':'var(--green)'};font-family:var(--font-mono);white-space:nowrap">${d.points>0?'+':''}${d.points}</td>
          </tr>`).join('')}
      </table>
    </div>
  ` : '';

  content.innerHTML = `
    ${breakdownHtml}
    ${detailsHtml}
    <table style="width:100%;border-collapse:collapse">
      ${rows.map(([label, value]) => `
        <tr>
          <td style="padding:3px 16px 3px 0;color:var(--text3);white-space:nowrap;vertical-align:top;width:180px">${label}</td>
          <td style="padding:3px 0;color:var(--text2);font-family:var(--font-mono);word-break:break-word">${value}</td>
        </tr>`).join('')}
    </table>
    ${!agent ? '<div style="color:var(--text3);margin-top:8px">Détails machine indisponibles (agent hors ligne ou données de démo incomplètes).</div>' : ''}
  `;
}

async function killProcess(agentId, pid, name) {
  if (!confirm(`Tuer le processus ${name} (PID ${pid}) sur ${agentId} ?`)) return;
  try {
    await authFetch(`${API}/api/agents/${agentId}/kill-process`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pid, name }),
    });
    toast('Commande envoyée, exécution au prochain heartbeat');
  } catch { toast('Erreur', false); }
}

async function quarantineProcess(agentId, pid, name) {
  if (!confirm(`Mettre en quarantaine ${name} (PID ${pid}) sur ${agentId} ? Le processus sera arrêté et son fichier déplacé.`)) return;
  try {
    await authFetch(`${API}/api/agents/${agentId}/quarantine-file`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pid, severity: 'high', reason: `Mise en quarantaine manuelle : ${name}` }),
    });
    toast('Commande envoyée, exécution au prochain heartbeat');
  } catch { toast('Erreur', false); }
}

function toggleProcesses(i) {
  const panel = document.getElementById(`proc-panel-${i}`);
  const isHidden = panel.style.display === 'none';
  panel.style.display = isHidden ? 'block' : 'none';
}

