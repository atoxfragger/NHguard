              <td><span class="cat">${i.reason||'—'}</span></td>
              <td><span class="agent-pill">${i.agent_id}</span></td>
              <td>
                ${i.action==='process_terminated'
                  ? '<span style="font-size:10px;color:var(--green)">Processus stoppé</span>'
                  : i.action==='manual_quarantine'
                  ? '<span style="font-size:10px;color:var(--purple)">Quarantaine manuelle</span>'
                  : '<span style="font-size:10px;color:var(--orange)">Détecté seulement</span>'}
                ${i.file_moved ? '<br><span style="font-size:10px;color:var(--blue)">Fichier déplacé</span>' : ''}
              </td>
              <td><span class="ts">${ts(i.timestamp)}</span></td>
              <td style="white-space:nowrap">${i.restored
                  ? '<span style="font-size:10px;color:var(--text3)">Restauré</span>'
                  : `${i.file_moved ? `<button class="ack-btn" onclick="restoreFile('${i.id}')" style="color:var(--blue)">Restaurer le fichier</button>` : ''}
                     <button class="ack-btn" onclick="restoreQuarantine('${i.id}')" style="margin-left:4px">Faux positif</button>`}</td>
            </tr>`).join('')}
        </tbody>
      </table>`}
    </div>
  `;
}

async function manualQuarantine() {
  const agentId = document.getElementById('mq-agent').value;
  const path = document.getElementById('mq-path').value.trim();
  const severity = document.getElementById('mq-severity').value;
  const reason = document.getElementById('mq-reason').value.trim() || 'Mise en quarantaine manuelle depuis le dashboard';
  if (!agentId) { toast('Aucun agent disponible', false); return; }
  if (!path) { toast('Renseigne le chemin du fichier', false); return; }
  try {
    const res = await authFetch(`${API}/api/agents/${agentId}/quarantine-file`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path, severity, reason }),
    });
    if (res.ok) { toast('Commande de quarantaine envoyée'); document.getElementById('mq-path').value=''; }
    else { const d = await res.json(); toast(d.error || 'Erreur', false); }
  } catch { toast('Erreur', false); }
}

async function quarantineFromAlert(agentId, severity, title) {
  const path = prompt(`Chemin du fichier à mettre en quarantaine sur ${agentId} :`, '');
  if (!path) return;
  try {
    const res = await authFetch(`${API}/api/agents/${agentId}/quarantine-file`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: path.trim(), severity, reason: `Depuis l'alerte : ${title}` }),
    });
    if (res.ok) { toast('Commande de quarantaine envoyée'); }
    else { const d = await res.json(); toast(d.error || 'Erreur', false); }
  } catch { toast('Erreur', false); }
}

async function restoreFile(id) {
  if (!confirm("Remettre réellement ce fichier à son emplacement d'origine sur la machine ? La commande sera exécutée au prochain heartbeat de l'agent.")) return;
  try {
    await authFetch(`${API}/api/quarantine/${id}/restore-file`, { method: 'POST' });
    toast('Commande de restauration envoyée');
    loadPage();
  } catch { toast('Erreur', false); }
}

async function restoreQuarantine(id) {
  try {
    await authFetch(`${API}/api/quarantine/${id}/restore`, { method: 'POST' });
    toast('Marqué comme faux positif');
    loadPage();
  } catch { toast('Erreur', false); }
}

// ── Table alertes (réutilisable) ─────────────────────────
let _alertsIndex = {};
let _agentsIndex = null;

async function getAgentInfo(agentId) {
  if (!_agentsIndex) {
    try {
      const list = await authFetch(`${API}/api/agents`).then(r => r.json());
      _agentsIndex = {};
      list.forEach(a => { _agentsIndex[a.agent_id] = a; });
    } catch { _agentsIndex = {}; }
  }
  return _agentsIndex[agentId] || null;
}

