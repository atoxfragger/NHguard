  return `
    <table class="alerts-table">
      <thead>
        <tr>
          <th></th>
          <th>Score</th>
          <th>Sévérité</th>
          <th>Titre</th>
          <th>Agent</th>
          <th>Catégorie</th>
          <th>Heure</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        ${alerts.map(a => `
          <tr data-id="${a.id}" style="${a.acknowledged?'opacity:.4':''}">
            <td style="cursor:pointer;width:20px" onclick="toggleAlertDetails('${a.id}')"><span id="chev-${a.id}" style="color:var(--text3);font-family:var(--font-mono)">&gt;</span></td>
            <td><span class="score-badge score-${a.severity}">${a.score ?? '—'}</span></td>
            <td><span class="sev sev-${a.severity}">${a.severity}</span></td>
            <td style="max-width:260px">
              <div style="font-size:12px;color:var(--text1);font-weight:500">${a.title||'—'}</div>
              <div style="font-size:11px;color:var(--text3);margin-top:2px">${(a.description||'').substring(0,80)}${(a.description||'').length>80?'…':''}</div>
            </td>
            <td><span class="agent-pill">${a.agent_id}</span></td>
            <td><span class="cat">${(a.category||'—').replace(/_/g,' ')}</span></td>
            <td><span class="ts">${ts(a.timestamp)}</span></td>
            <td style="white-space:nowrap">
              <button class="ack-btn" onclick="showProcessTimeline('${a.id}','${(a.title||'').replace(/'/g,"\\'")}')" title="Voir la chaîne d'exécution">Timeline</button>
              <button class="ack-btn" onclick="quarantineFromAlert('${a.agent_id}','${a.severity}','${(a.title||'').replace(/'/g,"\\'")}')" style="margin-left:6px;color:var(--purple)">Mettre en quarantaine</button>
              ${a.acknowledged?'<span style="font-size:10px;color:var(--green);margin-left:6px">OK</span>':`<button class="ack-btn" onclick="ack('${a.id}')" style="margin-left:6px">Acquitter</button>`}
            </td>
