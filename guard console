<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NHGuard — Console de sécurité</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ── Reset & Variables ─────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --void:      #ffffff;
    --panel:     #ffffff;
    --grid-line: #e8edf2;
    --bg0:      #ffffff;
    --bg1:      #ffffff;
    --bg2:      #f1f5f9;
    --bg3:      #e2e8f0;
    --bg4:      #cbd5e1;
    --border:   #e2e8f0;
    --text1:    #0f172a;
    --text2:    #475569;
    --text3:    #94a3b8;
    --red:      #dc2626;
    --orange:   #ea580c;
    --yellow:   #ca8a04;
    --green:    #16a34a;
    --blue:     #2563eb;
    --purple:   #7c3aed;
    --teal:     #0d9488;
    --red-bg:   rgba(220,38,38,.08);
    --ora-bg:   rgba(234,88,12,.08);
    --yel-bg:   rgba(202,138,4,.08);
    --grn-bg:   rgba(22,163,74,.08);
    --font-mono: 'JetBrains Mono', monospace;
    --font-ui:   'Inter', sans-serif;
    --font-display: 'Space Grotesk', sans-serif;
    --scene-glow: #f4f7f9;
    --card-bg:    rgba(255,255,255,.9);
    --card-shadow: rgba(15,23,42,.18);
  }

  /* ── Mode sombre — mêmes variables, valeurs inversées ────── */
  [data-theme="dark"] {
    --void:      #05070a;
    --panel:     #0b1119;
    --grid-line: #16222c;
    --bg0:      #0a0c0f;
    --bg1:      #10141a;
    --bg2:      #161b24;
    --bg3:      #1e2530;
    --bg4:      #252e3d;
    --border:   #2a3444;
    --text1:    #e2e8f0;
    --text2:    #94a3b8;
    --text3:    #64748b;
    --red:      #f87171;
    --orange:   #fb923c;
    --yellow:   #fbbf24;
    --green:    #4ade80;
    --blue:     #60a5fa;
    --purple:   #a78bfa;
    --teal:     #2dd4bf;
    --red-bg:   rgba(248,113,113,.12);
    --ora-bg:   rgba(251,146,60,.12);
    --yel-bg:   rgba(251,191,36,.12);
    --grn-bg:   rgba(74,222,128,.12);
    --scene-glow: #0c1620;
    --card-bg:    rgba(11,17,25,.94);
    --card-shadow: rgba(0,0,0,.7);
  }

  /* Bouton de bascule clair/sombre, dans la topbar */
  .theme-toggle {
    width: 30px; height: 30px; border-radius: 7px; border: 1px solid var(--border);
    background: var(--bg2); color: var(--text2); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s, color .15s;
  }
  .theme-toggle:hover { background: var(--bg3); color: var(--text1); }
  .theme-toggle svg { width: 15px; height: 15px; }
  .theme-toggle .icon-moon { display: none; }
  [data-theme="dark"] .theme-toggle .icon-sun  { display: none; }
  [data-theme="dark"] .theme-toggle .icon-moon { display: block; }

  html, body { height: 100%; background: var(--bg0); color: var(--text1); font-family: var(--font-ui); }

  /* ── Scrollbar ─────────────────────────────────────────── */
  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--bg1); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  /* ── Layout ────────────────────────────────────────────── */
  .shell { display: flex; height: 100vh; overflow: hidden; }

  /* ── Sidebar ───────────────────────────────────────────── */
  .sidebar {
    width: 220px; flex-shrink: 0;
    background: var(--bg1);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    padding: 0;
  }
  .logo {
    padding: 20px 18px 16px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; gap: 10px;
  }
  .logo-icon {
    width: 32px; height: 32px; border-radius: 8px;
    background: linear-gradient(135deg, var(--teal), var(--blue));
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
  }
  .logo-text { font-size: 15px; font-weight: 600; letter-spacing: .3px; }
  .logo-sub  { font-size: 10px; color: var(--text3); font-family: var(--font-mono); margin-top: 1px; }

  .nav { padding: 12px 8px; flex: 1; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 10px; border-radius: 6px; cursor: pointer;
    font-size: 13px; color: var(--text2); transition: all .15s;
    margin-bottom: 2px; user-select: none;
  }
  .nav-item:hover  { background: var(--bg3); color: var(--text1); }
  .nav-item.active { background: var(--bg4); color: var(--teal); }
  .nav-icon { font-size: 15px; width: 18px; text-align: center; }

  .badge {
    margin-left: auto; font-size: 10px; font-family: var(--font-mono);
    background: var(--red-bg); color: var(--red);
    padding: 2px 6px; border-radius: 4px; font-weight: 500;
  }
  .badge.ok { background: var(--grn-bg); color: var(--green); }

  /* ── Sidebar footer / user ─────────────────────────────── */
  .sidebar-footer {
    border-top: 1px solid var(--border);
    padding: 12px 10px;
    display: flex; align-items: center; gap: 8px;
  }
  .user-avatar {
    width: 26px; height: 26px; border-radius: 50%;
    background: var(--bg4); color: var(--teal);
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-family: var(--font-mono); font-weight: 600;
    flex-shrink: 0;
  }
  .user-name { font-size: 12px; color: var(--text2); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .logout-btn {
    background: none; border: 1px solid var(--border); color: var(--text3);
    font-size: 11px; padding: 4px 8px; border-radius: 5px; cursor: pointer;
    font-family: var(--font-mono); transition: all .15s;
  }
  .logout-btn:hover { background: var(--red-bg); color: var(--red); border-color: var(--red); }

  /* ── Main ──────────────────────────────────────────────── */
  .main {
    flex: 1; overflow-y: auto;
    display: flex; flex-direction: column;
    background: var(--bg0);
  }

  /* ── Top bar ───────────────────────────────────────────── */
  .topbar {
    position: sticky; top: 0; z-index: 10;
    background: var(--bg0); border-bottom: 1px solid var(--border);
    padding: 14px 24px; display: flex; align-items: center; gap: 12px;
  }
  .topbar-title { font-size: 16px; font-weight: 600; }
  .topbar-sub   { font-size: 12px; color: var(--text3); font-family: var(--font-mono); margin-top: 2px; }
  .status-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--text1);
    margin-left: auto;
  }
  .status-text { font-size: 12px; color: var(--text3); font-family: var(--font-mono); }

  /* ── Content ───────────────────────────────────────────── */
  .content { padding: 24px; flex: 1; }

  /* ── KPI cards ─────────────────────────────────────────── */
  .kpi-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr));
    gap: 12px; margin-bottom: 24px;
  }
  .kpi {
    background: var(--bg1); border: 1px solid var(--border);
    border-radius: 10px; padding: 16px;
    display: flex; flex-direction: column; gap: 4px;
    transition: border-color .2s;
  }
  .kpi:hover { border-color: var(--bg4); }
  .kpi-label { font-size: 11px; color: var(--text3); text-transform: uppercase; letter-spacing: .8px; }
  .kpi-val   { font-size: 28px; font-weight: 600; font-family: var(--font-mono); line-height: 1; }
  .kpi-sub   { font-size: 11px; color: var(--text3); }
  .kpi.red   { border-left: 3px solid var(--red);    } .kpi.red .kpi-val   { color: var(--red); }
  .kpi.ora   { border-left: 3px solid var(--orange); } .kpi.ora .kpi-val   { color: var(--orange); }
  .kpi.yel   { border-left: 3px solid var(--yellow); } .kpi.yel .kpi-val   { color: var(--yellow); }
  .kpi.grn   { border-left: 3px solid var(--green);  } .kpi.grn .kpi-val   { color: var(--green); }
  .kpi.blu   { border-left: 3px solid var(--blue);   } .kpi.blu .kpi-val   { color: var(--blue); }
  .kpi.pur   { border-left: 3px solid var(--purple); } .kpi.pur .kpi-val   { color: var(--purple); }

  /* ── Section title ─────────────────────────────────────── */
  .section-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 12px;
  }
  .section-title { font-size: 13px; font-weight: 600; color: var(--text2); text-transform: uppercase; letter-spacing: .8px; }
  .refresh-btn {
    font-size: 11px; color: var(--text3); background: none; border: 1px solid var(--border);
    padding: 4px 10px; border-radius: 5px; cursor: pointer; font-family: var(--font-mono);
    transition: all .15s;
  }
  .refresh-btn:hover { background: var(--bg3); color: var(--text1); }

  /* ── Alerts table ──────────────────────────────────────── */
  .alerts-panel {
    background: var(--bg1); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden; margin-bottom: 24px;
  }
  .alert-filters {
    padding: 12px 16px; border-bottom: 1px solid var(--border);
    display: flex; gap: 8px; flex-wrap: wrap; align-items: center;
  }
  .filter-btn {
    font-size: 11px; padding: 4px 10px; border-radius: 5px; cursor: pointer;
    border: 1px solid var(--border); background: none; color: var(--text3);
    font-family: var(--font-mono); transition: all .15s; user-select: none;
  }
  .filter-btn:hover { background: var(--bg3); color: var(--text1); }
  .filter-btn.active { background: var(--bg4); color: var(--text1); border-color: var(--bg4); }
  .filter-btn.f-crit.active { background: var(--red-bg);  color: var(--red);    border-color: var(--red); }
  .filter-btn.f-high.active { background: var(--ora-bg);  color: var(--orange); border-color: var(--orange); }
  .filter-btn.f-med.active  { background: var(--yel-bg);  color: var(--yellow); border-color: var(--yellow); }
  .filter-btn.f-low.active  { background: var(--grn-bg);  color: var(--green);  border-color: var(--green); }

  .alerts-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .alerts-table th {
    padding: 10px 16px; text-align: left; font-size: 10px;
    text-transform: uppercase; letter-spacing: .8px; color: var(--text3);
    border-bottom: 1px solid var(--border); font-weight: 500; background: var(--bg1);
    position: sticky; top: 0;
  }
  .alerts-table td { padding: 10px 16px; border-bottom: 1px solid rgba(42,52,68,.5); vertical-align: middle; }
  .alerts-table tr:hover td { background: var(--bg2); }
  .alerts-table tr:last-child td { border-bottom: none; }

  .sev {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 10px; font-family: var(--font-mono); font-weight: 500;
    padding: 2px 7px; border-radius: 4px; text-transform: uppercase; white-space: nowrap;
  }
  .sev::before { content:''; width:6px; height:6px; border-radius:50%; display:inline-block; }
  .sev-critical { background: var(--red-bg);  color: var(--red);    } .sev-critical::before { background: var(--red); }
  .sev-high     { background: var(--ora-bg);  color: var(--orange); } .sev-high::before     { background: var(--orange); }
  .sev-medium   { background: var(--yel-bg);  color: var(--yellow); } .sev-medium::before   { background: var(--yellow); }
  .sev-low      { background: var(--grn-bg);  color: var(--green);  } .sev-low::before      { background: var(--green); }

  .score-badge {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; border-radius: 5px;
    font-size: 11px; font-weight: 700; font-family: var(--font-mono);
  }
  .score-critical { background: var(--red);    color: #2a0a0a; }
  .score-high     { background: var(--orange); color: #2a1a05; }
  .score-medium   { background: var(--yellow); color: #2a2205; }
  .score-low      { background: var(--green);  color: #052a0f; }

  .cat { font-size: 10px; color: var(--text3); font-family: var(--font-mono); }
  .agent-pill {
    font-size: 10px; font-family: var(--font-mono);
    background: var(--bg3); color: var(--blue);
    padding: 2px 7px; border-radius: 4px; border: 1px solid var(--border);
  }
  .ts { font-size: 10px; color: var(--text3); font-family: var(--font-mono); }
  .ack-btn {
    font-size: 10px; padding: 3px 8px; border-radius: 4px; cursor: pointer;
    border: 1px solid var(--border); background: none; color: var(--text3);
    font-family: var(--font-mono); transition: all .15s;
  }
  .ack-btn:hover { background: var(--grn-bg); color: var(--green); border-color: var(--green); }
  .empty { padding: 48px; text-align: center; color: var(--text3); font-size: 13px; }

  /* ── Bottom grid ───────────────────────────────────────── */
  .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  /* ── Agents panel ──────────────────────────────────────── */
  .panel {
    background: var(--bg1); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden;
  }
  .panel-head {
    padding: 12px 16px; border-bottom: 1px solid var(--border);
    font-size: 11px; font-weight: 600; color: var(--text2);
    text-transform: uppercase; letter-spacing: .8px;
  }
  .agent-row {
    padding: 11px 16px; border-bottom: 1px solid rgba(42,52,68,.5);
    display: flex; align-items: center; gap: 10px;
  }
  .agent-row:last-child { border-bottom: none; }
  .agent-status { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .agent-status.active  { background: var(--green); box-shadow: 0 0 5px var(--green); }
  .agent-status.offline { background: var(--text3); }
  .agent-name { font-size: 12px; font-family: var(--font-mono); font-weight: 500; flex: 1; }
  .agent-meta { font-size: 10px; color: var(--text3); font-family: var(--font-mono); }
  .mini-bar-wrap { flex: 1; height: 4px; background: var(--bg3); border-radius: 2px; overflow: hidden; }
  .mini-bar { height: 100%; border-radius: 2px; transition: width .5s; }

  /* ── Category chart ────────────────────────────────────── */
  .cat-list { padding: 12px 16px; }
  .cat-row { margin-bottom: 12px; }
  .cat-row-head { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11px; }
  .cat-name { color: var(--text2); }
  .cat-num  { color: var(--text3); font-family: var(--font-mono); }
  .bar-track { height: 5px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
  .bar-fill  { height: 100%; border-radius: 3px; transition: width .6s; }

  /* ── Demo banner ───────────────────────────────────────── */
  .demo-banner {
    margin: 0 24px 16px;
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 16px;
    display: flex; align-items: center; gap: 12px;
    font-size: 12px; color: var(--text2);
  }
  .demo-btn {
    margin-left: auto; font-size: 11px; padding: 6px 14px; border-radius: 6px;
    border: 1px solid var(--teal); background: rgba(45,212,191,.1); color: var(--teal);
    cursor: pointer; font-family: var(--font-mono); transition: all .15s;
  }
  .demo-btn:hover { background: rgba(45,212,191,.2); }

  /* ── Spinner ───────────────────────────────────────────── */
  .spin { display:inline-block; animation: spin .6s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ── Toast ─────────────────────────────────────────────── */
  #toast {
    position: fixed; bottom: 20px; right: 20px; z-index: 999;
    background: var(--bg3); border: 1px solid var(--border);
    padding: 10px 16px; border-radius: 8px; font-size: 12px;
    opacity: 0; transform: translateY(10px);
    transition: all .2s; pointer-events: none;
  }
  #toast.show { opacity: 1; transform: translateY(0); }

  /* ── Login screen (2FA) — même scène 3D que register.html ── */
  #login-screen { position: fixed; inset: 0; z-index: 500; }
  #login-screen.hidden { display: none; }

  .scene {
    position: fixed; inset: 0; z-index: 0; overflow: hidden;
    background: radial-gradient(ellipse 80% 55% at 50% 28%, var(--scene-glow) 0%, var(--void) 68%);
  }
  .horizon {
    position: absolute; left: 0; right: 0; top: 30%; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(45,212,191,.55), transparent);
    filter: blur(.5px);
  }
  .grid-floor {
    position: absolute; left: -60%; right: -60%; bottom: -6%; height: 62%;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 46px 46px;
    transform: perspective(600px) rotateX(78deg);
    transform-origin: bottom;
    -webkit-mask-image: linear-gradient(to top, black 15%, transparent 92%);
            mask-image: linear-gradient(to top, black 15%, transparent 92%);
    opacity: .8;
  }
  .radar-sweep {
    position: absolute; left: 50%; top: 30%; width: 1400px; height: 1400px;
    margin-left: -700px; margin-top: -20px;
    background: conic-gradient(from 0deg, rgba(45,212,191,.16), transparent 20%);
    border-radius: 50%; mix-blend-mode: screen;
    animation: sweep 9s linear infinite; opacity: .5;
  }
  @keyframes sweep { to { transform: rotate(360deg); } }

  .node { position: absolute; width: 3px; height: 3px; border-radius: 50%; background: var(--teal); opacity: .5; animation: drift 7s ease-in-out infinite; }
  .node:nth-child(1) { top: 18%; left: 12%; animation-delay: 0s; }
  .node:nth-child(2) { top: 62%; left: 82%; animation-delay: 1.4s; background: var(--blue); }
  .node:nth-child(3) { top: 40%; left: 88%; animation-delay: 2.8s; }
  .node:nth-child(4) { top: 74%; left: 8%;  animation-delay: 4.2s; background: var(--blue); }
  .node:nth-child(5) { top: 12%; left: 70%; animation-delay: 5.6s; }
  @keyframes drift { 0%,100% { transform: translateY(0); opacity: .35; } 50% { transform: translateY(-10px); opacity: .8; } }

  .stage {
    position: relative; z-index: 1; min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 40px 20px; perspective: 1100px;
  }
  .tilt { transform-style: preserve-3d; transition: transform .25s ease-out; width: 100%; max-width: 360px; }

  .shield-3d { width: 62px; height: 62px; margin: 0 auto 22px; perspective: 500px; transform: translateZ(30px); }
  .shield-3d-inner { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; animation: shieldSpin 11s linear infinite; }
  .shield-face { position: absolute; inset: 0; clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); }
  .shield-face.front { background: linear-gradient(135deg, var(--teal), var(--blue)); transform: translateZ(9px); }
  .shield-face.back  { background: var(--panel); border: 1px solid rgba(45,212,191,.5); transform: translateZ(-9px) rotateY(180deg); }
  .shield-ring { position: absolute; inset: -12px; border: 1px solid rgba(45,212,191,.28); border-radius: 50%; transform: rotateX(72deg); animation: ringSpin 6s linear infinite reverse; }
  @keyframes shieldSpin { to { transform: rotateY(360deg); } }
  @keyframes ringSpin { to { transform: rotateX(72deg) rotateZ(360deg); } }

  /* Variante miniature du bouclier 3D, pour le logo de la sidebar */
  .shield-3d-mini { width: 32px; height: 32px; margin: 0; perspective: 300px; transform: none; flex-shrink: 0; }
  .shield-3d-mini .shield-face.front { transform: translateZ(5px); }
  .shield-3d-mini .shield-face.back  { transform: translateZ(-5px) rotateY(180deg); }
  .shield-3d-mini .shield-ring { inset: -6px; }

  .login-card {
    position: relative;
    background: var(--card-bg);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 14px; padding: 30px 26px;
    box-shadow: 0 30px 60px -20px var(--card-shadow), 0 0 0 1px rgba(13,148,136,.04);
  }
  .login-card::before, .login-card::after, .login-corner-bl, .login-corner-br {
    content: ''; position: absolute; width: 16px; height: 16px;
    border-color: rgba(45,212,191,.55); border-style: solid; border-width: 0;
    pointer-events: none;
  }
  .login-card::before { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; border-radius: 4px 0 0 0; }
  .login-card::after  { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; border-radius: 0 4px 0 0; }
  .login-corner-bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 0 0 0 4px; }
  .login-corner-br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; border-radius: 0 0 4px 0; }

  .login-head { text-align: center; margin-bottom: 22px; }
  .login-title {
    display: inline-block; font-family: var(--font-display); font-size: 22px; font-weight: 700;
    letter-spacing: .5px;
    background: linear-gradient(135deg, var(--teal), var(--blue));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .login-step { display: none; }
  .login-step.active { display: block; }

  .field { margin-bottom: 14px; }
  .field label {
    display: block; font-size: 10.5px; color: var(--text2); font-family: var(--font-mono);
    margin-bottom: 5px; text-transform: uppercase; letter-spacing: .6px;
  }
  .field input {
    width: 100%; background: var(--bg2); border: 1px solid var(--border);
