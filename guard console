// ── ALERTES ──────────────────────────────────────────────
async function renderAlerts(el) {
  const url = currentFilter === 'all'
    ? `${API}/api/alerts?limit=200`
    : `${API}/api/alerts?severity=${currentFilter}&limit=200`;
  const alerts = await authFetch(url).then(r=>r.json());

  el.innerHTML = `
    <div class="alerts-panel">
      <div class="alert-filters">
        <span style="font-size:11px;color:var(--text3);font-family:var(--font-mono)">Filtre :</span>
        ${['all','critical','high','medium','low'].map(f => `
          <button class="filter-btn f-${f} ${currentFilter===f?'active':''}"
            onclick="currentFilter='${f}';renderAlerts(document.getElementById('content'))">
            ${f==='all'?'Tout':f}
          </button>`).join('')}
        <span style="margin-left:auto;font-size:11px;color:var(--text3);font-family:var(--font-mono)">${alerts.length} résultat(s)</span>
      </div>
      ${renderAlertsTable(alerts)}
    </div>
  `;
  await restoreExpandedAlertDetails();
}

