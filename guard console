    </div>

    <div class="panel">
      <div class="panel-head">Indicateurs de compromission (IoC) — moteur de détection</div>
      <div style="padding:14px 16px;border-bottom:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
        <div>
          <label style="display:block;font-size:10px;color:var(--text3);margin-bottom:4px;text-transform:uppercase">Type</label>
          <select id="ioc-type" style="background:var(--bg2);border:1px solid var(--border);color:var(--text1);border-radius:6px;padding:6px 8px;font-size:12px">
            <option value="hash">Hash SHA-256</option>
            <option value="ip">Adresse IP</option>
            <option value="cmdline_pattern">Motif de ligne de commande (regex)</option>
          </select>
        </div>
        <div style="flex:1;min-width:160px">
          <label style="display:block;font-size:10px;color:var(--text3);margin-bottom:4px;text-transform:uppercase">Valeur</label>
          <input id="ioc-value" placeholder="ex: 44d88612fea8a8f36de82e1278abb02f" style="width:100%;background:var(--bg2);border:1px solid var(--border);color:var(--text1);border-radius:6px;padding:6px 8px;font-size:12px">
        </div>
        <div>
          <label style="display:block;font-size:10px;color:var(--text3);margin-bottom:4px;text-transform:uppercase">Sévérité</label>
          <select id="ioc-severity" style="background:var(--bg2);border:1px solid var(--border);color:var(--text1);border-radius:6px;padding:6px 8px;font-size:12px">
            <option value="critical">Critique</option>
            <option value="high" selected>Haute</option>
            <option value="medium">Moyenne</option>
            <option value="low">Basse</option>
          </select>
        </div>
        <div style="flex:2;min-width:160px">
          <label style="display:block;font-size:10px;color:var(--text3);margin-bottom:4px;text-transform:uppercase">Description</label>
          <input id="ioc-description" placeholder="ex: Hash connu du ransomware X" style="width:100%;background:var(--bg2);border:1px solid var(--border);color:var(--text1);border-radius:6px;padding:6px 8px;font-size:12px">
        </div>
        <button class="ack-btn" onclick="addIoc()" style="color:var(--teal);height:29px">+ Ajouter</button>
      </div>
      <div style="max-height:280px;overflow-y:auto">
        ${!iocs.length ? '<div class="empty" style="padding:20px">Aucun IoC configuré</div>' : `
        <table class="alerts-table">
          <thead><tr><th>Type</th><th>Valeur</th><th>Sévérité</th><th>Description</th><th></th></tr></thead>
          <tbody>
            ${iocs.map(i => `
              <tr>
                <td><span class="cat">${i.type}</span></td>
                <td style="font-family:var(--font-mono);font-size:11px;word-break:break-all;max-width:220px">${i.value}</td>
                <td><span class="sev sev-${i.severity}">${i.severity}</span></td>
