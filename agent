def get_local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        return s.getsockname()[0]
    except Exception:
        return "127.0.0.1"
    finally:
        s.close()


_geo_cache = {"public_ip": None, "city": None, "region": None, "country": None}
_geo_last_fetch = 0
GEO_REFRESH_SECONDS = 3600  # la localisation ne change pas souvent, on évite de la re-demander à chaque heartbeat


def get_geolocation():
    """Récupère IP publique + localisation approximative (ville/pays) via un
    service gratuit, mis en cache 1h. Purement informatif pour le dashboard
    (savoir depuis où une machine se connecte) — aucune donnée précise
    (rue, coordonnées GPS exactes) n'est demandée ni transmise."""
    global _geo_last_fetch
    now = time.time()
    if _geo_cache["public_ip"] and (now - _geo_last_fetch) < GEO_REFRESH_SECONDS:
        return dict(_geo_cache)
    try:
        r = requests.get("https://ipapi.co/json/", timeout=5)
        if r.status_code == 200:
            data = r.json()
            _geo_cache.update({
                "public_ip": data.get("ip"),
                "city": data.get("city"),
                "region": data.get("region"),
                "country": data.get("country_name"),
            })
            _geo_last_fetch = now
    except requests.RequestException:
        pass  # pas grave si indisponible, le heartbeat continue sans géolocalisation
    return dict(_geo_cache)


def get_logged_in_user():
    try:
        users = psutil.users()
        return users[0].name if users else None
    except Exception:
        return None


def get_top_processes(limit=25):
    procs = []
    for p in psutil.process_iter(["pid", "name", "username", "cpu_percent", "memory_percent"]):
        try:
            info = p.info
            procs.append({
                "pid": info["pid"],
                "name": info.get("name") or "?",
                "user": (info.get("username") or "?").split("\\")[-1],
                "cpu_percent": round(info.get("cpu_percent") or 0, 1),
                "memory_percent": round(info.get("memory_percent") or 0, 1),
            })
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
    procs.sort(key=lambda x: (x["cpu_percent"], x["memory_percent"]), reverse=True)
    return procs[:limit]


