def _redirect_output_if_no_console():
    """Sous pythonw.exe (lancé sans fenêtre) ou un .exe --windowed,
    sys.stdout/stderr valent None : on redirige vers un fichier log."""
    if sys.stdout is None or sys.stderr is None:
        if platform.system() == "Windows":
            base = os.environ.get("APPDATA", os.path.expanduser("~"))
        else:
            base = os.path.join(os.path.expanduser("~"), ".config")
        folder = os.path.join(base, APP_NAME)
        os.makedirs(folder, exist_ok=True)
        log_file = open(os.path.join(folder, "agent.log"), "a", encoding="utf-8", buffering=1)
        sys.stdout = log_file
        sys.stderr = log_file


_redirect_output_if_no_console()


def _log(msg):
    """Point d'émission UNIQUE des logs opérateur de l'agent (console, ou
    agent.log en mode fenêtré — voir _redirect_output_if_no_console) :
    préfixe chaque ligne d'un horodatage ISO 8601, pour que agent.log
    reste exploitable a posteriori (avant, seule la ligne de statut
    périodique portait un horodatage manuel — toutes les autres lignes,
    y compris les erreurs, n'en avaient aucun). N'écrit JAMAIS ailleurs
    que la sortie déjà en place (console ou fichier redirigé ci-dessus) —
    pas un nouveau système de logs, juste une structure minimale sur
    celui qui existe déjà."""
    print(f"{datetime.utcnow().isoformat(timespec='seconds')} {msg}")


