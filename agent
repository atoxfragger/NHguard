# ──────────────────────────────────────────────────────────
# Coopération avec edr_watchdog.py — voir sa docstring pour le principe
# général. `taskkill /F` (terminaison inconditionnelle) ne peut être
# intercepté par AUCUN code utilisateur, par conception du système
# d'exploitation : ce mécanisme ne peut donc pas EMPÊCHER une coupure
# forcée, seulement la DISTINGUER d'un arrêt volontaire — en déposant un
# marqueur juste avant de s'arrêter PROPREMENT (Ctrl+C, fermeture de
# console, arrêt de service/déconnexion). Le watchdog, lui, constate
# l'absence de ce marqueur après une disparition inattendue et le
# signale au serveur — la différence entre "l'attaquant a coupé la
# télémétrie sans laisser de trace" et "le dashboard l'affiche
# immédiatement".
# ──────────────────────────────────────────────────────────
GRACEFUL_SHUTDOWN_MARKER = "graceful_shutdown.flag"


