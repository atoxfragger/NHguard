def fetch_iocs(cfg):
    """Récupère la liste des IoC de l'organisation et les indexe par type
    pour une recherche rapide à chaque cycle de scan."""
    headers = {"X-Agent-Key": cfg["api_key"]}
    try:
        r = requests.get(f"{cfg['server_url']}/api/agents/iocs", headers=headers, timeout=5)
        if r.status_code != 200:
            return
        iocs = r.json()
        hashes, ips, patterns = {}, {}, []
        for ioc in iocs:
            if ioc["type"] == "hash":
                hashes[ioc["value"].lower()] = ioc
            elif ioc["type"] == "ip":
                ips[ioc["value"]] = ioc
            elif ioc["type"] == "cmdline_pattern":
                try:
                    patterns.append((re.compile(ioc["value"], re.IGNORECASE), ioc))
                except re.error:
                    pass  # motif invalide fourni par l'admin -> ignoré silencieusement
        _iocs_cache["hash"] = hashes
        _iocs_cache["ip"] = ips
        _iocs_cache["cmdline_pattern"] = patterns
        print(f"[IoC] {len(hashes)} hash, {len(ips)} IP, {len(patterns)} motifs chargés")
    except requests.RequestException as e:
        print(f"[!] Impossible de récupérer les IoC : {e}")


# ──────────────────────────────────────────────────────────
# Isolation réseau (nécessite les droits administrateur)
# ──────────────────────────────────────────────────────────
def isolate_network(cfg):
    """Bloque tout le trafic sortant/entrant SAUF vers le serveur EDR,
    via des règles de pare-feu Windows nommées (facilement identifiables
    et supprimables). Retourne (succès, message)."""
    if platform.system() != "Windows":
        return False, "Isolation réseau seulement implémentée pour Windows"
    try:
        server_host = cfg["server_url"].split("//")[-1].split(":")[0].split("/")[0]
        subprocess.run([
            "netsh", "advfirewall", "firewall", "add", "rule",
            f"name={FIREWALL_RULE_PREFIX}-allow-server", "dir=out", "action=allow",
            f"remoteip={server_host}",
        ], check=True, capture_output=True, timeout=10)
        subprocess.run([
            "netsh", "advfirewall", "firewall", "add", "rule",
            f"name={FIREWALL_RULE_PREFIX}-block-out", "dir=out", "action=block",
        ], check=True, capture_output=True, timeout=10)
        subprocess.run([
            "netsh", "advfirewall", "firewall", "add", "rule",
            f"name={FIREWALL_RULE_PREFIX}-block-in", "dir=in", "action=block",
        ], check=True, capture_output=True, timeout=10)
        return True, "Machine isolée : tout le trafic est bloqué sauf vers le serveur EDR"
    except subprocess.CalledProcessError as e:
        return False, f"Échec (droits administrateur requis ?) : {e}"
    except Exception as e:
        return False, f"Erreur inattendue : {e}"


def unisolate_network(cfg):
    if platform.system() != "Windows":
        return False, "Isolation réseau seulement implémentée pour Windows"
    try:
        for suffix in ("allow-server", "block-out", "block-in"):
            subprocess.run([
                "netsh", "advfirewall", "firewall", "delete", "rule",
                f"name={FIREWALL_RULE_PREFIX}-{suffix}",
            ], capture_output=True, timeout=10)
        return True, "Isolement levé, trafic réseau normal restauré"
    except Exception as e:
        return False, f"Erreur inattendue : {e}"


