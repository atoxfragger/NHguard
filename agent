# Boucle de détection principale
# ──────────────────────────────────────────────────────────
def scan_processes(cfg):
    for proc in psutil.process_iter(["pid", "name", "ppid"]):
        try:
            name = (proc.info.get("name") or "").lower()
            pid = proc.info["pid"]
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue

        detection_key = f"{name}:{pid}"
        if detection_key in _already_alerted:
            continue

        # 1. Liste de noms connus
        if name in SUSPICIOUS_PROCESS_NAMES:
            severity, category, description = SUSPICIOUS_PROCESS_NAMES[name]
            handle_detection(cfg, proc, f"Processus suspect détecté : {name}",
                              description, severity, category, "Nom de processus connu comme malveillant",
                              extra_signals={"known_bad_name": True})
            _already_alerted.add(detection_key)
            continue

        # 2. IoC — hash du fichier exécutable
        try:
            exe_path = proc.exe()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            exe_path = None
        if exe_path:
            digest = hash_file(exe_path)
            if digest and digest.lower() in _iocs_cache["hash"]:
                ioc = _iocs_cache["hash"][digest.lower()]
                handle_detection(cfg, proc, f"Hash malveillant connu : {name}",
                                  ioc.get("description", "Correspond à un IoC de type hash"),
                                  ioc.get("severity", "high"), "malware",
                                  f"SHA-256 {digest[:16]}… présent dans la base d'IoC",
                                  extra_signals={"ioc_hash_match": True})
                _already_alerted.add(detection_key)
                continue

        # 3. IoC + motifs intégrés — ligne de commande
        try:
            cmdline = " ".join(proc.cmdline())
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            cmdline = ""
        if cmdline:
            matched = None
            matched_via_ioc = False
            for pattern, ioc in _iocs_cache["cmdline_pattern"]:
                if pattern.search(cmdline):
                    matched = (ioc.get("severity", "high"), "malware", ioc.get("description", "Motif IoC"))
                    matched_via_ioc = True
                    break
            if not matched:
                for pattern, sev, cat, desc in BUILTIN_CMDLINE_PATTERNS:
                    if re.search(pattern, cmdline, re.IGNORECASE):
                        matched = (sev, cat, desc)
                        break
            if matched:
                severity, category, description = matched
                signal_key = "ioc_cmdline_match" if matched_via_ioc else "builtin_cmdline_match"
                handle_detection(cfg, proc, f"Ligne de commande suspecte : {name}",
                                  description, severity, category, "Motif détecté dans la ligne de commande",
                                  extra_signals={signal_key: True})
                _already_alerted.add(detection_key)
                continue

        # 4. LOLBins — application bureautique lançant un interpréteur de script
        if name in SCRIPT_INTERPRETERS:
            try:
                parent = proc.parent()
                parent_name = parent.name().lower() if parent else ""
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                parent_name = ""
            if parent_name in OFFICE_APPS:
                handle_detection(cfg, proc, f"Comportement LOLBin : {parent_name} → {name}",
                                  "Une application bureautique a lancé un interpréteur de script — "
                                  "signature classique de macro malveillante",
                                  "high", "defense_evasion",
                                  f"{parent_name} a créé le processus {name}",
                                  extra_signals={"lolbin_parent_child": True})
                _already_alerted.add(detection_key)
                continue

        # 5. IoC — adresses IP en connexion sortante
        if _iocs_cache["ip"]:
            try:
                for conn in proc.connections(kind="inet"):
                    if conn.raddr and conn.raddr.ip in _iocs_cache["ip"]:
                        ioc = _iocs_cache["ip"][conn.raddr.ip]
                        handle_detection(cfg, proc, f"Connexion vers une IP malveillante connue : {name}",
                                          ioc.get("description", "Adresse IP présente dans la base d'IoC"),
                                          ioc.get("severity", "high"), "network",
                                          f"Connexion sortante vers {conn.raddr.ip}:{conn.raddr.port}",
                                          extra_signals={"ioc_ip_match": True})
                        _already_alerted.add(detection_key)
                        break
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass


def main():
    global _cycle_count
    cfg = get_config()
    print("── Agent NHGuard démarré ──")
    print(f"Identifiant : {cfg['agent_id']}")
    print(f"Serveur     : {cfg['server_url']}")
    print(f"Quarantaine : {quarantine_dir()}")
    print(f"Config      : {config_path()}")
    print("Ctrl+C pour arrêter.\n")

    fetch_iocs(cfg)

    while True:
        stats = collect_system_stats(cfg["agent_id"])
        send_heartbeat(cfg, stats)
        scan_processes(cfg)
        poll_and_execute_commands(cfg)

        _cycle_count += 1
        if _cycle_count % IOC_REFRESH_EVERY_N_CYCLES == 0:
            fetch_iocs(cfg)

        print(f"[{time.strftime('%H:%M:%S')}] CPU {stats['cpu_percent']}% · "
              f"RAM {stats['ram_percent']}% · Disque {stats['disk_percent']}%")
        time.sleep(REPORT_INTERVAL_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAgent arrêté.")
