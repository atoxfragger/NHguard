def agent_data_dir():
    """Dossier de données propres à l'agent (config, file locale
    event_queue.db, logs) — voir aussi event_queue._app_data_dir(), même
    calcul, dupliqué volontairement pour ne pas coupler agent.py à
    event_queue.py au-delà de son API publique. Utilisé notamment par
    collect_file_events() pour EXCLURE ce dossier de la télémétrie
    fichiers : %APPDATA% est un des dossiers surveillés, et sans cette
    exclusion l'agent se mettrait à rapporter ses propres écritures dans
    sa file locale comme si c'était un évènement observé sur la machine —
    un bruit auto-référentiel constaté en testant."""
    if platform.system() == "Windows":
        base = os.environ.get("APPDATA", os.path.expanduser("~"))
    else:
        base = os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, APP_NAME)


def config_path():
    folder = agent_data_dir()
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, "config.json")


def quarantine_dir():
    if platform.system() == "Windows":
        base = os.environ.get("PROGRAMDATA", r"C:\ProgramData")
    else:
        base = "/var/tmp"
    folder = os.path.join(base, APP_NAME, "Quarantine")
    os.makedirs(folder, exist_ok=True)
    return folder


def load_config():
    path = config_path()
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return None


def save_config(server_url, api_key, agent_id):
    with open(config_path(), "w", encoding="utf-8") as f:
        json.dump({"server_url": server_url, "api_key": api_key, "agent_id": agent_id}, f)


