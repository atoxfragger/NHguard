def send_command_result(cfg, command_id, status, result=""):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    try:
        requests.post(f"{cfg['server_url']}/api/agents/commands/{command_id}/result",
                       json={"status": status, "result": result}, headers=headers, timeout=5)
    except requests.RequestException as e:
        _log(f"[!] Serveur injoignable pour rapporter le résultat : {e}")


def poll_and_execute_commands(cfg):
    headers = {"X-Agent-Key": cfg["api_key"]}
    try:
        r = requests.get(f"{cfg['server_url']}/api/agents/commands",
                          params={"agent_id": cfg["agent_id"]}, headers=headers, timeout=5)
        if r.status_code != 200:
            return
        commands = r.json()
    except requests.RequestException as e:
        _log(f"[!] Serveur injoignable pour les commandes : {e}")
        return

    for cmd in commands:
        action = cmd["action"]
        params = cmd.get("params", {})
        _log(f"[COMMANDE] {action} {params}")

        if action == "isolate":
            ok, msg = isolate_network(cfg)
        elif action == "unisolate":
            ok, msg = unisolate_network(cfg)
        elif action == "kill_process":
            ok, msg = _execute_kill_process(params.get("pid"))
        elif action == "restore_file":
            ok, msg = _execute_restore_file(params.get("quarantine_path"), params.get("original_path"))
        elif action == "quarantine_file":
            ok, msg = _execute_quarantine_file(cfg, params)
        else:
            ok, msg = False, f"Action inconnue : {action}"

        _log(f"[COMMANDE {'OK' if ok else 'ÉCHEC'}] {msg}")
        send_command_result(cfg, cmd["id"], "done" if ok else "failed", msg)


def _execute_kill_process(pid):
    if not pid:
        return False, "pid manquant"
    try:
        p = psutil.Process(int(pid))
        name = p.name()
        p.terminate()
        p.wait(timeout=3)
        return True, f"Processus {name} (PID {pid}) arrêté"
    except psutil.NoSuchProcess:
        return True, "Processus déjà arrêté"
    except (psutil.AccessDenied, psutil.TimeoutExpired) as e:
        return False, f"Impossible d'arrêter le processus : {e}"
    except Exception as e:
        return False, f"Erreur inattendue : {e}"


def _execute_quarantine_file(cfg, params):
    """Mise en quarantaine MANUELLE, demandée depuis le dashboard — soit
    via un PID (on résout le chemin de l'exécutable et on arrête le
    processus d'abord), soit via un chemin de fichier direct (aucun
    processus à arrêter, juste le fichier)."""
    pid = params.get("pid")
    path = params.get("path")
    reason = params.get("reason", "Mise en quarantaine manuelle")
    severity = params.get("severity", "medium")
    process_stopped = False
    proc_name = None

    if pid and not path:
        try:
            p = psutil.Process(int(pid))
            proc_name = p.name()
            path = p.exe()
            p.terminate()
            p.wait(timeout=3)
            process_stopped = True
        except psutil.NoSuchProcess:
            return False, "Processus introuvable (déjà arrêté ?) et aucun chemin de fichier fourni"
        except (psutil.AccessDenied, psutil.TimeoutExpired) as e:
            return False, f"Impossible d'accéder au processus : {e}"

    if not path:
        return False, "Aucun chemin de fichier déterminé"

    quarantine_path, moved = quarantine_file(path)
    if not moved:
        return False, f"Échec du déplacement de {path} (fichier absent ou verrouillé)"

    action = "process_terminated" if process_stopped else "manual_quarantine"
    send_quarantine(cfg, path, reason, action, severity,
                     quarantine_path=quarantine_path, file_moved=True)
    label = proc_name or os.path.basename(path)
    return True, f"{label} mis en quarantaine ({path} → {quarantine_path})"


def _execute_restore_file(quarantine_path, original_path):
    if not quarantine_path or not original_path:
        return False, "chemins manquants"
    try:
        if not os.path.exists(quarantine_path):
            return False, "Fichier introuvable en quarantaine (peut-être déjà restauré)"
        os.makedirs(os.path.dirname(original_path), exist_ok=True)
        shutil.move(quarantine_path, original_path)
        return True, f"Fichier restauré à {original_path}"
    except Exception as e:
        return False, f"Échec de la restauration : {e}"


# ──────────────────────────────────────────────────────────
# Détection : ancêtres de processus (pour la Process Timeline)
# ──────────────────────────────────────────────────────────
def build_scoring_ancestry(proc, max_levels=4):
    """Construit la lignée (du plus ancien ancêtre vers le processus
    détecté) au format attendu par process_scoring.score_ancestry() :
    liste de {"name", "path", "user", "integrity_level", "session_id",
    "signed", "age_seconds"} — les 5 derniers champs sont optionnels
    (None si indisponibles) pour rester compatible avec tout appelant qui
    ne fournirait que name/path (ex: données de démo de db_data.py).
    Séparée de build_process_ancestry() (qui produit les évènements de la
    Process Timeline) car le format et l'usage sont différents.

    Le contexte enrichi (utilisateur, niveau d'intégrité, session,
    signature, âge) n'est calculé QUE pour rendre le scoring parent/enfant
    contextuel plutôt que purement nominal (cf. process_scoring.py) — pas
    de coût significatif : cette fonction n'est appelée qu'au moment
    d'une détection déjà confirmée, jamais dans la boucle de scan de
    routine sur tous les processus."""
    chain = []
    now = time.time()
    try:
        current = proc
        for _ in range(max_levels):
            try:
                name = current.name()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                break
            try:
                path = current.exe()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                path = None
            try:
                user = current.username()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                user = None
            try:
                age_seconds = max(0.0, now - current.create_time())
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                age_seconds = None
            chain.append({
                "name": name, "path": path, "user": user,
                "integrity_level": get_integrity_level(current.pid),
                "session_id": get_session_id(current.pid),
                "signed": is_authenticode_signed(path) if path else None,
                "age_seconds": age_seconds,
            })
            try:
                parent = current.parent()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                parent = None
            if parent is None:
                break
            current = parent
    except Exception:
        pass
    chain.reverse()
    return chain


def count_sibling_interpreters(proc):
    """Combien d'AUTRES interpréteurs (cmd, powershell, wscript...) le
    même parent a-t-il actuellement en cours d'exécution ? Signal de
    comportement anormal (cf. process_scoring.py, point 12 du document
    source : un parent qui lance plusieurs interpréteurs différents)."""
    try:
        parent = proc.parent()
        if not parent:
            return 0
        count = 0
        for sibling in parent.children():
            if sibling.pid == proc.pid:
                continue
            try:
                if sibling.name().lower() in process_scoring.INTERPRETER_NAMES:
                    count += 1
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
        return count
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        return 0


def build_process_ancestry(proc, max_levels=4):
    chain = []
    try:
        current = proc
        for _ in range(max_levels):
            try:
                parent = current.parent()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                parent = None
            chain.append((current, parent))
            if parent is None:
                break
            current = parent
    except Exception:
        pass
    chain.reverse()

    events = []
    for child, parent in chain:
        try:
            child_name = child.name()
            child_pid = child.pid
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
        parent_name = parent_pid = None
        if parent:
            try:
                parent_name = parent.name()
                parent_pid = parent.pid
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass
        events.append({
            "event_type": "process", "pid": child_pid, "parent_pid": parent_pid,
            "process_name": child_name, "parent_name": parent_name, "detail": None,
        })

    try:
        for conn in proc.connections(kind="inet"):
            if conn.raddr:
                events.append({
                    "event_type": "network", "pid": proc.pid, "parent_pid": None,
                    "process_name": proc.name(), "parent_name": None,
                    "detail": f"{conn.raddr.ip}:{conn.raddr.port}",
                })
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        pass

    return events


def is_persistence_path(file_path):
    """Le fichier a-t-il été déposé dans un emplacement de démarrage
    automatique classique (dossier Startup) ?"""
    if not file_path:
        return False
    p = file_path.lower().replace("/", "\\")
    return "\\startup\\" in p or "\\start menu\\programs\\startup" in p


def is_admin_or_system_user(username):
    if not username:
        return False
    u = username.lower()
    return u in ("system", "administrator", "administrateur") or "admin" in u


def is_server_asset(agent_id):
    """Heuristique simple : les machines nommées avec un préfixe serveur
    (SRV-..., convention utilisée dans nos données de démo) sont
    considérées comme des actifs plus sensibles."""
    return bool(agent_id) and ("srv" in agent_id.lower() or "server" in agent_id.lower())


# Heures "de bureau" typiques (heure LOCALE de la machine — un poste
# éteint le soir puis rallumé au petit matin ne doit pas se faire
# marquer "hors horaires" à chaque démarrage). Volontairement large
# (7h-20h, jours ouvrés) : le but est de repérer une activité NETTEMENT
# atypique (3h du matin, dimanche), pas de pénaliser le télétravail tardif.
OFF_HOURS_START_HOUR = 7
OFF_HOURS_END_HOUR = 20


def is_off_hours(now=None):
    """Contexte, pas une preuve : une exécution à 3h du matin n'est
    malveillante que combinée à d'AUTRES signaux (voir IMPACT_CONTRIBUTION
    dans risk_engine.py — ce signal ne peut jamais, à lui seul, créer une
    détection). now : datetime LOCALE optionnelle, pour des tests
    déterministes — par défaut l'instant présent réel de la machine."""
    now = now or datetime.now()
    if now.weekday() >= 5:  # samedi=5, dimanche=6
        return True
    return not (OFF_HOURS_START_HOUR <= now.hour < OFF_HOURS_END_HOUR)


# Ports historiquement associés à des outils d'exploitation/C2 ou des
# backdoors connues — une correspondance ici est un signal FAIBLE
# (contrairement à un IoC IP, qui est une correspondance confirmée) :
# rien n'empêche un usage légitime d'un de ces ports, mais leur usage
# RÉEL et documenté par des outils malveillants reste rare en usage
# normal, contrairement par ex. au port 443. Volontairement une petite
# liste curatée plutôt qu'une tentative d'exhaustivité illusoire — voir
# le même principe que pour antivirus_engine.py (honnête sur ce qui est
# couvert plutôt que de prétendre à une couverture qu'on ne peut pas tenir).
SUSPICIOUS_PORTS = {
    4444,   # Metasploit / reverse shell par défaut
    1337, 31337,  # backdoors "elite" historiques
    6666, 6667,   # IRC — vecteur classique de botnets
    12345, 12346,  # NetBus
    20034,  # NetBus 2 Pro
    54321,  # Back Orifice 2000
}


def has_suspicious_destination_port(proc):
    """Le processus a-t-il une connexion sortante ACTIVE vers un port de
    SUSPICIOUS_PORTS ? Best-effort : proc.connections() peut échouer
    (accès refusé, processus déjà terminé) sans que ce soit un signal en
    soi — voir le même traitement pour le reste des collecteurs de
    edr_agent.py."""
    try:
        for conn in proc.connections(kind="inet"):
            if conn.raddr and conn.raddr.port in SUSPICIOUS_PORTS:
                return True
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        pass
    return False


def hash_file(path, chunk_size=65536):
    if path in _hash_cache:
        return _hash_cache[path]
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(chunk_size), b""):
                h.update(chunk)
        digest = h.hexdigest()
        _hash_cache[path] = digest
        return digest
    except Exception:
        return None


