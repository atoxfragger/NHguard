def send_heartbeat(cfg, stats):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/report", json=stats, headers=headers, timeout=5)
        if r.status_code == 401:
            print("[!] Clé API rejetée par le serveur — vérifiez la configuration.")
        elif r.status_code != 200:
            print(f"[!] Erreur heartbeat ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        print(f"[!] Serveur injoignable : {e}")


def send_alert(cfg, title, description, severity, category, signals=None):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    payload = {
        "title": title, "description": description,
        "severity": severity, "category": category, "agent_id": cfg["agent_id"],
        "signals": signals or {},
    }
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/alert", json=payload, headers=headers, timeout=5)
        if r.status_code == 201:
            resp = r.json()
            computed = f" (Risk Engine: score={resp.get('score')}, sévérité={resp.get('severity')})" if resp.get('score') is not None else ""
            print(f"[ALERTE ENVOYÉE] {title}{computed}")
            return resp.get("id")
        print(f"[!] Erreur envoi alerte ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        print(f"[!] Serveur injoignable : {e}")
    return None


def send_quarantine(cfg, file_path, reason, action, severity, quarantine_path=None, file_moved=False):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    payload = {
        "file_path": file_path, "reason": reason, "action": action,
        "severity": severity, "agent_id": cfg["agent_id"],
        "quarantine_path": quarantine_path, "file_moved": file_moved,
    }
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/quarantine", json=payload, headers=headers, timeout=5)
        if r.status_code == 201:
            print(f"[QUARANTAINE] {file_path} ({action}, déplacé={file_moved})")
        else:
            print(f"[!] Erreur envoi quarantaine ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        print(f"[!] Serveur injoignable : {e}")


def send_process_events(cfg, alert_id, events):
