# ──────────────────────────────────────────────────────────
def build_scoring_ancestry(proc, max_levels=4):
    """Construit la lignée (du plus ancien ancêtre vers le processus
    détecté) au format attendu par process_scoring.score_ancestry() :
    liste de {"name": str, "path": str|None}. Séparée de
    build_process_ancestry() (qui produit les évènements de la Process
    Timeline) car le format et l'usage sont différents."""
    chain = []
    try:
        current = proc
        for _ in range(max_levels):
            try:
                name = current.name()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                break
            try:
                path = current.exe()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                path = None
            chain.append({"name": name, "path": path})
            try:
                parent = current.parent()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                parent = None
            if parent is None:
                break
            current = parent
    except Exception:
        pass
    chain.reverse()
    return chain


def count_sibling_interpreters(proc):
    """Combien d'AUTRES interpréteurs (cmd, powershell, wscript...) le
    même parent a-t-il actuellement en cours d'exécution ? Signal de
    comportement anormal (cf. process_scoring.py, point 12 du document
    source : un parent qui lance plusieurs interpréteurs différents)."""
    try:
        parent = proc.parent()
        if not parent:
            return 0
        count = 0
        for sibling in parent.children():
            if sibling.pid == proc.pid:
                continue
            try:
                if sibling.name().lower() in process_scoring.INTERPRETER_NAMES:
                    count += 1
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
        return count
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        return 0


def build_process_ancestry(proc, max_levels=4):
    chain = []
    try:
        current = proc
        for _ in range(max_levels):
            try:
                parent = current.parent()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                parent = None
            chain.append((current, parent))
            if parent is None:
                break
            current = parent
    except Exception:
        pass
    chain.reverse()

    events = []
    for child, parent in chain:
        try:
            child_name = child.name()
            child_pid = child.pid
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
        parent_name = parent_pid = None
        if parent:
            try:
                parent_name = parent.name()
                parent_pid = parent.pid
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass
        events.append({
            "event_type": "process", "pid": child_pid, "parent_pid": parent_pid,
            "process_name": child_name, "parent_name": parent_name, "detail": None,
        })

    try:
        for conn in proc.connections(kind="inet"):
            if conn.raddr:
                events.append({
                    "event_type": "network", "pid": proc.pid, "parent_pid": None,
                    "process_name": proc.name(), "parent_name": None,
                    "detail": f"{conn.raddr.ip}:{conn.raddr.port}",
                })
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        pass

    return events


def is_ms_system_path(file_path):
    """Le fichier se trouve-t-il dans un dossier système Windows courant ?
    Heuristique simple (pas une vraie vérification de signature Authenticode,
    qui demanderait une bibliothèque supplémentaire) — sert de proxy
    raisonnable pour le signal 'file_ms_signed_path' du Risk Engine."""
    if not file_path:
        return False
    p = file_path.lower().replace("/", "\\")
    return "\\windows\\system32\\" in p or "\\windows\\syswow64\\" in p


def is_persistence_path(file_path):
    """Le fichier a-t-il été déposé dans un emplacement de démarrage
    automatique classique (dossier Startup) ?"""
    if not file_path:
        return False
    p = file_path.lower().replace("/", "\\")
    return "\\startup\\" in p or "\\start menu\\programs\\startup" in p


def is_admin_or_system_user(username):
    if not username:
        return False
    u = username.lower()
    return u in ("system", "administrator", "administrateur") or "admin" in u


def is_server_asset(agent_id):
    """Heuristique simple : les machines nommées avec un préfixe serveur
    (SRV-..., convention utilisée dans nos données de démo) sont
    considérées comme des actifs plus sensibles."""
    return bool(agent_id) and ("srv" in agent_id.lower() or "server" in agent_id.lower())


def hash_file(path, chunk_size=65536):
    if path in _hash_cache:
        return _hash_cache[path]
    try:
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(chunk_size), b""):
                h.update(chunk)
        digest = h.hexdigest()
        _hash_cache[path] = digest
        return digest
    except Exception:
        return None


def quarantine_file(file_path):
    """Déplace RÉELLEMENT le fichier vers le dossier de quarantaine local.
    Retourne (quarantine_path, file_moved)."""
    if not file_path or not os.path.exists(file_path):
        return None, False
    try:
        dest_name = f"{os.path.basename(file_path)}.{int(time.time())}.quarantined"
        dest_path = os.path.join(quarantine_dir(), dest_name)
        shutil.move(file_path, dest_path)
        return dest_path, True
    except Exception as e:
        print(f"[!] Échec du déplacement en quarantaine : {e}")
        return None, False


def handle_detection(cfg, proc, title, description, severity, category, reason, extra_signals=None):
    """Point d'entrée unique pour toute détection, quelle que soit la règle
    qui l'a déclenchée (nom connu, hash, motif de commande, LOLBin...).
    Capture l'ascendance AVANT d'agir, arrête le processus, met le fichier
    en quarantaine pour de vrai, construit les signaux du Risk Engine, puis
    remonte tout au serveur (qui calcule le score et la sévérité finale)."""
    try:
        file_path = proc.exe()
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        file_path = None
    try:
        proc_name = proc.name().lower()
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        proc_name = ""

    ancestry_events = build_process_ancestry(proc)
    ancestry_events.append({
        "event_type": "file", "pid": proc.pid, "parent_pid": None,
        "process_name": proc.name() if proc.is_running() else title,
        "parent_name": None, "detail": f"Exécutable : {file_path or 'inconnu'}",
    })

    # Scoring de lignée complet (réputation, parent/grand-parent, chemin,
    # interpréteurs frères) — capturé AVANT de tuer le processus, sinon
    # proc.parent()/exe()/connections() ne répondent plus après terminate().
    scoring_ancestry = build_scoring_ancestry(proc)
    sibling_count = count_sibling_interpreters(proc)
    ancestry_score = process_scoring.score_ancestry(scoring_ancestry, sibling_count)

    try:
        proc.terminate()
        proc.wait(timeout=3)
        process_stopped = True
    except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.TimeoutExpired):
        process_stopped = False

    quarantine_path, file_moved = (None, False)
    if process_stopped and file_path:
        quarantine_path, file_moved = quarantine_file(file_path)

    action = "process_terminated" if process_stopped else "detected_only"

    # Construction des signaux factuels pour le Risk Engine du serveur —
    # l'agent ne décide plus lui-même de la sévérité, il décrit juste ce
    # qu'il a observé. process_scoring REMPLACE les catégories process/
    # parent_child/file plutôt que de s'y ajouter (évite le double comptage).
    signals = {
        "process_scoring": ancestry_score,
        "persistence_path": is_persistence_path(file_path),
        "admin_or_system_user": is_admin_or_system_user(get_logged_in_user()),
        "server_asset": is_server_asset(cfg.get("agent_id")),
    }
    if extra_signals:
        signals.update(extra_signals)

    alert_id = send_alert(cfg, title, f"{description} — {reason}", severity, category, signals=signals)
    send_quarantine(cfg, file_path or "(chemin inconnu)", reason, action, severity,
                     quarantine_path=quarantine_path, file_moved=file_moved)
    send_process_events(cfg, alert_id, ancestry_events)


