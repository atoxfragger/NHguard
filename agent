def agent_data_dir():
    """Dossier de données propres à l'agent (config, file locale
    event_queue.db, logs) — voir aussi event_queue._app_data_dir(), même
    calcul, dupliqué volontairement pour ne pas coupler agent.py à
    event_queue.py au-delà de son API publique. Utilisé notamment par
    collect_file_events() pour EXCLURE ce dossier de la télémétrie
    fichiers : %APPDATA% est un des dossiers surveillés, et sans cette
    exclusion l'agent se mettrait à rapporter ses propres écritures dans
    sa file locale comme si c'était un évènement observé sur la machine —
    un bruit auto-référentiel constaté en testant."""
    if platform.system() == "Windows":
        base = os.environ.get("APPDATA", os.path.expanduser("~"))
    else:
        base = os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, APP_NAME)


def config_path():
    folder = agent_data_dir()
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, "config.json")


def quarantine_dir():
    if platform.system() == "Windows":
        base = os.environ.get("PROGRAMDATA", r"C:\ProgramData")
    else:
        base = "/var/tmp"
    folder = os.path.join(base, APP_NAME, "Quarantine")
    os.makedirs(folder, exist_ok=True)
    return folder


def harden_folder_permissions(path):
    """Restreint l'accès à un dossier sensible (file locale, quarantaine,
    config) à SYSTEM et Administrateurs — retire les permissions
    héritées par défaut, qui incluent souvent le compte utilisateur
    courant. Protège contre un malware s'exécutant SANS privilège élevé
    (le cas le plus courant en pratique) qui tenterait de supprimer la
    file locale ou les fichiers en quarantaine pour effacer ses traces.

    N'arrête PAS un attaquant qui a DÉJÀ les mêmes privilèges que
    l'agent (SYSTEM/Administrateur) — aucune protection en espace
    utilisateur ne le peut (voir GRACEFUL_SHUTDOWN_MARKER plus haut sur
    la même limite face à `taskkill /F`). Utilise le SID générique
    *S-1-5-32-544 pour "Administrateurs" plutôt que le nom du groupe,
    qui varie selon la langue du système (Administrators/Administrateurs/...)."""
    if not _IS_WINDOWS or not os.path.isdir(path):
        return False
    try:
        subprocess.run(
            ["icacls", path, "/inheritance:r",
             "/grant:r", "SYSTEM:(OI)(CI)F", "*S-1-5-32-544:(OI)(CI)F",
             "/T", "/C"],
            capture_output=True, text=True, timeout=15, check=False,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        return True
    except (subprocess.SubprocessError, OSError):
        return False


def load_config():
    path = config_path()
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return None


