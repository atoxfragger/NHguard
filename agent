            f.write(datetime.utcnow().isoformat(timespec="seconds"))
    except OSError:
        pass


if _IS_WINDOWS:
    # CTRL_CLOSE_EVENT=2 (fermeture de la fenêtre console), CTRL_LOGOFF_EVENT=5,
    # CTRL_SHUTDOWN_EVENT=6 (arrêt de la machine) — Ctrl+C (CTRL_C_EVENT=0) est
    # déjà couvert côté Python par KeyboardInterrupt, voir tout en bas du fichier.
    _CONSOLE_CTRL_HANDLER_TYPE = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.DWORD)

    def _console_ctrl_handler(ctrl_type):
        if ctrl_type in (2, 5, 6):
            _write_graceful_marker()
        return False  # ne bloque jamais le traitement normal de l'évènement par Windows

    _console_ctrl_handler_ref = _CONSOLE_CTRL_HANDLER_TYPE(_console_ctrl_handler)
    _kernel32.SetConsoleCtrlHandler(_console_ctrl_handler_ref, True)


def _self_file_path():
    """Chemin du fichier actuellement exécuté : l'exécutable figé par
    PyInstaller (voir build_agent.bat) s'il est "frozen", sinon ce
    script source — c'est CE fichier dont l'intégrité est vérifiée par
    check_self_integrity()."""
    if getattr(sys, "frozen", False):
        return sys.executable
    return os.path.abspath(__file__)


def _integrity_baseline_path():
    return os.path.join(agent_data_dir(), "integrity.json")


def check_self_integrity(cfg):
    """Compare le hash du fichier actuellement exécuté à une référence
    enregistrée lors du tout premier lancement. Ne peut RIEN EMPÊCHER —
    un attaquant avec les mêmes droits que l'agent peut modifier le
    fichier ET cette référence dans la foulée — mais détecte un
    changement qui N'est PAS passé par une mise à jour légitime
    (_consume_applied_update(), appelée juste avant CETTE fonction dans
    main(), rafraîchit explicitement la référence après une mise à jour
    vérifiée par hash — voir check_for_update()). Mieux vaut une
    détection contournable par un attaquant averti que ne rien détecter
    du tout. Appelé une seule fois au démarrage (voir main()), pas à
    chaque cycle — hasher tout le binaire toutes les 15s serait un
    gaspillage pour quelque chose qui ne change quasiment jamais hors
    mise à jour."""
    path = _self_file_path()
    current_hash = hash_file(path)
    if not current_hash:
        return

    baseline_path = _integrity_baseline_path()
    try:
        with open(baseline_path, "r", encoding="utf-8") as f:
            baseline = json.load(f)
    except (OSError, json.JSONDecodeError):
        baseline = None

    if baseline is None or baseline.get("path") != path:
        # Premier lancement (ou changement de mode script/exe) : on
        # enregistre la référence, rien à signaler encore.
        _write_integrity_baseline(baseline_path, path, current_hash)
        return

    if baseline.get("hash") != current_hash:
        ev = event_schema.make_event(
            "agent_tampered", cfg["agent_id"], event_queue.next_seq(),
            data={"path": path, "expected_hash": baseline.get("hash"), "actual_hash": current_hash},
            os_name=platform.system(),
        )
        event_queue.enqueue(ev)
        # Ne re-signale pas en boucle à chaque redémarrage tant que le
        # fichier ne change plus — une alerte par changement constaté.
        _write_integrity_baseline(baseline_path, path, current_hash)


def _write_integrity_baseline(baseline_path, path, file_hash):
    try:
        with open(baseline_path, "w", encoding="utf-8") as f:
            json.dump(
                {"path": path, "hash": file_hash, "recorded_at": datetime.utcnow().isoformat(timespec="seconds")},
                f,
            )
    except OSError:
        pass


# ──────────────────────────────────────────────────────────
# Mise à jour automatique — voir edr_watchdog.py pour la moitié
# "échange réel du fichier" du mécanisme (impossible depuis CE
# processus : le fichier .exe en cours d'exécution est verrouillé par
# Windows tant qu'il tourne). Cette moitié-ci ne fait que : vérifier
# s'il existe une version plus récente, la télécharger dans un dossier
# de préparation, vérifier son empreinte sha256 contre celle annoncée
# par le serveur (rejette silencieusement en cas de désaccord — reste
# sur la version actuelle plutôt que d'exécuter un binaire dont
# l'origine n'est plus garantie), puis déposer un marqueur et
# s'arrêter PROPREMENT (comme un Ctrl+C) pour laisser le watchdog
# faire l'échange une fois le verrou de fichier libéré.
# N'a de sens que pour un exécutable figé (voir build_agent.bat) —
# un script source se met à jour en éditant le fichier, pas en se
# remplaçant lui-même.
# ──────────────────────────────────────────────────────────
UPDATE_READY_MARKER = "update_ready.json"


def _update_ready_marker_path():
    return os.path.join(agent_data_dir(), UPDATE_READY_MARKER)


class _RestartForUpdate(Exception):
    """Signal interne : une mise à jour vérifiée est prête, il faut
    s'arrêter proprement pour laisser edr_watchdog.py l'appliquer."""


def check_for_update(cfg):
    if not getattr(sys, "frozen", False):
        return  # rien à remplacer pour un lancement en script source

    try:
        resp = requests.get(
            f"{cfg['server_url']}/api/agents/update-check",
            params={"version": AGENT_VERSION},
            headers={"X-Agent-Key": cfg["api_key"]}, timeout=15,
        )
        if resp.status_code != 200:
            return
        info = resp.json()
    except (requests.RequestException, ValueError):
        return
    if not info.get("update_available"):
        return

    staging_dir = os.path.join(agent_data_dir(), "update_staging")
    staged_path = os.path.join(staging_dir, f"EDRAgent.exe.{info['version']}.new")
    try:
        os.makedirs(staging_dir, exist_ok=True)
        dl = requests.get(
            f"{cfg['server_url']}/api/agents/update-download",
            headers={"X-Agent-Key": cfg["api_key"]}, timeout=180,
        )
        if dl.status_code != 200:
            return
        with open(staged_path, "wb") as f:
            f.write(dl.content)
    except (requests.RequestException, OSError):
        return

    # hash_file() met en cache par chemin — chemin unique par version ci-
    # dessus, donc jamais de collision avec un téléchargement précédent.
    actual_hash = hash_file(staged_path)
    if actual_hash != info.get("sha256"):
        _log(f"[update] Empreinte inattendue pour la version {info['version']} — abandon, "
              f"conservation de la version actuelle.")
        try:
            os.remove(staged_path)
        except OSError:
            pass
        return

    try:
        with open(_update_ready_marker_path(), "w", encoding="utf-8") as f:
            json.dump({"version": info["version"], "staged_path": staged_path, "sha256": actual_hash}, f)
    except OSError:
        return

    _log(f"[update] Version {info['version']} vérifiée et prête — redémarrage pour l'appliquer.")
    raise _RestartForUpdate()


def _consume_applied_update():
    """Appelé au tout début de main(), AVANT check_self_integrity() :
    si une mise à jour vient d'être appliquée par le watchdog (le
    fichier actuellement exécuté correspond au sha256 qu'on avait
    nous-même vérifié avant de s'arrêter), rafraîchit silencieusement
    la référence d'intégrité — sinon check_self_integrity() prendrait
    ce changement légitime pour une falsification."""
    marker_path = _update_ready_marker_path()
    try:
        with open(marker_path, "r", encoding="utf-8") as f:
            marker = json.load(f)
    except (OSError, json.JSONDecodeError):
        return

    current_hash = hash_file(_self_file_path())
    if current_hash and current_hash == marker.get("sha256"):
        _write_integrity_baseline(_integrity_baseline_path(), _self_file_path(), current_hash)
        _log(f"[update] Version {marker.get('version')} appliquée avec succès.")
    # Sinon : marqueur périmé ou incohérent (ex. l'agent a été relancé
    # sans passer par le watchdog) — laissé tel quel, sans y toucher ;
    # ce n'est PAS à l'agent de décider s'il s'agit d'une anomalie.

    try:
        os.remove(marker_path)
    except OSError:
        pass


def get_integrity_level(pid):
    """Niveau d'intégrité Windows du processus (untrusted/low/medium/high/
    system), lu depuis son jeton d'accès — signal utile pour repérer une
    élévation de privilège entre un parent et son enfant (cf.
    process_scoring.py). None si non-Windows, accès refusé (processus
    d'un autre compte sans droits suffisants) ou processus déjà terminé —
    jamais une supposition à la place d'une mesure réelle."""
    if not _IS_WINDOWS:
        return None
    h_process = _kernel32.OpenProcess(_PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
    if not h_process:
        return None
    try:
        h_token = wintypes.HANDLE()
        if not _advapi32.OpenProcessToken(h_process, _TOKEN_QUERY, ctypes.byref(h_token)):
            return None
        try:
            size = wintypes.DWORD(0)
            _advapi32.GetTokenInformation(h_token, _TOKEN_INTEGRITY_LEVEL, None, 0, ctypes.byref(size))
            if size.value == 0:
                return None
            buf = ctypes.create_string_buffer(size.value)
            if not _advapi32.GetTokenInformation(h_token, _TOKEN_INTEGRITY_LEVEL, buf, size, ctypes.byref(size)):
                return None
            # TOKEN_MANDATORY_LABEL.Label.Sid est le premier champ de la structure (un pointeur).
            sid_ptr = ctypes.cast(buf, ctypes.POINTER(ctypes.c_void_p))[0]
            count = _advapi32.GetSidSubAuthorityCount(sid_ptr).contents.value
            rid = _advapi32.GetSidSubAuthority(sid_ptr, count - 1).contents.value
            return _INTEGRITY_LEVELS.get(rid & 0xFFFFF000)
        finally:
            _kernel32.CloseHandle(h_token)
    except Exception:
        return None
    finally:
        _kernel32.CloseHandle(h_process)


def get_session_id(pid):
    """Session Windows (0 = session des services, 1+ = session interactive/
    RDP) du processus. None si non-Windows ou processus déjà terminé."""
    if not _IS_WINDOWS:
        return None
    try:
        session_id = wintypes.DWORD()
        if _kernel32.ProcessIdToSessionId(wintypes.DWORD(pid), ctypes.byref(session_id)):
            return session_id.value
        return None
    except Exception:
        return None


def is_authenticode_signed(path):
    """True si le fichier a une signature Authenticode embarquée valide et
    vérifiée (WinVerifyTrust renvoie ERROR_SUCCESS) — un signal de
    confiance FORT. Renvoie None dans tous les autres cas (non-Windows,
    pas de signature embarquée, chaîne de certification non vérifiable,
    fichier introuvable) — PAS False.

    ⚠️ Testé sur cette machine : de nombreux binaires Windows légitimes
    (notepad.exe, powershell.exe v1.0...) sont signés par CATALOGUE plutôt
    qu'avec une signature embarquée, et WinVerifyTrust renvoie alors
    TRUST_E_NOSIGNATURE pour eux exactement comme pour un binaire non
    signé — ce contrôle ne peut donc PAS distinguer "légitime mais
    catalogué" de "potentiellement malveillant non signé". C'est
    précisément pourquoi ce module ne renvoie jamais False : traiter ce
    résultat ambigu comme une preuve de malveillance produirait des faux
    positifs sur des binaires système parfaitement sains."""
    if not _IS_WINDOWS or not path:
        return None
    try:
        file_info = _WINTRUST_FILE_INFO()
        file_info.cbStruct = ctypes.sizeof(_WINTRUST_FILE_INFO)
        file_info.pcwszFilePath = path
        file_info.hFile = None
        file_info.pgKnownSubject = None

        data = _WINTRUST_DATA()
        ctypes.memset(ctypes.byref(data), 0, ctypes.sizeof(data))
        data.cbStruct = ctypes.sizeof(_WINTRUST_DATA)
        data.dwUIChoice = _WTD_UI_NONE
        data.fdwRevocationChecks = _WTD_REVOKE_NONE
        data.dwUnionChoice = _WTD_CHOICE_FILE
        data.pFile = ctypes.cast(ctypes.byref(file_info), ctypes.c_void_p)
        data.dwStateAction = _WTD_STATEACTION_VERIFY

        result = _wintrust.WinVerifyTrust(
            None, ctypes.byref(_WINTRUST_ACTION_GENERIC_VERIFY_V2), ctypes.byref(data)
        )
        # Libère l'état interne de la vérification (requis par l'API, sans
        # quoi WinVerifyTrust fuit de la mémoire à chaque appel).
        data.dwStateAction = _WTD_STATEACTION_CLOSE
        _wintrust.WinVerifyTrust(None, ctypes.byref(_WINTRUST_ACTION_GENERIC_VERIFY_V2), ctypes.byref(data))

        return True if result == 0 else None
    except Exception:
        return None


def quarantine_file(file_path):
    """Déplace RÉELLEMENT le fichier vers le dossier de quarantaine local.
    Retourne (quarantine_path, file_moved)."""
    if not file_path or not os.path.exists(file_path):
        return None, False
    try:
        dest_name = f"{os.path.basename(file_path)}.{int(time.time())}.quarantined"
        dest_path = os.path.join(quarantine_dir(), dest_name)
        shutil.move(file_path, dest_path)
        return dest_path, True
    except Exception as e:
        _log(f"[!] Échec du déplacement en quarantaine : {e}")
        return None, False


def handle_detection(cfg, proc, title, description, severity, category, reason, extra_signals=None):
    """Point d'entrée unique pour toute détection, quelle que soit la règle
    qui l'a déclenchée (nom connu, hash, motif de commande, LOLBin...).
    Capture l'ascendance AVANT d'agir, arrête le processus, met le fichier
    en quarantaine pour de vrai, construit les signaux du Risk Engine, puis
    remonte tout au serveur (qui calcule le score et la sévérité finale)."""
    try:
        file_path = proc.exe()
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        file_path = None
    try:
        proc_name = proc.name().lower()
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        proc_name = ""
    try:
        leaf_cmdline = " ".join(proc.cmdline())
    except (psutil.NoSuchProcess, psutil.AccessDenied):
        leaf_cmdline = None
    # hash_file() est mis en cache par chemin : si scan_processes() l'a déjà
    # calculé pour vérifier un IoC de hash, cet appel ne recalcule rien.
    leaf_hash = hash_file(file_path) if file_path else None

    ancestry_events = build_process_ancestry(proc)
    ancestry_events.append({
        "event_type": "file", "pid": proc.pid, "parent_pid": None,
        "process_name": proc.name() if proc.is_running() else title,
        "parent_name": None, "detail": f"Exécutable : {file_path or 'inconnu'}",
    })

    # Scoring de lignée complet (réputation, parent/grand-parent, chemin,
    # interpréteurs frères) — capturé AVANT de tuer le processus, sinon
    # proc.parent()/exe()/connections() ne répondent plus après terminate().
    scoring_ancestry = build_scoring_ancestry(proc)
    sibling_count = count_sibling_interpreters(proc)
    ancestry_score = process_scoring.score_ancestry(
        scoring_ancestry, sibling_count, leaf_cmdline=leaf_cmdline, leaf_hash=leaf_hash
    )
    suspicious_port = has_suspicious_destination_port(proc)  # aussi AVANT terminate()

    try:
        proc.terminate()
        proc.wait(timeout=3)
        process_stopped = True
    except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.TimeoutExpired):
        process_stopped = False

    quarantine_path, file_moved = (None, False)
    if process_stopped and file_path:
        quarantine_path, file_moved = quarantine_file(file_path)

    action = "process_terminated" if process_stopped else "detected_only"

    # Construction des signaux factuels pour le Risk Engine du serveur —
    # l'agent ne décide plus lui-même de la sévérité, il décrit juste ce
    # qu'il a observé. process_scoring REMPLACE les catégories process/
    # parent_child/file plutôt que de s'y ajouter (évite le double comptage).
    signals = {
        "process_scoring": ancestry_score,
        "persistence_path": is_persistence_path(file_path),
        "admin_or_system_user": is_admin_or_system_user(get_logged_in_user()),
        "server_asset": is_server_asset(cfg.get("agent_id")),
        "off_hours": is_off_hours(),
        "network_suspicious_port": suspicious_port,
    }
    if extra_signals:
        signals.update(extra_signals)

    alert_id = send_alert(cfg, title, f"{description} — {reason}", severity, category, signals=signals)
    send_quarantine(cfg, file_path or "(chemin inconnu)", reason, action, severity,
                     quarantine_path=quarantine_path, file_moved=file_moved)
    send_process_events(cfg, alert_id, ancestry_events)


# ──────────────────────────────────────────────────────────
# Boucle de détection principale
# ──────────────────────────────────────────────────────────
def scan_processes(cfg):
    for proc in psutil.process_iter(["pid", "name", "ppid"]):
        try:
            name = (proc.info.get("name") or "").lower()
            pid = proc.info["pid"]
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue

        detection_key = f"{name}:{pid}"
        if detection_key in _already_alerted:
            continue

        # 1. Liste de noms connus
        if name in SUSPICIOUS_PROCESS_NAMES:
            severity, category, description = SUSPICIOUS_PROCESS_NAMES[name]
            handle_detection(cfg, proc, f"Processus suspect détecté : {name}",
                              description, severity, category, "Nom de processus connu comme malveillant",
                              extra_signals={"known_bad_name": True})
            _already_alerted.add(detection_key)
            continue

        # 2. IoC — hash du fichier exécutable
        try:
            exe_path = proc.exe()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            exe_path = None
        if exe_path:
            digest = hash_file(exe_path)
            if digest and digest.lower() in _iocs_cache["hash"]:
                ioc = _iocs_cache["hash"][digest.lower()]
                handle_detection(cfg, proc, f"Hash malveillant connu : {name}",
                                  ioc.get("description", "Correspond à un IoC de type hash"),
                                  ioc.get("severity", "high"), "malware",
                                  f"SHA-256 {digest[:16]}… présent dans la base d'IoC",
                                  extra_signals={"ioc_hash_match": True})
                _already_alerted.add(detection_key)
                continue

        # 3. IoC + motifs intégrés — ligne de commande
        try:
            cmdline = " ".join(proc.cmdline())
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            cmdline = ""
        if cmdline:
            matched = None
            matched_via_ioc = False
            for pattern, ioc in _iocs_cache["cmdline_pattern"]:
                if pattern.search(cmdline):
                    matched = (ioc.get("severity", "high"), "malware", ioc.get("description", "Motif IoC"))
                    matched_via_ioc = True
                    break
            if not matched:
                for pattern, sev, cat, desc in BUILTIN_CMDLINE_PATTERNS:
                    if re.search(pattern, cmdline, re.IGNORECASE):
                        matched = (sev, cat, desc)
                        break
            if matched:
                severity, category, description = matched
                signal_key = "ioc_cmdline_match" if matched_via_ioc else "builtin_cmdline_match"
                handle_detection(cfg, proc, f"Ligne de commande suspecte : {name}",
                                  description, severity, category, "Motif détecté dans la ligne de commande",
                                  extra_signals={signal_key: True})
                _already_alerted.add(detection_key)
                continue

        # 4. LOLBins — application bureautique lançant un interpréteur de script
        if name in SCRIPT_INTERPRETERS:
            try:
                parent = proc.parent()
                parent_name = parent.name().lower() if parent else ""
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                parent_name = ""
            if parent_name in OFFICE_APPS:
                handle_detection(cfg, proc, f"Comportement LOLBin : {parent_name} → {name}",
                                  "Une application bureautique a lancé un interpréteur de script — "
                                  "signature classique de macro malveillante",
                                  "high", "defense_evasion",
                                  f"{parent_name} a créé le processus {name}",
                                  extra_signals={"lolbin_parent_child": True})
                _already_alerted.add(detection_key)
                continue

        # 5. IoC — adresses IP en connexion sortante
        if _iocs_cache["ip"]:
            try:
                for conn in proc.connections(kind="inet"):
                    if conn.raddr and conn.raddr.ip in _iocs_cache["ip"]:
                        ioc = _iocs_cache["ip"][conn.raddr.ip]
                        handle_detection(cfg, proc, f"Connexion vers une IP malveillante connue : {name}",
                                          ioc.get("description", "Adresse IP présente dans la base d'IoC"),
                                          ioc.get("severity", "high"), "network",
                                          f"Connexion sortante vers {conn.raddr.ip}:{conn.raddr.port}",
                                          extra_signals={"ioc_ip_match": True})
                        _already_alerted.add(detection_key)
                        break
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass


# ──────────────────────────────────────────────────────────
# Collecteurs de télémétrie CONTINUE — indépendants de toute détection,
# contrairement à scan_processes() ci-dessus (qui ne s'active que sur un
# comportement déjà jugé suspect). Ici : "voici ce qui s'est passé", pas
# "voici ce qui est malveillant" — la décision reste entièrement au
# serveur (Temporal Correlator -> Behaviour Engine -> Risk Engine).
#
# Limite assumée : cet agent tourne en espace utilisateur pur, sans hook
# noyau/ETW ni pilote filtre. Les collecteurs ci-dessous fonctionnent donc
# par COMPARAISON D'INSTANTANÉS entre deux cycles (toutes les
# REPORT_INTERVAL_SECONDS) plutôt qu'en vrai temps réel :
#   - Process, Réseau, Registre (persistance), Utilisateur/session : cette
#     approche capture correctement les évènements qui durent au moins un
#     cycle, ce qui couvre la quasi-totalité des cas utiles pour la
#     détection à l'échelle de temps de temporal_correlator.py.
#   - PAS de collecteur Fichiers ni DNS applicatif ici : un vrai suivi
#     temps réel du système de fichiers demanderait une dépendance
#     supplémentaire (ex: watchdog/ReadDirectoryChangesW) avec un vrai
#     travail de calibrage (quels dossiers surveiller, exclusions, volume)
#     qui n'a pas été fait ni testé — mieux vaut l'annoncer clairement que
#     livrer un collecteur qui ne surveille en réalité presque rien. La
#     visibilité DNS ci-dessous (collect_network_events) n'est qu'un
#     PROXY : elle voit qu'une connexion vers le port 53 a eu lieu, pas
#     le nom de domaine résolu (ça demanderait un hook du résolveur ou
#     une capture de paquets).
# ──────────────────────────────────────────────────────────

# None (pas encore de référence) plutôt que set() vide : sur le tout
# premier cycle, il ne faut PAS traiter "tous les processus déjà en cours"
# comme des "process_start" — ce serait une rafale de faux évènements de
# démarrage pour des processus qui tournaient déjà avant l'agent.
_prev_pids = None
_prev_connections = None
_prev_registry_snapshot = None
_prev_users = None
_prev_dns_records = None
# IP -> domaine, reconstruit à CHAQUE appel de collect_dns_events à partir
# de TOUT le cache résolveur courant (pas seulement les nouveautés) — sert
# à relier "DNS -> IP -> connexion réseau" dans collect_network_events,
# même si la résolution DNS a eu lieu plusieurs cycles plus tôt.
_ip_to_domain = {}
_prev_services = None
_prev_scheduled_tasks = None

_collector_health = {
    "process": "healthy", "network": "healthy", "registry": "healthy", "user": "healthy",
    "file": "healthy" if _IS_WINDOWS else "unavailable",
    "dns": "healthy" if _IS_WINDOWS else "unavailable",
    "service": "healthy" if _IS_WINDOWS else "unavailable",
    "scheduled_task": "healthy" if _IS_WINDOWS else "unavailable",
}

_SECRET_CMDLINE_PATTERN = re.compile(
    r"(?i)(password|passwd|pwd|secret|token|apikey|api[_-]?key|access[_-]?key)(\s*[=:]\s*)(\S+)"
)


def redact_cmdline(cmdline):
    """Masque les valeurs ressemblant à un mot de passe/jeton dans une
    ligne de commande avant sa mise en file — les lignes de commande
    peuvent contenir des secrets (cf. document source, section 9). Ne
    touche PAS aux motifs base64/-enc des interpréteurs : c'est justement
    ce contenu qui a une valeur de détection, à ne pas effacer."""
    if not cmdline:
        return cmdline
    return _SECRET_CMDLINE_PATTERN.sub(r"\1\2***REDACTED***", cmdline)


def _process_lineage(proc, max_levels=8):
    """Remonte la lignée d'un processus via psutil.parent() (jusqu'à
    max_levels crans, ou jusqu'à ne plus avoir de parent). Retourne
    (parent_name, grandparent_name, root_pid) :
      - parent_name/grandparent_name permettent de reconstruire une
        chaîne comme "WINWORD -> PowerShell -> cmd -> payload" à partir
        d'UN SEUL évènement process_start, sans dépendre du fait que le
        parent ait lui-même un évènement dans la fenêtre observée (il a
        pu démarrer avant l'agent, ou avant le début de la fenêtre).
      - root_pid (le plus ancien ancêtre encore accessible) sert
        d'identifiant de topologie STABLE pour regrouper tous les
        évènements d'un même arbre de processus (voir process_tree_id
        dans collect_process_events) — une étiquette structurelle, pas
        un jugement de sécurité : l'agent ne décide toujours rien, il
        se contente de nommer la forme de l'arbre qu'il observe."""
    parent_name = grandparent_name = None
    root_pid = proc.pid
    current = proc
    for level in range(max_levels):
        try:
            parent = current.parent()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            break
        if parent is None:
            break
        try:
            pname = parent.name()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            break
        if level == 0:
            parent_name = pname
        elif level == 1:
            grandparent_name = pname
        root_pid = parent.pid
        current = parent
    return parent_name, grandparent_name, root_pid


def collect_process_events(cfg):
    """process_start / process_exit en continu, par différence avec
    l'instantané du cycle précédent (voir note de section ci-dessus)."""
    global _prev_pids
    current = {}
    try:
        for p in psutil.process_iter(["pid"]):
            current[p.info["pid"]] = p
    except Exception:
        _collector_health["process"] = "stalled"
        return
    _collector_health["process"] = "healthy"

    current_pids = set(current.keys())
    if _prev_pids is None:
        _prev_pids = current_pids
        return

    for pid in current_pids - _prev_pids:
        proc = current.get(pid)
        if proc is None:
            continue
        try:
            name = proc.name()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
        try:
            ppid = proc.ppid()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            ppid = None
        try:
            path = proc.exe()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            path = None
        try:
            user = proc.username()
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            user = None
        try:
            cmdline = redact_cmdline(" ".join(proc.cmdline()))
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            cmdline = None
        try:
            creation_time = datetime.utcfromtimestamp(proc.create_time()).isoformat(timespec="seconds")
        except (psutil.NoSuchProcess, psutil.AccessDenied, OSError, OverflowError, ValueError):
            creation_time = None

        parent_name, grandparent_name, root_pid = _process_lineage(proc)

        ev = event_schema.make_event(
            "process_start", cfg["agent_id"], event_queue.next_seq(),
            actor={"pid": pid, "ppid": ppid, "user": user},
            data={
                "process": name, "path": path, "command_line": cmdline,
                "creation_time": creation_time,
                # hash_file() est mis en cache par chemin (voir sa
                # définition) : un même binaire relancé plusieurs fois ne
                # coûte le calcul du hash qu'une seule fois.
                "hash": hash_file(path) if path else None,
                "integrity_level": get_integrity_level(pid),
                "session_id": get_session_id(pid),
                "signed": is_authenticode_signed(path) if path else None,
                # Réutilise SCRIPT_INTERPRETERS (déjà la référence pour la
                # détection LOLBin, voir scan_processes) plutôt qu'un flux
                # d'évènements SCRIPT_EXECUTION séparé : chaque exécution
                # de script EST déjà un process_start, inutile de la
                # télémétrer deux fois — ce champ suffit à la distinguer.
                "is_script_interpreter": name.lower() in SCRIPT_INTERPRETERS,
                # Lignée (voir _process_lineage) : reconstruit une chaîne
                # complète depuis un seul évènement, et process_tree_id
                # regroupe tous les évènements d'un même arbre sans que le
                # serveur ait à déduire lui-même la topologie — l'agent ne
                # fait toujours que décrire ce qu'il voit, pas un jugement.
                "parent_name": parent_name,
                "grandparent_name": grandparent_name,
                "process_tree_id": f"{cfg['agent_id']}:{root_pid}",
            },
            os_name=platform.system(),
        )
        event_queue.enqueue(ev)

    for pid in _prev_pids - current_pids:
        ev = event_schema.make_event(
            "process_exit", cfg["agent_id"], event_queue.next_seq(),
            actor={"pid": pid, "ppid": None, "user": None}, data={},
            os_name=platform.system(),
        )
        event_queue.enqueue(ev)

    _prev_pids = current_pids


def collect_network_events(cfg):
    """network_connect en continu (proxy DNS sur le port 53 — voir note de
    section ci-dessus), par différence de connexions actives."""
    global _prev_connections
    try:
        conns = psutil.net_connections(kind="inet")
    except Exception:
        _collector_health["network"] = "stalled"
        return
    _collector_health["network"] = "healthy"

    current = {}
    for c in conns:
        if not c.raddr or not c.laddr:
            continue
        key = (c.pid, c.laddr.ip, c.laddr.port, c.raddr.ip, c.raddr.port)
        current[key] = c

    current_keys = set(current.keys())
    if _prev_connections is None:
        _prev_connections = current_keys
        return

    for key in current_keys - _prev_connections:
        c = current[key]
        pid, src_ip, src_port, dst_ip, dst_port = key
        proc_name = None
        if pid:
            try:
                proc_name = psutil.Process(pid).name()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass
        event_type = "dns_query" if dst_port == 53 else "network_connect"
        data = {
            "process": proc_name,
            "protocol": "UDP" if c.type == socket.SOCK_DGRAM else "TCP",
            "source_ip": src_ip, "source_port": src_port,
            "destination_ip": dst_ip, "destination_port": dst_port,
            # Relie DNS -> IP -> connexion (document source, section 4) en
            # consultant la table construite par collect_dns_events —
            # None si cette IP n'a pas été vue dans le cache résolveur
            # (résolution antérieure au démarrage de l'agent, résolution
            # côté serveur DNS interne non mise en cache localement, etc.)
            "resolved_domain": _ip_to_domain.get(dst_ip) if event_type == "network_connect" else None,
        }
        if event_type == "dns_query":
            # Distingue cette source (connexion vers le port 53 — donne le
            # pid mais pas le nom de domaine) de collect_dns_events
            # (cache résolveur Windows — donne le nom de domaine mais pas
            # le pid). Les deux sont complémentaires, voir sa docstring.
            data["source"] = "connection_proxy"
        ev = event_schema.make_event(
            event_type, cfg["agent_id"], event_queue.next_seq(),
            actor={"pid": pid, "ppid": None, "user": None},
            data=data, os_name=platform.system(),
        )
        event_queue.enqueue(ev)

    # Symétrique de la boucle ci-dessus : une connexion qui a disparu de
    # l'instantané s'est fermée — utile pour mesurer une durée de session
    # réseau, ou repérer une connexion anormalement longue/courte.
    for key in _prev_connections - current_keys:
        pid, src_ip, src_port, dst_ip, dst_port = key
        proc_name = None
        if pid:
            try:
                proc_name = psutil.Process(pid).name()
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                pass
        ev = event_schema.make_event(
            "network_disconnect", cfg["agent_id"], event_queue.next_seq(),
            actor={"pid": pid, "ppid": None, "user": None},
            data={
                "process": proc_name,
                "source_ip": src_ip, "source_port": src_port,
                "destination_ip": dst_ip, "destination_port": dst_port,
            },
            os_name=platform.system(),
        )
        event_queue.enqueue(ev)

    _prev_connections = current_keys


def _parse_displaydns(output):
    """Parse la sortie de `ipconfig /displaydns` (cache résolveur DNS de
    Windows, partagé par toute la machine) en liste de
    {"domain": str, "ip": str} — ne garde que les enregistrements A (type
    1) et AAAA (type 28), les résolutions directes ; ignore PTR/CNAME
    pour rester concentré sur "quel domaine a été résolu vers quelle IP"."""
    records = []
    current_name = None
    current_type = None
    for line in output.splitlines():
        line = line.strip()
        if not line or line.startswith("-"):
            continue
        low = line.lower()
        if low.startswith("record name"):
            current_name = line.split(":", 1)[-1].strip().rstrip(".")
            current_type = None
        elif low.startswith("record type"):
            try:
                current_type = int(line.split(":", 1)[-1].strip())
            except ValueError:
                current_type = None
        elif "record" in low and ":" in line and current_type in (1, 28):
            value = line.split(":", 1)[-1].strip()
            if current_name and value:
                records.append({"domain": current_name, "ip": value})
    return records


def collect_dns_events(cfg):
    """Interroge le cache résolveur DNS de Windows (ipconfig /displaydns,
    déjà présent sur toute installation Windows — aucune dépendance
    supplémentaire) et compare au cycle précédent — donne le vrai NOM DE
    DOMAINE résolu, contrairement au simple proxy "connexion vers le port
    53" de collect_network_events(). Limite assumée, documentée plutôt
    que cachée : ce cache est PARTAGÉ par toute la machine, pas par
    processus — impossible d'attribuer une résolution à un pid précis
    avec cette technique (il faudrait un hook du résolveur ou une
    capture de paquets, hors de portée d'un agent en espace utilisateur
    pur). Les deux collecteurs DNS sont donc complémentaires : celui-ci
    donne le domaine sans le pid, l'autre donne le pid sans le domaine."""
    global _prev_dns_records
    if not _IS_WINDOWS:
        return
    try:
        output = subprocess.check_output(
            ["ipconfig", "/displaydns"], text=True, errors="replace", timeout=10,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        records = _parse_displaydns(output)
    except Exception:
        _collector_health["dns"] = "stalled"
        return
    _collector_health["dns"] = "healthy"

    # Reconstruit la table de correspondance inverse à CHAQUE appel, même
    # cycles sans nouveauté — collect_network_events s'appuie dessus pour
    # relier une connexion à un domaine résolu, potentiellement plusieurs
    # cycles plus tôt.
    _ip_to_domain.clear()
    _ip_to_domain.update({r["ip"]: r["domain"] for r in records})

    current = {(r["domain"], r["ip"]) for r in records}
    if _prev_dns_records is None:
        _prev_dns_records = current
        return

    for domain, ip in current - _prev_dns_records:
        ev = event_schema.make_event(
            "dns_query", cfg["agent_id"], event_queue.next_seq(),
            data={"domain": domain, "resolved_ip": ip, "source": "resolver_cache"},
            os_name=platform.system(),
        )
        event_queue.enqueue(ev)

    _prev_dns_records = current


# Clés de démarrage automatique classiques — mêmes emplacements que ceux
# qu'un attaquant utilise le plus souvent pour la persistance (cf.
# document source, section 7 : "Run, RunOnce, Services, Policies,
# Winlogon" — Services/Policies/Winlogon nécessitent des clés
# supplémentaires plus larges, laissées à une itération future pour ne
# pas élargir la surveillance sans l'avoir calibrée).
_PERSISTENCE_KEYS = [
    ("HKLM", r"SOFTWARE\Microsoft\Windows\CurrentVersion\Run"),
    ("HKLM", r"SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce"),
    ("HKCU", r"SOFTWARE\Microsoft\Windows\CurrentVersion\Run"),
    ("HKCU", r"SOFTWARE\Microsoft\Windows\CurrentVersion\RunOnce"),
] if _IS_WINDOWS else []

_REGISTRY_HIVES = {"HKLM": winreg.HKEY_LOCAL_MACHINE, "HKCU": winreg.HKEY_CURRENT_USER} if _IS_WINDOWS else {}


def _read_registry_values(hive_name, subkey):
    values = {}
    try:
        with winreg.OpenKey(_REGISTRY_HIVES[hive_name], subkey) as key:
            i = 0
            while True:
                try:
                    name, data, _ = winreg.EnumValue(key, i)
                except OSError:
                    break
                values[name] = str(data)
                i += 1
    except OSError:
        pass  # clé absente (normal, toutes les clés ne sont pas toujours créées) — pas un signal
    return values


def _emit_persistence_event(cfg, event_type, method, key_path, value_name, value_data):
    """Point d'émission COMMUN aux mécanismes de persistance détectés par
    plusieurs collecteurs différents (registre, dossier de démarrage,
    service Windows, tâche planifiée) — `method` les distingue
    (registry_run_key / startup_folder / windows_service / scheduled_task)
    sans dupliquer la construction de l'évènement dans chacun."""
    ev = event_schema.make_event(
        event_type, cfg["agent_id"], event_queue.next_seq(),
        data={"method": method, "key": key_path, "name": value_name, "value": value_data},
        os_name=platform.system(),
    )
    event_queue.enqueue(ev)


def collect_persistence_events(cfg):
    """Compare un instantané des clés Run/RunOnce au cycle précédent —
    polling périodique, PAS un vrai hook temps réel (RegNotifyChangeKeyValue),
    suffisant à l'échelle de REPORT_INTERVAL_SECONDS (voir note de section
    plus haut). Une modification n'est PAS jugée malveillante ici — c'est
    de la télémétrie, exactement comme pour les modifications de fichiers
    (document source, section 7 : "ne considère pas automatiquement une
    modification du Registry comme malveillante")."""
    if not _IS_WINDOWS:
        return
    global _prev_registry_snapshot
    try:
        snapshot = {
            f"{hive}\\{subkey}": _read_registry_values(hive, subkey)
            for hive, subkey in _PERSISTENCE_KEYS
        }
    except Exception:
        _collector_health["registry"] = "stalled"
        return
    _collector_health["registry"] = "healthy"

    if _prev_registry_snapshot is None:
        _prev_registry_snapshot = snapshot
        return

    for label, values in snapshot.items():
        prev_values = _prev_registry_snapshot.get(label, {})
        for name, data in values.items():
            if name not in prev_values:
                _emit_persistence_event(cfg, "persistence_created", "registry_run_key", label, name, data)
            elif prev_values[name] != data:
                _emit_persistence_event(cfg, "persistence_modified", "registry_run_key", label, name, data)
        for name in prev_values:
            if name not in values:
                _emit_persistence_event(cfg, "persistence_removed", "registry_run_key", label, name, None)

    _prev_registry_snapshot = snapshot


def collect_service_events(cfg):
    """Compare un instantané des services Windows (psutil.win_service_iter,
    déjà une dépendance existante) au cycle précédent : un service
    NOUVEAU, ou dont le binpath change sur un service EXISTANT
    (détournement de service — remplacer l'exécutable d'un service légitime
    par un autre, technique de persistance/élévation classique), est
    rapporté. Même principe que collect_persistence_events : de la
    télémétrie, pas un jugement de malveillance."""
    global _prev_services
    if not _IS_WINDOWS:
        return
    try:
        current = {}
        for s in psutil.win_service_iter():
            try:
                current[s.name()] = s.binpath()
            except OSError:
                # Certains services renvoient une erreur du chargeur de
                # ressources Windows (fichier MUI introuvable) sur
                # QueryServiceConfigW — un service isolé en échec ne doit
                # pas faire perdre la visibilité sur tous les autres
                # (constaté en testant : "WinError 15100" sur ce type de
                # service, sans rapport avec sa légitimité).
                continue
    except Exception:
        _collector_health["service"] = "stalled"
        return
    _collector_health["service"] = "healthy"

    if _prev_services is None:
        _prev_services = current
        return

    for name, binpath in current.items():
        if name not in _prev_services:
            _emit_persistence_event(cfg, "persistence_created", "windows_service", name, "binpath", binpath)
        elif _prev_services[name] != binpath:
            _emit_persistence_event(cfg, "persistence_modified", "windows_service", name, "binpath", binpath)
    for name in _prev_services:
        if name not in current:
            _emit_persistence_event(cfg, "persistence_removed", "windows_service", name, "binpath", None)

    _prev_services = current


def collect_scheduled_task_events(cfg):
    """Compare un instantané des tâches planifiées (`schtasks /query`,
    déjà présent sur toute installation Windows) au cycle précédent — une
    tâche planifiée nouvelle ou supprimée est un mécanisme de persistance
    classique, au même titre qu'une clé de registre ou un service.
    `/fo csv` sans `/v` reste volontairement léger (nom + prochaine
    exécution + statut seulement) : suffisant pour détecter apparition/
    disparition, un luxe de détail (commande exacte exécutée) demanderait
    `/v` — nettement plus lourd sur une machine avec des centaines de
    tâches, laissé à une itération future si le besoin se confirme."""
    global _prev_scheduled_tasks
    if not _IS_WINDOWS:
        return
    try:
        output = subprocess.check_output(
            ["schtasks", "/query", "/fo", "csv"], text=True, errors="replace", timeout=15,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        reader = csv.reader(io.StringIO(output))
        rows = list(reader)
        current = {row[0] for row in rows[1:] if row}  # ignore l'en-tête, 1re colonne = nom de la tâche
    except Exception:
        _collector_health["scheduled_task"] = "stalled"
        return
    _collector_health["scheduled_task"] = "healthy"

    if _prev_scheduled_tasks is None:
        _prev_scheduled_tasks = current
        return

    for name in current - _prev_scheduled_tasks:
        _emit_persistence_event(cfg, "persistence_created", "scheduled_task", name, "task_name", name)
    for name in _prev_scheduled_tasks - current:
        _emit_persistence_event(cfg, "persistence_removed", "scheduled_task", name, "task_name", None)

    _prev_scheduled_tasks = current


def collect_user_events(cfg):
    """user_login / user_logout en continu, par différence de sessions
    utilisateur actives (voir note de section plus haut)."""
    global _prev_users
    try:
        users = {(u.name, u.terminal) for u in psutil.users()}
    except Exception:
        _collector_health["user"] = "stalled"
        return
    _collector_health["user"] = "healthy"

    if _prev_users is None:
        _prev_users = users
        return

    for name, terminal in users - _prev_users:
        ev = event_schema.make_event(
            "user_login", cfg["agent_id"], event_queue.next_seq(),
            actor={"pid": None, "ppid": None, "user": name},
            data={"terminal": terminal}, os_name=platform.system(),
        )
        event_queue.enqueue(ev)
    for name, terminal in _prev_users - users:
        ev = event_schema.make_event(
            "user_logout", cfg["agent_id"], event_queue.next_seq(),
            actor={"pid": None, "ppid": None, "user": name},
            data={"terminal": terminal}, os_name=platform.system(),
        )
        event_queue.enqueue(ev)

    _prev_users = users


# ──────────────────────────────────────────────────────────
# Collecteur FICHIERS — temps réel (ReadDirectoryChangesW via ctypes,
# aucune dépendance supplémentaire), contrairement aux autres collecteurs
# ci-dessus qui fonctionnent par différence d'instantanés. Validé en
# conditions réelles sur cette machine (création/modification/
# renommage/suppression, tous correctement capturés) avant intégration.
#
# Portée volontairement limitée à quelques dossiers sensibles plutôt que
# tout le disque — surveiller un disque entier en continu serait coûteux
# et noierait le signal utile dans du bruit (fichiers de cache, logs
# applicatifs...). Ce sont les emplacements où un malware dépose
# concrètement des fichiers : Téléchargements, Bureau, dossiers
# temporaires, AppData, et le dossier de démarrage automatique.
# ──────────────────────────────────────────────────────────
def _resolve_file_watch_dirs():
    if not _IS_WINDOWS:
        return []
    userprofile = os.environ.get("USERPROFILE", "")
    appdata = os.environ.get("APPDATA", "")
    localappdata = os.environ.get("LOCALAPPDATA", "")
    programdata = os.environ.get("PROGRAMDATA", r"C:\ProgramData")
    candidates = [
        os.path.join(userprofile, "Downloads") if userprofile else None,
        os.path.join(userprofile, "Desktop") if userprofile else None,
        os.environ.get("TEMP"),
        appdata or None,
        localappdata or None,
        os.path.join(appdata, "Microsoft", "Windows", "Start Menu", "Programs", "Startup") if appdata else None,
        os.path.join(programdata, "Microsoft", "Windows", "Start Menu", "Programs", "Startup"),
    ]
    return sorted({p for p in candidates if p and os.path.isdir(p)})


_FILE_WATCH_DIRS = _resolve_file_watch_dirs() if _IS_WINDOWS else []
_FILE_ACTION_TYPES = {1: "file_create", 2: "file_delete", 3: "file_modify", 4: "file_rename", 5: "file_rename"}
_FILE_ACTION_PHASE = {4: "old_name", 5: "new_name"}
_file_change_queue = _queue.Queue()  # alimentée par les threads de surveillance, vidée par collect_file_events
_file_watchers_started = False

# ──────────────────────────────────────────────────────────
# Couche EPP (prévention) — voir antivirus_engine.py pour le détail des
# deux mécanismes de détection (hash IoC + motifs de contenu/EICAR).
# _av_block_queue existe pour la MÊME raison que _file_change_queue :
# le scan + la mise en quarantaine tournent DANS le thread de
# surveillance (réaction immédiate, pas d'attente du cycle principal),
# mais tout ce qui touche réseau/base (alerte, évènement) est repoussé
# au thread principal via cette file thread-safe — aucun nouvel accès
# concurrent à event_queue.py ou requests n'est introduit.
# ──────────────────────────────────────────────────────────
_av_block_queue = _queue.Queue()


def _on_access_scan(path, action):
    """Appelée DIRECTEMENT depuis le thread de surveillance, pas depuis
    le cycle principal — la vitesse de réaction est tout l'intérêt de
    cette fonction (voir docstring du module antivirus_engine). Ne
    scanne que les créations/modifications (1, 3) : un fichier supprimé
    ou renommé n'a plus besoin d'être bloqué à cet instant précis."""
    if action not in (1, 3):
        return
    # Jamais scanner/mettre en quarantaine ses propres fichiers (queue.db,
    # integrity.json, binaire mis en attente par check_for_update...) —
    # même exclusion que collect_file_events, voir agent_data_dir().
    own_data_dir = os.path.normcase(os.path.normpath(agent_data_dir()))
    if os.path.normcase(os.path.normpath(path)).startswith(own_data_dir):
        return
    try:
        verdict = antivirus_engine.scan_file_for_threats(
            path, _iocs_cache.get("hash", {}), _iocs_cache.get("content_pattern", [])
        )
        if not verdict:
            return
        quarantine_path, moved = quarantine_file(path)
        _av_block_queue.put((path, verdict, quarantine_path, moved))
        _log(f"[AV] Bloqué à l'écriture : {path} ({verdict['kind']})")
    except Exception as e:
        # Ce thread ne doit JAMAIS mourir à cause d'un scan qui échoue —
        # la télémétrie fichier (voir _file_change_queue ci-dessous) doit
        # continuer même si le scan EPP rencontre un problème inattendu.
        _log(f"[!] Scan EPP en échec pour {path} : {e}")


def _watch_directory_thread(path):
    """Tourne en tâche de fond, UN thread PAR dossier surveillé : bloque
    sur l'appel SYNCHRONE ReadDirectoryChangesW (pas besoin
    d'OVERLAPPED/asynchrone ici, un thread dédié par dossier suffit vu le
    nombre restreint de dossiers surveillés) et empile chaque changement
    dans _file_change_queue pour que le cycle principal (non bloquant)
    les transforme en évènements. Scanne aussi chaque création/
    modification pour la couche EPP (_on_access_scan) AVANT de l'empiler
    — le blocage local ne doit pas attendre le prochain cycle."""
    h_dir = _kernel32.CreateFileW(
        path, _FILE_LIST_DIRECTORY, _FILE_SHARE_RWD, None,
        _OPEN_EXISTING, _FILE_FLAG_BACKUP_SEMANTICS, None,
    )
    if h_dir is None or h_dir == _INVALID_HANDLE_VALUE:
        _collector_health["file"] = "stalled"
        return

    buf = ctypes.create_string_buffer(8192)
    bytes_returned = wintypes.DWORD()
    try:
        while True:
            ok = _kernel32.ReadDirectoryChangesW(
                h_dir, buf, len(buf), True, _FILE_NOTIFY_CHANGE_MASK,
                ctypes.byref(bytes_returned), None, None,
            )
            if not ok:
                _collector_health["file"] = "stalled"
                return
            if bytes_returned.value == 0:
                continue
            raw = buf.raw
            offset = 0
            while True:
                next_offset, action, name_len = struct.unpack_from("<III", raw, offset)
                name = raw[offset + 12: offset + 12 + name_len].decode("utf-16-le", errors="replace")
                full_path = os.path.join(path, name)
                _on_access_scan(full_path, action)
                _file_change_queue.put((action, full_path))
                if next_offset == 0:
                    break
                offset += next_offset
    except Exception:
        _collector_health["file"] = "stalled"
    finally:
        _kernel32.CloseHandle(h_dir)


def start_file_watchers():
    """Démarre un thread de surveillance par dossier sensible — appelé
    UNE SEULE fois au démarrage de l'agent (voir main()). Aucun dossier
    résolu (profil utilisateur introuvable, machine atypique) dégrade
    gracieusement à "pas de télémétrie fichiers", jamais à un crash."""
    global _file_watchers_started
    if _file_watchers_started or not _IS_WINDOWS:
        return
    _file_watchers_started = True
    if not _FILE_WATCH_DIRS:
        _collector_health["file"] = "stalled"
        return
    for path in _FILE_WATCH_DIRS:
        threading.Thread(target=_watch_directory_thread, args=(path,), daemon=True).start()


# Extensions dignes d'un hash (exécutables/scripts — ce qui a une valeur
# de détection). Un document, une image, un log... n'est JAMAIS hashé :
# hasher systématiquement tout fichier touché alourdirait l'agent pour
# un bénéfice quasi nul (document source, section 3 : "ne hash pas
# inutilement tous les fichiers").
_HASHABLE_EXTENSIONS = {
    ".exe", ".dll", ".sys", ".scr", ".com", ".bat", ".cmd",
    ".ps1", ".psm1", ".vbs", ".vbe", ".js", ".jse", ".wsf", ".wsh",
    ".msi", ".msp", ".jar", ".hta",
}
# Au-delà de cette taille, seules les métadonnées sont remontées — même un
# fichier à l'extension "sensible" trop volumineux n'est pas hashé, pour
# ne jamais bloquer un cycle de collecte sur un gros fichier. Plafond
# volontairement bas (pas 50 Mo) : constaté en testant sur une machine
# avec une vraie activité disque de fond (cache d'un client de jeu en
# train de télécharger sous %LOCALAPPDATA%, l'un des dossiers surveillés)
# qu'un plafond généreux peut faire traîner un cycle de collecte de
# façon notable — un dropper malveillant fait presque toujours quelques
# centaines de Ko à quelques Mo, pas des dizaines de Mo.
_HASH_SIZE_CAP_BYTES = 8 * 1024 * 1024


def _file_metadata(path, event_type):
    """(size, hash) d'un fichier touché — stratégie de hash ADAPTATIVE :
    seulement les extensions pertinentes pour la détection (voir
    _HASHABLE_EXTENSIONS), et seulement sous _HASH_SIZE_CAP_BYTES. Un
    fichier supprimé (event_type="file_delete") n'existe plus : ni taille
    ni hash ne peuvent être lus — pas une erreur, juste un fait."""
    if event_type == "file_delete":
        return None, None
    try:
        size = os.path.getsize(path)
    except OSError:
        # Déjà disparu au moment où on l'inspecte (fichier temporaire très
        # éphémère, ex: un fichier de verrouillage créé puis aussitôt
        # supprimé) — pas un signal en soi, juste une fenêtre ratée.
        return None, None
    file_hash = None
    if os.path.splitext(path)[1].lower() in _HASHABLE_EXTENSIONS and size <= _HASH_SIZE_CAP_BYTES:
        file_hash = hash_file(path)
    return size, file_hash


def collect_file_events(cfg):
    """Vide _file_change_queue et transforme chaque changement en
    évènement normalisé, coalescé : un même (action, chemin) répété dans
    le MÊME cycle ne produit qu'un seul évènement — Windows notifie
    souvent plusieurs fois la même écriture (une écriture de contenu ET
    une mise à jour d'horodatage, par exemple), constaté en testant."""
    if not _IS_WINDOWS:
        return
    # normcase (minuscules + séparateurs uniformisés sur Windows) des DEUX
    # côtés : les chemins reconstruits par _watch_directory_thread héritent
    # du style de séparateur de la variable d'environnement d'origine, pas
    # forcément celui que os.path.join produirait ailleurs — une simple
    # comparaison de préfixe sans normalisation peut rater la correspondance.
    own_data_dir = os.path.normcase(os.path.normpath(agent_data_dir()))
    seen = set()
    while True:
        try:
            action, path = _file_change_queue.get_nowait()
        except _queue.Empty:
            break
        if os.path.normcase(os.path.normpath(path)).startswith(own_data_dir):
            continue  # bruit auto-référentiel (config, file locale, logs) — voir agent_data_dir()
        event_type = _FILE_ACTION_TYPES.get(action, "file_modify")
        key = (event_type, path)
        if key in seen:
            continue
        seen.add(key)

        size, file_hash = _file_metadata(path, event_type)
        data = {
            "path": path, "filename": os.path.basename(path),
            "extension": os.path.splitext(path)[1].lower(),
            "size": size, "hash": file_hash,
        }
        if action in _FILE_ACTION_PHASE:
            data["phase"] = _FILE_ACTION_PHASE[action]
        ev = event_schema.make_event(
            event_type, cfg["agent_id"], event_queue.next_seq(),
            data=data, os_name=platform.system(),
        )
        event_queue.enqueue(ev)

        # Un fichier créé/modifié dans le dossier de démarrage automatique
        # est un mécanisme de persistance à part entière, au même titre
        # qu'une clé de registre — même sémantique que
        # collect_persistence_events / _emit_persistence_event.
        if event_type in ("file_create", "file_modify") and is_persistence_path(path):
            _emit_persistence_event(cfg, "persistence_created", "startup_folder",
                                     os.path.dirname(path), os.path.basename(path), path)


def flush_av_block_queue(cfg):
    """Vide _av_block_queue (voir _on_access_scan) : le blocage local
    lui-même a déjà eu lieu, IMMÉDIATEMENT, dans le thread de
    surveillance — cette fonction ne fait que remonter l'alerte et
    l'évènement au serveur au cycle suivant. Même découplage que
    collect_file_events : tout ce qui touche réseau/base reste dans le
    thread principal."""
    while True:
        try:
            path, verdict, quarantine_path, moved = _av_block_queue.get_nowait()
        except _queue.Empty:
            break

        ioc = verdict["ioc"]
        kind_label = "hash connu" if verdict["kind"] == "hash" else "motif de contenu"
        description = ioc.get("description") or f"Correspond à un IoC de type {verdict['kind']}"
        severity = ioc.get("severity", "high")

        ev = event_schema.make_event(
            "malware_blocked", cfg["agent_id"], event_queue.next_seq(),
            data={
                "path": path, "quarantine_path": quarantine_path, "file_moved": moved,
                "detection_kind": verdict["kind"], "hash": verdict.get("hash"),
                "description": description,
            },
            os_name=platform.system(),
        )
        event_queue.enqueue(ev)

        # Volontairement SANS `signals=` : une correspondance IoC/EICAR est
        # un verdict déjà définitif, pas un faisceau de signaux ambigus à
        # soumettre au Risk Engine — dès que `signals` est fourni, le
        # serveur ignore la `severity` de l'agent et recalcule la sienne
        # (voir agent_alert() dans main serveur), ce qui écraserait la
        # sévérité de l'IoC par un score "inconnu" proche de 0. La
        # sévérité de l'IoC DOIT passer telle quelle.
        alert_id = send_alert(
            cfg, f"Fichier malveillant bloqué à l'écriture : {os.path.basename(path)}",
            f"{description} — détecté par {kind_label} avant exécution probable",
            severity, "antivirus",
        )
        send_quarantine(cfg, path, description, "antivirus_block", severity,
                         quarantine_path=quarantine_path, file_moved=moved)
        if alert_id:
            send_process_events(cfg, alert_id, [{
                "event_type": "file", "pid": None, "parent_pid": None,
                "process_name": os.path.basename(path), "parent_name": None,
                "detail": f"Fichier bloqué à l'écriture : {path}",
            }])


def main():
    global _cycle_count
    cfg = get_config()
    event_queue.init_db()
    harden_folder_permissions(agent_data_dir())
    harden_folder_permissions(quarantine_dir())
    _consume_applied_update()
    check_self_integrity(cfg)
    start_file_watchers()
    emit_collectors_started(cfg)
    _log("── Agent NHGuard démarré ──")
    _log(f"Identifiant : {cfg['agent_id']}")
    _log(f"Serveur     : {cfg['server_url']}")
    _log(f"Quarantaine : {quarantine_dir()}")
    _log(f"Config      : {config_path()}")
    _log("Ctrl+C pour arrêter.\n")

    fetch_iocs(cfg)

    while True:
        # Collecteurs de télémétrie continue AVANT le heartbeat, pour que
        # queue_size/collector_health reflètent ce cycle-ci et non le
        # précédent (voir collect_system_stats). collect_file_events ne
        # fait que VIDER une file déjà remplie en tâche de fond par les
        # threads de start_file_watchers() — pas de coût de scan ici.
        collect_process_events(cfg)
        collect_network_events(cfg)
        collect_dns_events(cfg)
        collect_persistence_events(cfg)
        collect_service_events(cfg)
        collect_scheduled_task_events(cfg)
        collect_user_events(cfg)
        collect_file_events(cfg)
        flush_av_block_queue(cfg)
        emit_health_transition_events(cfg)
        check_queue_pressure(cfg)
        flush_event_queue(cfg)

        stats = collect_system_stats(cfg["agent_id"])
        send_heartbeat(cfg, stats)
        scan_processes(cfg)
        poll_and_execute_commands(cfg)

        _cycle_count += 1
        if _cycle_count % IOC_REFRESH_EVERY_N_CYCLES == 0:
            fetch_iocs(cfg)
        if _cycle_count % UPDATE_CHECK_EVERY_N_CYCLES == 0:
            check_for_update(cfg)

        _log(f"CPU {stats['cpu_percent']}% · "
              f"RAM {stats['ram_percent']}% · Disque {stats['disk_percent']}% · "
              f"File {stats['queue_size']}")
        time.sleep(REPORT_INTERVAL_SECONDS)


if __name__ == "__main__":
    try:
        main()
    except _RestartForUpdate:
        _write_graceful_marker()
        _log("\nAgent arrêté pour mise à jour.")
    except KeyboardInterrupt:
        _write_graceful_marker()
        _log("\nAgent arrêté.")
