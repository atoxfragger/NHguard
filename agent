def send_heartbeat(cfg, stats):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/report", json=stats, headers=headers, timeout=5)
        if r.status_code == 401:
            _log("[!] Clé API rejetée par le serveur — vérifiez la configuration.")
        elif r.status_code != 200:
            _log(f"[!] Erreur heartbeat ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        _log(f"[!] Serveur injoignable : {e}")


# État de connectivité serveur constaté au dernier envoi — None tant que
# rien n'a encore été tenté, pour ne pas émettre "reconnecté" au tout
# premier envoi réussi du démarrage (il n'y avait pas eu de coupure).
_server_connected = None
_queue_full_notified = False


def _emit_meta_event(cfg, event_type, data):
    """Point d'émission commun aux évènements de santé de la télémétrie
    elle-même (collecteurs, file, connectivité serveur — tous priorité
    P0, voir event_schema.py) : permet à NHGuard de détecter "ma
    télémétrie devient aveugle" plutôt que de le déduire indirectement
    d'une absence de données (document source, sections 11 et 19)."""
    ev = event_schema.make_event(
        event_type, cfg["agent_id"], event_queue.next_seq(),
        data=data, os_name=platform.system(),
    )
    event_queue.enqueue(ev)


def emit_collectors_started(cfg):
    """Un collector_started par collecteur, une seule fois au démarrage
    de l'agent (voir main())."""
    for name in _collector_health:
        _emit_meta_event(cfg, "collector_started", {"collector": name})


def emit_health_transition_events(cfg):
    """Émet un évènement seulement quand la santé d'un collecteur CHANGE
    (jamais à chaque cycle où rien n'a bougé, sinon ces P0 finiraient par
    dominer le flux) — appelé une fois par cycle, après tous les
    collecteurs (voir main())."""
    global _prev_collector_health_snapshot
    for name, status in _collector_health.items():
        prev = _prev_collector_health_snapshot.get(name)
        if prev is not None and prev != status and status != "unavailable":
            event_type = "collector_error" if status == "stalled" else "collector_recovered"
            _emit_meta_event(cfg, event_type, {"collector": name, "status": status, "previous_status": prev})
    _prev_collector_health_snapshot = dict(_collector_health)


def check_queue_pressure(cfg):
    """Signale UNE FOIS quand la file locale atteint HARD_LIMIT (pas à
    chaque cycle tant que ça reste plein) — voir event_queue.py pour le
    backpressure lui-même, qui continue de fonctionner indépendamment de
    cette notification."""
    global _queue_full_notified
    size = event_queue.queue_size()
    if size >= event_queue.HARD_LIMIT and not _queue_full_notified:
        _emit_meta_event(cfg, "queue_full", {"queue_size": size, "hard_limit": event_queue.HARD_LIMIT})
        _queue_full_notified = True
    elif size < event_queue.SOFT_LIMIT:
        _queue_full_notified = False


_prev_collector_health_snapshot = {}


def flush_event_queue(cfg, max_batch=200):
    """Vide la file locale par LOTS compressés (jamais une requête HTTP
    par évènement, document source section 17) — Event -> Local Queue ->
    Batch -> Compression -> TLS -> Server. Ne retire de la file QUE ce
    que le serveur a confirmé avoir reçu (statut 201) : si l'envoi échoue
    en cours de route (coupure réseau pendant le POST), tout reste en
    attente pour le prochain cycle, rien n'est perdu.

    Backpressure par PALIERS (document source, section 10), sans jamais
    délester silencieusement un P0/P1 (ça reste le rôle d'event_queue.py) :
      < 70% de HARD_LIMIT : lot normal, compression standard
      70-90% : même taille de lot, compression gzip maximale (charge CPU
               plus élevée, mais un lot plus petit à transmettre — utile
               si le réseau lui-même est le goulot d'étranglement)
      ≥ 90% : lots plus PETITS et donc plus fréquents — les priorités
               les plus hautes (voir event_queue.dequeue_batch, toujours
               P0 d'abord) sortent de la file plus vite qu'avec un seul
               gros lot lent à construire et à envoyer."""
    global _server_connected
    queue_size = event_queue.queue_size()
    occupancy = queue_size / event_queue.HARD_LIMIT if event_queue.HARD_LIMIT else 0
    if occupancy >= 0.9:
        batch_n, gzip_level = min(max_batch, 50), 9
    elif occupancy >= 0.7:
        batch_n, gzip_level = max_batch, 9
    else:
        batch_n, gzip_level = max_batch, 6

    batch = event_queue.dequeue_batch(batch_n)
    if not batch:
        return
    seqs = [seq for seq, _ in batch]
    events = [ev for _, ev in batch]
    try:
        payload = gzip.compress(json.dumps(events).encode("utf-8"), compresslevel=gzip_level)
    except (TypeError, ValueError) as e:
        _log(f"[!] Lot d'évènements invalide, abandonné : {e}")
        return

    headers = {
        "Content-Type": "application/json", "Content-Encoding": "gzip",
        "X-Agent-Key": cfg["api_key"],
    }
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/events", data=payload, headers=headers, timeout=10)
        if r.status_code == 201:
            event_queue.mark_sent(seqs)
            if _server_connected is False:
                _emit_meta_event(cfg, "server_connected", {})
            _server_connected = True
        else:
            _log(f"[!] Erreur envoi évènements ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        _log(f"[!] Serveur injoignable pour l'envoi d'évènements : {e}")
        if _server_connected is not False:
            _emit_meta_event(cfg, "server_disconnected", {"error": str(e)})
        _server_connected = False


def send_alert(cfg, title, description, severity, category, signals=None):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    payload = {
        "title": title, "description": description,
        "severity": severity, "category": category, "agent_id": cfg["agent_id"],
        "signals": signals or {},
    }
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/alert", json=payload, headers=headers, timeout=5)
        if r.status_code == 201:
            resp = r.json()
            computed = f" (Risk Engine: score={resp.get('score')}, sévérité={resp.get('severity')})" if resp.get('score') is not None else ""
            _log(f"[ALERTE ENVOYÉE] {title}{computed}")
            return resp.get("id")
        _log(f"[!] Erreur envoi alerte ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        _log(f"[!] Serveur injoignable : {e}")
    return None


def send_quarantine(cfg, file_path, reason, action, severity, quarantine_path=None, file_moved=False):
    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    payload = {
        "file_path": file_path, "reason": reason, "action": action,
        "severity": severity, "agent_id": cfg["agent_id"],
        "quarantine_path": quarantine_path, "file_moved": file_moved,
    }
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/quarantine", json=payload, headers=headers, timeout=5)
        if r.status_code == 201:
            _log(f"[QUARANTAINE] {file_path} ({action}, déplacé={file_moved})")
        else:
            _log(f"[!] Erreur envoi quarantaine ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
        _log(f"[!] Serveur injoignable : {e}")


def send_process_events(cfg, alert_id, events):
    if not alert_id or not events:
