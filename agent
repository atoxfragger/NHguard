    headers = {"Content-Type": "application/json", "X-Agent-Key": cfg["api_key"]}
    payload = {"alert_id": alert_id, "agent_id": cfg["agent_id"], "events": events}
    try:
        r = requests.post(f"{cfg['server_url']}/api/agents/process-events", json=payload, headers=headers, timeout=5)
        if r.status_code != 201:
            _log(f"[!] Erreur envoi arbre de processus ({r.status_code}) : {r.text}")
    except requests.RequestException as e:
